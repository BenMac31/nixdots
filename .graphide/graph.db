{"t":"n","a":524,"i":"022f6521-b609-4450-bec8-6eed151b50b3","k":"variable","n":"config","d":"config = lib.mkIf config.programs.qutebrowser.enable {\n  programs.qutebrowser = {\n    enable = lib.mkDefault true;\n    package = pkgs.qutebrowser.override {\n      pythonPackages = ps: with ps; [\n        pkgs.python3Packages.requests\n        pkgs.python3Packages.beautifulsoup4\n        pkgs.python3Packages.pygments\n      ];\n    };\n    \n    settings = {\n      \"aliases\" = {\n        \"w\" = \"session-save\";\n        \"q\" = \"quit\";\n        \"wq\" = \"quit --save\";\n        \"qa\" = \"quit --save --all\";\n      };\n      \n      \"colors\" = {\n        \"hints.bg\" = config.colorScheme.palette.base08;\n… (truncated)","p":"modules/home-manager/desktop/apps/qutebrowser.nix","r":517,"sp":[18,436,3,5],"sh":"4cb2c099891c75f2fd80505f62a638eabfe8179f146936572dab585168b7ae81","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
