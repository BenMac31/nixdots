{"t":"n","a":1262,"i":"31770989-63c5-4e80-b281-9745b671e85b","k":"variable","n":"systemd.services.matrix-appservice-tokens","d":"systemd.services.matrix-appservice-tokens = {\n  description = \"Generate Matrix appservice tokens and registration files\";\n  wantedBy = [ \"multi-user.target\" ];\n  before = [\n    \"matrix-synapse.service\"\n    \"mautrix-slack.service\"\n  ];\n  requiredBy = [ \"matrix-synapse.service\" ];\n  path = with pkgs; [\n    coreutils\n    openssl\n    gnused\n  ];\n  serviceConfig = {\n    Type = \"oneshot\";\n    RemainAfterExit = true;\n  };\n  script = ''\n    set -euo pipefail\n\n    install -d -m 0700 -o root -g root ${secretsDir}\n\n    gen_secret() {\n      local f=\"${secretsDir}/$1\"\n… (truncated)","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1249,"sp":[47,109,5,7],"sh":"0b6bdfc5d56ad9be7fd5521f4202a2677426e7ebc93b9c3dedc38eb3ff1ba2e5","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1263,"i":"26e29b71-ebbe-4d7d-85cd-351f1bb66622","k":"variable","n":"systemd.tmpfiles.rules","d":"systemd.tmpfiles.rules = [\n  \"d ${secretsDir} 0700 root root -\"\n];","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1249,"sp":[43,45,5,7],"sh":"12e83caa41e9501255312c44c10dccff07529815d58eadb4077740a5e30cf047","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1264,"i":"edce79dd-7600-48c3-8db6-ff9b55560c54","k":"file","n":"backup.nix","d":"Restic backup configuration for the Matrix service, exposing a services.restic.backups.matrix definition with repository, environment, password files and a dump script that prepares a backup of matrix-synapse and mautrix-slack data into /var/lib/matrix-backup.","p":"modules/nixos/serv/matrix/backup.nix","r":1244,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1265,"i":"0dddb5e0-6bdc-41f1-96b0-a18ced14a876","k":"variable","n":"backup","d":"backup = cfg.backup;","p":"modules/nixos/serv/matrix/backup.nix","r":1264,"sp":[9,9,3,23],"sh":"97c600e2d02601702b97e7fa14d33bd4b71f15fa6ecb3b805e8d89179778feb7","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1266,"i":"a2dcf183-fa3d-40cc-9aa2-c68fee63d7f5","k":"variable","n":"cfg","d":"cfg = config.serv.matrix;","p":"modules/nixos/serv/matrix/backup.nix","r":1264,"sp":[8,8,3,28],"sh":"a5778949504c61209623b7c551a0991824cad7d29f80a9bf4a73aa5959f98ee8","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1267,"i":"598e9f11-d27a-4b47-8da9-31cb5f4b9822","k":"variable","n":"config","d":"config = lib.mkIf (cfg.enable && backup.enable) {\n  services.restic.backups.matrix = {\n    initialize = true;\n    repository = backup.repository;\n    environmentFile = backup.environmentFile;\n    passwordFile = backup.passwordFile;\n\n    backupPrepareCommand = \"${lib.getExe dumpScript}\";\n\n    paths = [\n      dumpDir\n      \"${config.services.matrix-synapse.dataDir}/media_store\"\n      \"/var/lib/matrix-secrets\"\n    ];\n\n    timerConfig = {\n      OnCalendar = \"03:15\";\n      RandomizedDelaySec = \"30m\";\n      Persistent = true;\n    };\n\n    pruneOpts = [\n      \"--keep-daily 7\"\n… (truncated)","p":"modules/nixos/serv/matrix/backup.nix","r":1264,"sp":[32,63,3,5],"sh":"847f64af5c0bf0431e75b7f5265805668579f6ad496366bdbcd36434840e8eed","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1268,"i":"dc2400c2-0f56-4648-9e40-583fa0f73a6d","k":"variable","n":"dumpDir","d":"dumpDir = \"/var/lib/matrix-backup\";","p":"modules/nixos/serv/matrix/backup.nix","r":1264,"sp":[11,11,3,38],"sh":"3d9223bd5467e0b1905a9ffa76eb24ad79694a074dffc223405edd3130664dcc","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1269,"i":"d96409c0-1cdc-422b-a1c8-49d272785878","k":"variable","n":"dumpScript","d":"dumpScript = pkgs.writeShellApplication {\n  name = \"matrix-backup-dump\";\n  runtimeInputs = [\n    pkgs.postgresql\n    pkgs.coreutils\n    pkgs.util-linux\n    pkgs.gnugrep\n  ];\n  text = ''\n    install -d -m 0700 \"${dumpDir}\"\n    for db in matrix-synapse mautrix-slack; do\n      if runuser -u postgres -- psql -lqt | cut -d'|' -f1 | grep -qw \"$db\"; then\n        runuser -u postgres -- pg_dump --format=custom \"$db\" > \"${dumpDir}/$db.dump\"\n      fi\n    done\n  '';\n};","p":"modules/nixos/serv/matrix/backup.nix","r":1264,"sp":[13,29,3,5],"sh":"5fd249c3ffabce20dd9e8734ddad8dbd0e6ef17246fd5b3bd691df84f8e87c34","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1270,"i":"e6f956b1-71af-40a9-a9a2-0e931f904818","k":"variable","n":"name","d":"name = \"matrix-backup-dump\";","p":"modules/nixos/serv/matrix/backup.nix","r":1269,"sp":[14,14,5,33],"sh":"a11349c4faa1dfe6d5ae3cb57ce16a0a08d6c17f0cd2d6bd71e6fcb237e490e1","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":1271,"i":"9016e29b-3902-4dc4-bdb1-5b0d3400bc1c","k":"variable","n":"runtimeInputs","d":"runtimeInputs = [\n  pkgs.postgresql\n  pkgs.coreutils\n  pkgs.util-linux\n  pkgs.gnugrep\n];","p":"modules/nixos/serv/matrix/backup.nix","r":1269,"sp":[15,20,5,7],"sh":"cc25ad162ca0dae7e2166a4690da545c4ff2a90a158aee2e183c6a933130d1b1","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1272,"i":"879b7fd4-1643-4cdf-bc65-4b9d2b2ba7e3","k":"variable","n":"services.restic.backups.matrix","d":"services.restic.backups.matrix = {\n  initialize = true;\n  repository = backup.repository;\n  environmentFile = backup.environmentFile;\n  passwordFile = backup.passwordFile;\n\n  backupPrepareCommand = \"${lib.getExe dumpScript}\";\n\n  paths = [\n    dumpDir\n    \"${config.services.matrix-synapse.dataDir}/media_store\"\n    \"/var/lib/matrix-secrets\"\n  ];\n\n  timerConfig = {\n    OnCalendar = \"03:15\";\n    RandomizedDelaySec = \"30m\";\n    Persistent = true;\n  };\n\n  pruneOpts = [\n    \"--keep-daily 7\"\n    \"--keep-weekly 5\"\n    \"--keep-monthly 12\"\n  ];\n};","p":"modules/nixos/serv/matrix/backup.nix","r":1267,"sp":[33,58,5,7],"sh":"f57ff32f9f5cc7d318d5e6ba4a6d3fb851a36c9db5931a0a919d3904b837afad","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
