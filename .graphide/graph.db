{"t":"n","a":791,"i":"ee8abd82-49f3-4c88-8ad2-c283462f4785","k":"file","n":"media.nix","d":"Home Manager desktop media configuration: conditionally includes media‑related packages (obs‑studio, audacity, gimp, inkscape, sxiv) and services (MPD, Flatpak qBittorrent) when both media and desktop features are enabled.","p":"modules/home-manager/desktop/media.nix","r":475,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":792,"i":"3b0493cb-3257-4f92-a4f6-d7424c44bba4","k":"variable","n":"config","d":"config = lib.mkIf (config.media.enable && config.desktop.enable) {\n  home.packages = with pkgs; [\n    obs-studio\n    audacity\n    gimp\n    inkscape\n    sxiv\n  ];\n  services.flatpak.packages = [\n    \"org.qbittorrent.qBittorrent\"\n  ];\n  services.mpd = {\n    enable = true;\n    # extraConfig = ''\n    #   # must specify one or more outputs in order to play audio!\n    #   # (e.g. ALSA, PulseAudio, PipeWire), see next sections\n    # '';\n  };\n  programs.ncmpcpp = {\n    enable = true;\n    bindings = [\n      { key = \"h\"; command = \"previous_column\"; }\n… (truncated)","p":"modules/home-manager/desktop/media.nix","r":791,"sp":[3,37,3,5],"sh":"2fa0bdae5c5567dbec907f2fb6c0afab933bf555629a7945d5176eab6b55d495","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
