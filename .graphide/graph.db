{"t":"n","a":1121,"i":"5610d8e8-ac6e-4b70-95dc-c0ca3135c716","k":"module","n":"SDDM Gruvbox Theme","d":"Provides a Gruvbox‑styled theme configuration for the SDDM login manager on NixOS, defining screen dimensions, colors, fonts, layout options, and localization strings that SDDM consumes to render the graphical login screen.","p":"modules/nixos/head/sddm","r":1105,"tg":["evidence:source","lang:nix","layer:architecture","source:arch-agent"]}
{"t":"n","a":1122,"i":"351dac66-42d9-4ea1-88e2-6f53018bdbc8","k":"file","n":"sddm.nix","d":"Configures NixOS to enable the SDDM display manager with a custom astronaut theme, adds required packages, and sets up auto‑login for the user \"greencheetah\".","p":"modules/nixos/head/sddm.nix","r":1104,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1123,"i":"4d6364e0-8d1f-4da4-9004-c512e4f9830b","k":"variable","n":"enable","d":"enable = true;","p":"modules/nixos/head/sddm.nix","r":1125,"sp":[9,9,5,19],"sh":"dffb0e569772e112c1f30bbae904e566fc4a4c898b009e6c28d7cc30f53f0d3e","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
