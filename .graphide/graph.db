{"t":"n","a":589,"i":"05865eda-53f6-4646-a6de-49df51fb8cf1","k":"variable","n":"wayland.windowManager.hyprland","d":"wayland.windowManager.hyprland = {\n  enable = true;\n  configType = \"hyprlang\";\n  settings = {\n    monitor = [\n      \",preferred,auto,1.56667\"\n      \"DP-2,preferred,auto,1.6\"\n    ];\n    exec-once = [\n      \"nmcli radio wifi off && nmcli radio wifi on\" # wifi doesn't work without this.\n      \"bwfloat\"\n      \"nm-applet\"\n      \"${pkgs.wlsunset}/wlsunset -l 39.103119 -L -84.512016 -t 0 -g 0.7\"\n      \"${pkgs.kdePackages.kdeconnect-kde}/bin/kdeconnect-indicator\"\n    ];\n    input = {\n      kb_layout = \"us\";\n      kb_options = \"caps:swapescape\";\n\n      touchpad = {\n… (truncated)","p":"modules/home-manager/desktop/env/hyprland.nix","r":576,"sp":[128,383,5,7],"sh":"107aa458f8d1e1d5a8b707fb633d576109af89e67a3f8b851e72010ac116fe5f","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":590,"i":"f1c7dc23-ce90-4830-a30a-d0ec387b608a","k":"variable","n":"xdg","d":"xdg = {\n  desktopEntries.\"org.gnome.Settings\" = {\n    name = \"Settings\";\n    comment = \"Gnome Control Center\";\n    icon = \"org.gnome.Settings\";\n    exec = \"env XDG_CURRENT_DESKTOP=gnome ${pkgs.gnome-control-center}/bin/gnome-control-center\";\n    categories = [ \"X-Preferences\" ];\n    terminal = false;\n  };\n};","p":"modules/home-manager/desktop/env/hyprland.nix","r":576,"sp":[25,34,5,7],"sh":"37a3506fb96bb65c7c91c6ac7842f56ae32e0bfbd1a9e390a7fc74eeb61b73eb","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":591,"i":"5912b25e-9c67-4c2f-8778-13db2a754239","k":"file","n":"swaync.nix","d":"Enables the swaync notification daemon and provides its default configuration (position, layer, and UI settings) for home-manager desktop environments.","p":"modules/home-manager/desktop/env/swaync.nix","r":565,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":592,"i":"9bf5d2ad-baad-4472-ba14-00fae3a4a681","k":"variable","n":"enable","d":"enable = true;","p":"modules/home-manager/desktop/env/swaync.nix","r":593,"sp":[5,5,5,19],"sh":"dffb0e569772e112c1f30bbae904e566fc4a4c898b009e6c28d7cc30f53f0d3e","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":593,"i":"cf89d739-39e1-4d66-823e-4276d6c7e6dd","k":"variable","n":"services.swaync","d":"services.swaync = {\n  enable = true;\n\n  settings = {\n    positionX = \"right\";\n    positionY = \"top\";\n    layer = \"overlay\";\n    \"control-center-layer\" = \"top\";\n    \"layer-shell\" = true;\n    cssPriority = \"user\";\n    \"control-center-margin-top\" = 16;\n    \"control-center-margin-bottom\" = 16;\n    \"control-center-margin-right\" = 16;\n    \"control-center-margin-left\" = 0;\n    \"notification-icon-size\" = 20;\n    \"notification-body-image-height\" = 100;\n    \"notification-body-image-width\" = 200;\n    timeout = 5;\n    \"timeout-low\" = 5;\n    \"timeout-critical\" = 0;\n… (truncated)","p":"modules/home-manager/desktop/env/swaync.nix","r":591,"sp":[4,201,3,5],"sh":"ac0590d3a6c6b9ed72702e09d241b9f8747669cfc89204d5895c5f61eba7d73f","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":594,"i":"111980f9-adf9-4ec6-8503-5ff83f5eac25","k":"variable","n":"settings","d":"settings = {\n  positionX = \"right\";\n  positionY = \"top\";\n  layer = \"overlay\";\n  \"control-center-layer\" = \"top\";\n  \"layer-shell\" = true;\n  cssPriority = \"user\";\n  \"control-center-margin-top\" = 16;\n  \"control-center-margin-bottom\" = 16;\n  \"control-center-margin-right\" = 16;\n  \"control-center-margin-left\" = 0;\n  \"notification-icon-size\" = 20;\n  \"notification-body-image-height\" = 100;\n  \"notification-body-image-width\" = 200;\n  timeout = 5;\n  \"timeout-low\" = 5;\n  \"timeout-critical\" = 0;\n  \"fit-to-screen\" = false;\n  \"control-center-width\" = 480;\n  \"notification-window-width\" = 400;\n… (truncated)","p":"modules/home-manager/desktop/env/swaync.nix","r":593,"sp":[7,34,5,7],"sh":"1d9194370dd85650dee810cb8838f5f8fa6eafaa7caeb1ba50ad1d38d4308956","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":595,"i":"9ef4e968-e91c-480d-83b9-208bbac917a4","k":"variable","n":"style","d":"style = with config.colorScheme.palette; ''\n  * {\n    font-family: \"JetBrainsMono Nerd Font Mono\";\n    font-size: 12pt;\n    transition: 200ms ease;\n  }\n\n  /* ── Notification Popups ─────────────────────────────────── */\n\n  .notification-row {\n    outline: none;\n    margin: 8px 8px 0;\n  }\n\n  .notification-row:last-child {\n    margin-bottom: 8px;\n  }\n\n  .notification {\n    border-radius: 20px;\n    border: 2px solid #${base0F};\n    background: alpha(#${base00}, 0.92);\n    padding: 0;\n  }\n… (truncated)","p":"modules/home-manager/desktop/env/swaync.nix","r":593,"sp":[36,200,5,8],"sh":"b19ce5d0621fb2567b2002978c1a7f30d0408b9bd44a9d0933845aae1306af22","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":596,"i":"31381e4f-5610-4629-86e2-a8d0eb246091","k":"module","n":"Window Manager Environment Configuration","d":"Provides Home Manager Nix settings for the user's window manager setup: imports the quickshell module and configures the custom Graphide shell (widget monitor, terminal, pomodoro panel, etc.), enables the ProtonMail bridge service, installs and configures hyphens hyprpaper (wallpaper source, preload, and per‑monitor assignments), defines a swapwallpaper helper script, and ensures Hyprland runs the wallpaper swap on startup. The module centralises WM‑related options under the desktop environment.","p":"modules/home-manager/desktop/env/wm","r":597,"tg":["evidence:source","lang:nix","layer:architecture","source:arch-agent"]}
{"t":"n","a":597,"i":"084b7fe5-c6b1-4354-9d1f-f3381f741967","k":"subsystem","n":"modules/home-manager/desktop/env/wm — Window‑manager and UI tooling configuration","d":"Nix configuration for the window manager and its auxiliary tools (rofi launcher, waybar status bar), includes entry points for quickshell Python scripts and CSS styling for waybar.","p":"modules/home-manager/desktop/env/wm","r":566,"tg":["evidence:signatures","layer:overview","overview:rung:directory","source:overview-agent"]}
{"t":"n","a":598,"i":"42c60438-a17f-4df8-8b9f-0f02e91aa76c","k":"file","n":"graphide-shell.nix","d":"Home Manager module that conditionally enables the graphide-shell program with customized widget monitor, terminal, pomodoro, and other UI settings, and also ensures the protonmail-bridge service stays running.","p":"modules/home-manager/desktop/env/wm/graphide-shell.nix","r":596,"tg":["description:agent","evidence:source","lang:nix","source:tree-sitter"]}
{"t":"n","a":599,"i":"ffc52931-18d7-44d6-a948-091f2daf8740","k":"variable","n":"config","d":"config = lib.mkIf config.programs.graphide-shell.enable {\n  programs.graphide-shell = {\n    widgetMonitor = \"eDP-1\";\n    terminalPackage = pkgs.kitty;\n    pomodoro = pkgs.waybar-pomodoro;\n    rbwPinentry = true;\n    todoCommand = [ \"nvim\" \"${config.home.homeDirectory}/Projects/graphide/docs/TODO.md\" ];\n    hyprland = { layerRules = true; decoration = true; };\n  };\n  # Bridge must keep running after `connect.py proton` pairs it, or IMAP sync\n  # dies the moment that CLI session exits.\n  services.protonmail-bridge.enable = true;\n};","p":"modules/home-manager/desktop/env/wm/graphide-shell.nix","r":598,"sp":[4,22,3,5],"sh":"5a3bf18ebfd855e6e55842610faa2f56992f714e45802ffc18901b3f694ff4cb","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
