{"t":"n","a":1244,"i":"bd36a456-1e04-479f-b6f2-5e3fb3d9a947","k":"module","n":"Matrix Service Stack","d":"Provides a complete NixOS configuration for running a Matrix homeserver stack, including the Synapse service, a Slack bridge (mautrix-slack), Caddy‑served web front‑ends, automated generation of appservice registration and secret files, and scheduled Restic backups of databases and media. Each component is conditionally enabled via options.serv.matrix, with systemd services, tmpfiles rules, and custom shell scripts wired into the NixOS module system.","p":"modules/nixos/serv/matrix","r":1214,"tg":["evidence:source","lang:nix","layer:architecture","source:arch-agent"]}
{"t":"n","a":1245,"i":"ce213e84-7f8a-40dc-8ff5-ace8f2232e9e","k":"file","n":"appservice-tokens.nix","d":"Implements the NixOS service that generates Matrix appservice tokens and registration files for the Slack bridge, exposing systemd service definitions and internal options for registration, shared secret, and bridge configuration.","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1244,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1246,"i":"157bc038-a98f-4294-a3e7-a1202a4b52b5","k":"variable","n":"bridgeConfigFile","d":"bridgeConfigFile = lib.mkOption {\n  type = lib.types.str;\n  internal = true;\n};","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1251,"sp":[125,128,5,7],"sh":"bb32d401445554b4984a6a62e579b18e9748e2ae46dad805c7086dc44c0e7b6f","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1247,"i":"7da95d8f-1728-4b1f-b7be-aa9d479025e8","k":"variable","n":"bridgeConfigFile","d":"bridgeConfigFile = \"/var/lib/mautrix-slack/config.yaml\";","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1245,"sp":[16,16,3,59],"sh":"11b2f805b7db56d39a75632923a230fdade28d344ef315739f39c44efc42a251","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1248,"i":"fa854b4e-3974-4f23-bbba-36b3c1f3dfa6","k":"variable","n":"cfg","d":"cfg = config.serv.matrix;","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1245,"sp":[8,8,3,28],"sh":"a5778949504c61209623b7c551a0991824cad7d29f80a9bf4a73aa5959f98ee8","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1249,"i":"20865879-8f30-4f4b-8f6b-f200d5384378","k":"variable","n":"config","d":"config = lib.mkIf cfg.enable {\n  systemd.tmpfiles.rules = [\n    \"d ${secretsDir} 0700 root root -\"\n  ];\n\n  systemd.services.matrix-appservice-tokens = {\n    description = \"Generate Matrix appservice tokens and registration files\";\n    wantedBy = [ \"multi-user.target\" ];\n    before = [\n      \"matrix-synapse.service\"\n      \"mautrix-slack.service\"\n    ];\n    requiredBy = [ \"matrix-synapse.service\" ];\n    path = with pkgs; [\n      coreutils\n      openssl\n      gnused\n    ];\n    serviceConfig = {\n      Type = \"oneshot\";\n      RemainAfterExit = true;\n    };\n    script = ''\n… (truncated)","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1245,"sp":[42,114,3,5],"sh":"88eb55e94fefd1e29d7a49080eeef67e85dd31e6adcc916583ca521de45dd7af","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1250,"i":"b2477fa2-1763-4e24-be18-81431b828e9e","k":"variable","n":"escapedDomain","d":"escapedDomain = lib.replaceStrings [ \".\" ] [ \"\\\\.\" ] cfg.serverName;","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1245,"sp":[18,18,3,71],"sh":"b5f3c887d46d32ae3fc23581be907bdab0aadd669502f9048199ba848a805424","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1251,"i":"2a2bc8a2-863f-4612-aa11-7b438e0ff603","k":"variable","n":"options.serv.matrix.internal","d":"options.serv.matrix.internal = {\n  registrationFile = lib.mkOption {\n    type = lib.types.str;\n    internal = true;\n  };\n  sharedSecretFile = lib.mkOption {\n    type = lib.types.str;\n    internal = true;\n  };\n  bridgeConfigFile = lib.mkOption {\n    type = lib.types.str;\n    internal = true;\n  };\n  slackConfigTemplate = lib.mkOption {\n    type = lib.types.path;\n    internal = true;\n  };\n};","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1245,"sp":[116,133,3,5],"sh":"a261625860bbd220c85f221ae6a7717f6584bdfde004bc7f01166b5dec55884c","tg":["arch:auto-attached","description:declaration","lang:nix","nix:option","source:tree-sitter","visibility:public"]}
{"t":"n","a":1252,"i":"1ca5cd2a-2283-4df1-a045-8f71b7a0613e","k":"variable","n":"registrationFile","d":"registrationFile = lib.mkOption {\n  type = lib.types.str;\n  internal = true;\n};","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1251,"sp":[117,120,5,7],"sh":"33fd8716dc5bad367224acbc470cd6beacc7f94dd8d6d0a1732b87ff4a1b1650","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1253,"i":"96a19e38-a13d-463e-bdc6-45523899709b","k":"variable","n":"registrationFile","d":"registrationFile = \"${synapseDir}/appservices/${slack.appserviceId}.yaml\";","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1245,"sp":[14,14,3,77],"sh":"f3f70339151658340f55da514b8fdebe17869166978ef801fc6d29c64dd7a815","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1254,"i":"a8b70f47-bab7-4085-b7e7-a3347e4b3db8","k":"variable","n":"registrationTemplate","d":"registrationTemplate = pkgs.writeText \"${slack.appserviceId}-registration.yaml\" ''\n  id: ${slack.appserviceId}\n  url: http://127.0.0.1:${toString slack.port}\n  as_token: \"@AS_TOKEN@\"\n  hs_token: \"@HS_TOKEN@\"\n  sender_localpart: \"@SENDER_LOCALPART@\"\n  rate_limited: false\n  namespaces:\n    users:\n      # single quotes: YAML double-quoted scalars treat \\ as an escape\n      - regex: '^@${slack.botLocalpart}:${escapedDomain}$'\n        exclusive: true\n      - regex: '^@${slack.usernamePrefix}.*:${escapedDomain}$'\n        exclusive: true\n… (truncated)","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1245,"sp":[20,39,3,6],"sh":"f84385a17842014144f1ff90da000373f94b314c722344d45f06dc2baa2b3f0c","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1255,"i":"6546b384-205f-40ed-b6eb-507609ce70a7","k":"variable","n":"secretsDir","d":"secretsDir = \"/var/lib/matrix-secrets\";","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1245,"sp":[11,11,3,42],"sh":"49abfa9f9fd10591e4b1787865a7de30ae16607ae6c7ce2d3a83c09d5c34f6c6","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1256,"i":"8ad09a93-bccc-4bfa-a85c-428d326ba200","k":"variable","n":"serv.matrix.internal","d":"serv.matrix.internal = {\n  inherit registrationFile sharedSecretFile bridgeConfigFile;\n};","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1249,"sp":[111,113,5,7],"sh":"f640a5e5c95a8e27dfd8eeab3079af21b037d3c56af794d65351d6bb01ec2a42","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1257,"i":"713fa592-f62f-44ef-81f8-3d223075e10b","k":"variable","n":"sharedSecretFile","d":"sharedSecretFile = \"${synapseDir}/registration-shared-secret\";","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1245,"sp":[15,15,3,65],"sh":"461c9029e38e3e8d5dfaabb5247caace3cf85acbdaeb8a5c9477e2b50a811039","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
