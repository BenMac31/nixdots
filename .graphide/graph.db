{"t":"n","a":1301,"i":"5fcf8c0e-4714-4e0a-a1e1-c2ff16280485","k":"variable","n":"enable","d":"enable = lib.mkEnableOption \"the Matrix homeserver stack\";","p":"modules/nixos/serv/matrix/options.nix","r":1304,"sp":[7,7,5,63],"sh":"bd217562a9e766c321bee1fc24ecb740b63e4969497f84b27f429ca16b1319bb","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1302,"i":"b091d981-d595-4768-934f-3d889ab0f106","k":"variable","n":"encryption","d":"encryption = {\n  enable = lib.mkOption {\n    type = lib.types.bool;\n    default = true;\n    description = ''\n      Enable end-to-bridge encryption so the bridge can join encrypted rooms.\n    '';\n  };\n};","p":"modules/nixos/serv/matrix/options.nix","r":1304,"sp":[46,54,5,7],"sh":"b93bc24954267ea8a74f8ad513286ae348fbb23d871f61fb46ffbb179ddf4fb9","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1303,"i":"4b8f455c-55a8-4149-a52d-8eadfc467668","k":"variable","n":"hostName","d":"hostName = lib.mkOption {\n  type = lib.types.str;\n  example = \"matrix.graphide.net\";\n  description = ''\n    Public DNS name of this machine. TLS is obtained for this name and all\n    HTTP endpoints are served from it.\n  '';\n};","p":"modules/nixos/serv/matrix/options.nix","r":1304,"sp":[9,16,5,7],"sh":"bd4f2551aea5cfc6998986b1258fc0a7b5ccf688e24622299bded4b710a75527","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1304,"i":"4c0979bb-40dc-4376-a55d-dcf7ca26fa04","k":"variable","n":"options.serv.matrix","d":"options.serv.matrix = {\n  enable = lib.mkEnableOption \"the Matrix homeserver stack\";\n\n  hostName = lib.mkOption {\n    type = lib.types.str;\n    example = \"matrix.graphide.net\";\n    description = ''\n      Public DNS name of this machine. TLS is obtained for this name and all\n      HTTP endpoints are served from it.\n    '';\n  };\n\n  serverName = lib.mkOption {\n    type = lib.types.str;\n    default = cfg.hostName;\n    defaultText = lib.literalExpression \"config.serv.matrix.hostName\";\n    description = ''\n      Synapse `server_name`: the part after the colon in every user ID. It is\n… (truncated)","p":"modules/nixos/serv/matrix/options.nix","r":1296,"sp":[6,114,3,5],"sh":"cd8cd2fd6e89ef75c59d512eaa93893951843a83377c75911ab4f091ed5cfd07","tg":["arch:auto-attached","description:declaration","lang:nix","nix:option","source:tree-sitter","visibility:public"]}
{"t":"n","a":1305,"i":"5c376b97-111d-4c27-b117-02cf98dee2be","k":"variable","n":"serverName","d":"serverName = lib.mkOption {\n  type = lib.types.str;\n  default = cfg.hostName;\n  defaultText = lib.literalExpression \"config.serv.matrix.hostName\";\n  description = ''\n    Synapse `server_name`: the part after the colon in every user ID. It is\n    baked into every event the server has signed, so it cannot change after\n    the first start.\n\n    Leaving it equal to {option}`hostName` means no delegation is needed.\n  '';\n};","p":"modules/nixos/serv/matrix/options.nix","r":1304,"sp":[18,29,5,7],"sh":"9e489fb24c7fbc6d94266f049c19e79703ef1d15d7276aa0e0ebca4ec0f6e22e","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1306,"i":"40fb7c77-530d-4eca-9c06-054c0468ad72","k":"variable","n":"slack","d":"slack = {\n  enable = lib.mkEnableOption \"the mautrix-slack bridge\" // {\n    default = true;\n  };\n\n  port = lib.mkOption {\n    type = lib.types.port;\n    default = 29335;\n    description = \"Loopback port the bridge's appservice listener binds to.\";\n  };\n\n  appserviceId = lib.mkOption {\n    type = lib.types.str;\n    default = \"slack\";\n    description = \"Appservice ID. Must be stable once registered with Synapse.\";\n  };\n\n  usernamePrefix = lib.mkOption {\n    type = lib.types.str;\n    default = \"slack_\";\n    description = ''\n… (truncated)","p":"modules/nixos/serv/matrix/options.nix","r":1304,"sp":[56,87,5,7],"sh":"161003c07849b16bfc02874d69758281c159fd968d2fcd266b7f1c9db2931f04","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1307,"i":"4f86dd22-a399-45e0-b4a6-e579469f6da6","k":"file","n":"synapse.nix","d":"Provides the NixOS module that enables and configures the Matrix Synapse service when serv.matrix is enabled, exposing its settings and fixing the service port to 8008.","p":"modules/nixos/serv/matrix/synapse.nix","r":1244,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1308,"i":"ae6905a0-38f8-4180-8e5e-6cc3e6bb2d5e","k":"variable","n":"cfg","d":"cfg = config.serv.matrix;","p":"modules/nixos/serv/matrix/synapse.nix","r":1307,"sp":[8,8,3,28],"sh":"a5778949504c61209623b7c551a0991824cad7d29f80a9bf4a73aa5959f98ee8","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1309,"i":"34e65565-0fc6-40f2-9233-c6a4ca92d3ff","k":"variable","n":"config","d":"config = lib.mkIf cfg.enable {\n  services.matrix-synapse = {\n    enable = true;\n\n    enableRegistrationScript = true;\n\n    extraConfigFiles = [ ];\n\n    settings = {\n      server_name = cfg.serverName;\n      public_baseurl = \"https://${cfg.hostName}/\";\n\n      enable_registration = false;\n      registration_shared_secret_path = cfg.internal.sharedSecretFile;\n\n      report_stats = false;\n      suppress_key_server_warning = true;\n\n      listeners = [\n        {\n          port = synapsePort;\n          bind_addresses = [ \"127.0.0.1\" ];\n          type = \"http\";\n          tls = false;\n… (truncated)","p":"modules/nixos/serv/matrix/synapse.nix","r":1307,"sp":[12,108,3,5],"sh":"6b099d5fa093d41cb086cd701fad01f14a2cb079ca1bdab18de23e7f42796353","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1310,"i":"0005e966-e509-4322-befc-e128a79fb0b2","k":"variable","n":"services.matrix-synapse","d":"services.matrix-synapse = {\n  enable = true;\n\n  enableRegistrationScript = true;\n\n  extraConfigFiles = [ ];\n\n  settings = {\n    server_name = cfg.serverName;\n    public_baseurl = \"https://${cfg.hostName}/\";\n\n    enable_registration = false;\n    registration_shared_secret_path = cfg.internal.sharedSecretFile;\n\n    report_stats = false;\n    suppress_key_server_warning = true;\n\n    listeners = [\n      {\n        port = synapsePort;\n        bind_addresses = [ \"127.0.0.1\" ];\n        type = \"http\";\n        tls = false;\n        x_forwarded = true;\n        resources = [\n          {\n… (truncated)","p":"modules/nixos/serv/matrix/synapse.nix","r":1309,"sp":[13,82,5,7],"sh":"4cdb9bf0691386bda4b032cf9cc983ba30f98c2e30a6983f61959a5a3c162b38","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1311,"i":"3d52c2cc-446c-4924-911a-1dc8694cfe3a","k":"variable","n":"services.postgresql","d":"services.postgresql = {\n  enable = true;\n\n  initialScript = pkgs.writeText \"synapse-db-init.sql\" ''\n    -- LOGIN is not implied by CREATE ROLE the way it is by CREATE USER.\n    CREATE ROLE \"matrix-synapse\" LOGIN;\n    CREATE DATABASE \"matrix-synapse\"\n      WITH OWNER \"matrix-synapse\"\n           TEMPLATE template0\n           LC_COLLATE = \"C\"\n           LC_CTYPE = \"C\";\n  '';\n\n  ensureDatabases = lib.optional cfg.slack.enable \"mautrix-slack\";\n  ensureUsers = lib.optional cfg.slack.enable {\n    name = \"mautrix-slack\";\n    ensureDBOwnership = true;\n  };\n};","p":"modules/nixos/serv/matrix/synapse.nix","r":1309,"sp":[84,102,5,7],"sh":"024561a4de6cf24ec613c501439b0b0aba6e6fe47129963b683e8468960e9a45","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
