{"t":"n","a":1405,"i":"85c1db0e-957b-4c4d-a43d-2ed439a178f3","k":"variable","n":"accounts","d":"accounts = lib.mkOption {\n  default = [ ];\n  description = ''\n    Accounts to watch. Listing an account here does not log it in — run\n    `you-have-mail-setup` once afterwards to supply the password and TOTP.\n  '';\n  type = lib.types.listOf (lib.types.submodule {\n    options = {\n      email = lib.mkOption {\n        type = lib.types.str;\n        description = \"Address of the account to watch.\";\n      };\n      backend = lib.mkOption {\n        type = lib.types.str;\n        default = \"Proton Mail\";\n        description = \"Backend name, as registered by you-have-mail-common.\";\n… (truncated)","p":"modules/nixos/serv/you-have-mail.nix","r":1416,"sp":[110,129,5,7],"sh":"2c5144e73c68bb27282e118721d73e2cd1483752c70c97553226975346b6b935","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1406,"i":"301f99a9-ffb7-47bf-9337-966746b97973","k":"variable","n":"assertions","d":"assertions = [\n  {\n    assertion = cfg.ntfy != [ ] || cfg.stdoutNotifier;\n    message = ''\n      serv.youHaveMail needs at least one notifier: add an entry to\n      serv.youHaveMail.ntfy or set serv.youHaveMail.stdoutNotifier = true.\n      The service refuses to start without one.\n    '';\n  }\n];","p":"modules/nixos/serv/you-have-mail.nix","r":1408,"sp":[166,175,5,7],"sh":"fa7fe3582689e2a2ae9170605783f3f74264cc79892936cf7e55d5e1499b3b95","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1407,"i":"3160df9b-44f8-4449-9ea0-a8eda2c4004a","k":"variable","n":"cfg","d":"cfg = config.serv.youHaveMail;","p":"modules/nixos/serv/you-have-mail.nix","r":1401,"sp":[4,4,3,33],"sh":"4812ee7e9ac17f94d7f2720f8ce04c100f0643bfc52f3f19a99170891cb812b3","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1408,"i":"f5d139af-dc62-4524-9308-e17bc44985ba","k":"variable","n":"config","d":"config = lib.mkIf cfg.enable {\n  assertions = [\n    {\n      assertion = cfg.ntfy != [ ] || cfg.stdoutNotifier;\n      message = ''\n        serv.youHaveMail needs at least one notifier: add an entry to\n        serv.youHaveMail.ntfy or set serv.youHaveMail.stdoutNotifier = true.\n        The service refuses to start without one.\n      '';\n    }\n  ];\n\n  users.users.${user} = {\n    isSystemUser = true;\n    group = user;\n    home = stateDir;\n    description = \"You Have Mail observer\";\n  };\n  users.groups.${user} = { };\n\n  environment.systemPackages = [ setupScript ];\n… (truncated)","p":"modules/nixos/serv/you-have-mail.nix","r":1401,"sp":[165,228,3,5],"sh":"756be6ff5903f196d2ef231e6370d3164b1e5e31e734238ec5a204490db6a252","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1409,"i":"163c9540-cec7-4021-8df2-27bae2a4d1a6","k":"variable","n":"configFile","d":"configFile = \"${stateDir}/config.toml\";","p":"modules/nixos/serv/you-have-mail.nix","r":1401,"sp":[9,9,3,42],"sh":"ce106ec8df554c7ada45682cbfc18fbc2f7005d0d884c11c7e66114392d8014d","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1410,"i":"fda56e0d-5060-4190-9227-3323a4226f47","k":"variable","n":"configTemplate","d":"configTemplate = pkgs.writeText \"you-have-mail-config.toml\" (''\n  # Generated by the serv.youHaveMail module; overwritten on every start.\n  # \"Plain\" keeps the state-encryption key in a 0600 file beside this one.\n  # The alternative, \"Keyring\", needs a login session this service never has,\n  # and its kernel-keyring backend would not survive a reboot.\n  secrets = \"Plain\"\n  accept_plain_secrets_insecure = true\n  poll_interval = ${toString cfg.pollInterval}\n  stdout_notifier = ${lib.boolToString cfg.stdoutNotifier}\n''\n  + lib.concatStrings (map accountBlock cfg.accounts)\n… (truncated)","p":"modules/nixos/serv/you-have-mail.nix","r":1401,"sp":[31,42,3,57],"sh":"11aa5f84b1b931107f7f9b3dc750fe919cbf51577e11fc878096e89bf7e76fac","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1411,"i":"d7177231-9569-48ca-9534-23c32b9b3585","k":"variable","n":"enable","d":"enable = lib.mkEnableOption \"You Have Mail email notification observer\";","p":"modules/nixos/serv/you-have-mail.nix","r":1416,"sp":[86,86,5,77],"sh":"f53e7fd34f062faebdcc5559015b26b14022625f180e66f79eabe1de66ab5659","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
