{"t":"n","a":1315,"i":"249b4cbb-0dbd-4471-bbaf-1647557b0711","k":"variable","n":"\"m.homeserver\".base_url","d":"\"m.homeserver\".base_url = \"https://${cfg.hostName}\";","p":"modules/nixos/serv/matrix/web.nix","r":1324,"sp":[12,12,5,57],"sh":"c466e9e78440bf3cb027405c6140a5d07696b74b04bee8fdc55d48d7ea73a4e1","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
