{"t":"n","a":1293,"i":"fb0fce5d-3069-433e-8c58-e47637969945","k":"variable","n":"systemd.services.mautrix-slack","d":"systemd.services.mautrix-slack = {\n  description = \"mautrix-slack Matrix-Slack puppeting bridge\";\n  wantedBy = [ \"multi-user.target\" ];\n  wants = [ \"network-online.target\" ];\n  after = [\n    \"network-online.target\"\n    \"postgresql.service\"\n    \"matrix-synapse.service\"\n    \"matrix-appservice-tokens.service\"\n  ];\n  requires = [\n    \"postgresql.service\"\n    \"matrix-appservice-tokens.service\"\n  ];\n\n  serviceConfig = {\n    Type = \"simple\";\n    User = \"mautrix-slack\";\n    Group = \"mautrix-slack\";\n    StateDirectory = \"mautrix-slack\";\n    StateDirectoryMode = \"0700\";\n… (truncated)","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1283,"sp":[99,154,5,7],"sh":"8855cbbf48e10e8dc105e7cb868733e94beddaa89f226d99a6e74eded5e0d66e","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1294,"i":"4f39b3ce-b06c-4673-be1b-efa32469ead8","k":"variable","n":"users.groups.mautrix-slack","d":"users.groups.mautrix-slack = { };","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1283,"sp":[97,97,5,38],"sh":"236438c642964f0bb067321a024082c41ff53a3a3d4f0af73e2f1e904406780b","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1295,"i":"c86c798d-262f-49c3-a113-73d3168643ef","k":"variable","n":"users.users.mautrix-slack","d":"users.users.mautrix-slack = {\n  isSystemUser = true;\n  group = \"mautrix-slack\";\n  home = \"/var/lib/mautrix-slack\";\n};","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1283,"sp":[92,96,5,7],"sh":"0e512bf3cee4035c5213cd318538b4bc8be0e1aa6ad69c41cb7cfe2be9c1808a","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1296,"i":"2cb55115-fbfb-4042-8dfe-b7acea8d01c0","k":"file","n":"options.nix","d":"Provides the NixOS module options for the Matrix homeserver stack, exposing settings such as enable and hostName for configuring the service.","p":"modules/nixos/serv/matrix/options.nix","r":1244,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1297,"i":"076c9fbb-3fa1-4b07-9322-2b14da933f62","k":"variable","n":"acmeEmail","d":"acmeEmail = lib.mkOption {\n  type = lib.types.str;\n  description = \"Contact address Let's Encrypt uses for expiry warnings.\";\n};","p":"modules/nixos/serv/matrix/options.nix","r":1304,"sp":[41,44,5,7],"sh":"8aaa51256a71468fdec3f8709f84f2a48ca047174eb13e0e1b15deabf7b5b00b","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1298,"i":"674620cc-9b16-4b35-9e7b-0b73d6199b0d","k":"variable","n":"admins","d":"admins = lib.mkOption {\n  type = lib.types.listOf lib.types.str;\n  default = [ ];\n  example = [ \"ben\" ];\n  description = ''\n    Localparts of accounts that get bridge admin rights. These still have to\n    be created once with `matrix-synapse-register_new_matrix_user`.\n  '';\n};","p":"modules/nixos/serv/matrix/options.nix","r":1304,"sp":[31,39,5,7],"sh":"a7b0a6ab99339e1063a9ce182a813fe841c967d37ba1b1614a2a036d2b1e95ec","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1299,"i":"9b45c070-961e-4750-b3c5-39f55552cfaa","k":"variable","n":"backup","d":"backup = {\n  enable = lib.mkEnableOption \"nightly restic backups of Synapse and the bridge\";\n\n  repository = lib.mkOption {\n    type = lib.types.str;\n    example = \"s3:s3.us-west-004.backblazeb2.com/graphide-matrix-backup\";\n    description = \"Restic repository URL.\";\n  };\n\n  environmentFile = lib.mkOption {\n    type = lib.types.path;\n    example = \"/var/lib/matrix-secrets/restic.env\";\n    description = ''\n      File holding the repository credentials as environment variables, e.g.\n      `AWS_ACCESS_KEY_ID` / `AWS_SECRET_ACCESS_KEY`. Create it out of band with\n… (truncated)","p":"modules/nixos/serv/matrix/options.nix","r":1304,"sp":[89,113,5,7],"sh":"1c77387da13797cb88deadbf9e3a2d503c1a731346e8f5b284e6826aa6ad5912","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
