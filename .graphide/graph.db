{"t":"n","a":1274,"i":"b5cbe056-53bc-4127-82c1-5ecbbf4c5bcb","k":"variable","n":"text","d":"text = ''\n  install -d -m 0700 \"${dumpDir}\"\n  for db in matrix-synapse mautrix-slack; do\n    if runuser -u postgres -- psql -lqt | cut -d'|' -f1 | grep -qw \"$db\"; then\n      runuser -u postgres -- pg_dump --format=custom \"$db\" > \"${dumpDir}/$db.dump\"\n    fi\n  done\n'';","p":"modules/nixos/serv/matrix/backup.nix","r":1269,"sp":[21,28,5,8],"sh":"13f15539c6ad7c130dee04520641fb71ba51cccc9e53fcf4380ec509e71dd564","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1275,"i":"e96b0deb-741a-4612-b1b4-c125a5bd9598","k":"file","n":"default.nix","d":"NixOS module that aggregates Matrix service configuration, importing options and sub-modules for Synapse, appservice token handling, Mautrix Slack bridge, web UI, and backup support.","p":"modules/nixos/serv/matrix/default.nix","r":1244,"tg":["lang:nix","source:tree-sitter"]}
