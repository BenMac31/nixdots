{"t":"n","a":1110,"i":"fd28550a-58e6-440e-9e49-c3095d5452de","k":"variable","n":"hardware.pulseaudio.enable","d":"hardware.pulseaudio.enable = false;","p":"modules/nixos/head/default.nix","r":1108,"sp":[24,24,5,40],"sh":"8064d1a590c886c2a7c7646ab29c4ae46104d42b08ba377a85386bdc282e5c65","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
