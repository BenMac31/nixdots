{"t":"n","a":1259,"i":"538ac608-83cb-4d2b-b800-79f8153f7d27","k":"variable","n":"slack","d":"slack = cfg.slack;","p":"modules/nixos/serv/matrix/appservice-tokens.nix","r":1245,"sp":[9,9,3,21],"sh":"76c58da0e421bcfcd60d4ea5d50e39eab337aaaf0ea9a60d9a44aff3209795b7","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
