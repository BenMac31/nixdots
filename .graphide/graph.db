{"t":"n","a":876,"i":"4b7dd6ca-7ef5-4236-8a5c-77aac3fceb92","k":"variable","n":"themePatcher","d":"themePatcher = pkgs.writeText \"signal-theme-patch.py\" ''\n  import sys, json, struct, re, hashlib\n\n  ASAR = sys.argv[1]\n\n  COLOR_MAP = {\n      \"#121212\": \"#${p.base00}\",\n      \"#1b1b1b\": \"#${p.base00}\",\n      \"#2e2e2e\": \"#${p.base01}\",\n      \"#3b3b3b\": \"#${p.base01}\",\n      \"#4a4a4a\": \"#${p.base02}\",\n      \"#545454\": \"#${p.base02}\",\n      \"#5e5e5e\": \"#${p.base03}\",\n      \"#848484\": \"#${p.base04}\",\n      \"#b9b9b9\": \"#${p.base05}\",\n      \"#dedede\": \"#${p.base05}\",\n      \"#e9e9e9\": \"#${p.base06}\",\n      \"#f6f6f6\": \"#${p.base06}\",\n      \"#fff\":    \"#${p.base06}\",\n… (truncated)","p":"modules/home-manager/desktop/signal.nix","r":866,"sp":[7,223,3,6],"sh":"c1cbd54eef195f9bb61ca6984b972030b3fbed509cde114a0e46f2de658e062f","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
