{"t":"n","a":621,"i":"b71a8823-cd14-4ead-b116-8fe18bcaac3c","k":"variable","n":"reserveWidgetSpace","d":"reserveWidgetSpace = lib.mkOption {\n  type = lib.types.bool;\n  default = false;\n  description = \"Reserve a company sidebar alongside tiled windows.\";\n};","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":618,"sp":[28,32,5,7],"sh":"589c4c136570242c2a82ac688573e25a0765fdd2b05effbe23c52e22c62dbfef","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":622,"i":"13aa19b9-04ac-4b9d-84aa-7bd3cf56ea03","k":"variable","n":"runtime","d":"runtime = [ shared.hackerboard-python pkgs.brightnessctl pkgs.pulseaudio pkgs.pavucontrol\npkgs.playerctl pkgs.networkmanagerapplet pkgs.systemd pkgs.libnotify\npkgs.xdg-utils pkgs.waybar-pomodoro pkgs.rbw pkgs.wl-clipboard\npkgs.swaynotificationcenter pkgs.kitty\npkgs.gh pkgs.protonmail-bridge\nshared.agent-desktops shared.graphide-accounts ];","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":612,"sp":[5,10,3,54],"sh":"7c78454dfa99ac82b1e3fdb2747d9a51cc2b9c7681f3fc048fc43fb77ba4518d","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
