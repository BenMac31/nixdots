{"t":"n","a":1431,"i":"9981c025-3953-4f13-83ec-a8535bb70c2b","k":"variable","n":"options.custom.tailscale.enable","d":"options.custom.tailscale.enable = lib.mkEnableOption \"the Tailscale client daemon\";","p":"modules/nixos/tailscale.nix","r":1427,"sp":[39,39,3,86],"sh":"a8fe692254119a2651fb997719788935d4b01720b72e966d2aefda341c8d1461","tg":["arch:auto-attached","description:declaration","lang:nix","nix:option","source:tree-sitter","visibility:public"]}
