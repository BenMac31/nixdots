{"t":"n","a":1345,"i":"385ba111-b756-497a-b3c9-8ec6aa0bdcd5","k":"variable","n":"services.jellyfin","d":"services.jellyfin = {\n  openFirewall = true;\n  enable = true;\n  dataDir = \"/srv/media\";\n};","p":"modules/nixos/serv/media.nix","r":1341,"sp":[7,11,7,9],"sh":"53da13292853039d4b8d73452d0ee930c7dc121782bb89e08d2a5cb78dc6e9de","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
