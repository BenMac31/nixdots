{"t":"n","a":1008,"i":"97233113-abcc-48d8-8384-8cfd77809646","k":"variable","n":"programs.mpv.enable","d":"programs.mpv.enable = true;","p":"modules/home-manager/term/media.nix","r":1006,"sp":[4,4,5,32],"sh":"d2924dc582d8adb1282e9e8aed5d3b731cc7335728642e54490d4dd683f23c17","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":1009,"i":"cd093788-a493-449c-b8f2-3fe1841b7316","k":"module","n":"Programming Options for Home Manager Terminal","d":"Provides a Home Manager terminal module that defines a 'programming' option toggle, optional sub‑options for Python and R, and, when enabled, installs the R package (and enables Python by default) into the user's home environment.","p":"modules/home-manager/term/programming","r":1010,"tg":["evidence:source","lang:nix","layer:architecture","source:arch-agent"]}
{"t":"n","a":1010,"i":"3ca667e9-c7db-4c90-96e7-1e594e741d61","k":"subsystem","n":"modules/home-manager/term/programming — Programming support for terminal","d":"Nix configuration providing programming language tooling within the terminal, including a Python integration module.","p":"modules/home-manager/term/programming","r":913,"tg":["evidence:signatures","layer:overview","overview:rung:directory","source:overview-agent"]}
{"t":"n","a":1011,"i":"aafda7a7-aaef-45eb-90ce-ebb69c8d9848","k":"file","n":"default.nix","d":"Nix module that provides programming support for Home Manager, defining enable options for a generic programming environment and optional R integration, and wiring in the Python submodule and R package into the user's home configuration.","p":"modules/home-manager/term/programming/default.nix","r":1009,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1012,"i":"5c4b513d-79b3-4972-8a8f-cfa6bba403a6","k":"variable","n":"config","d":"config = lib.mkIf config.programming.enable {\n  programming = {\n    python.enable = lib.mkDefault true;\n    R.enable = lib.mkDefault true;\n  };\n  home.packages = with pkgs; [\n    (lib.mkIf config.programming.R.enable R)\n  ];\n};","p":"modules/home-manager/term/programming/default.nix","r":1011,"sp":[12,20,3,5],"sh":"682b1d452e0fd2c11bb4f3c96ca1243b5ffd1f6316349af4a3799d78fad142f6","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1013,"i":"7f81cb8d-4b00-4b3e-b4d0-d9c0ccf9f741","k":"variable","n":"home.packages","d":"home.packages = with pkgs; [\n  (lib.mkIf config.programming.R.enable R)\n];","p":"modules/home-manager/term/programming/default.nix","r":1012,"sp":[17,19,5,7],"sh":"4121cac585b040536fe3268415a24ad4ee561a90752f9270f574e91dca6d4226","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1014,"i":"305387c2-9b08-4428-bcf3-5ce1c6cea95f","k":"variable","n":"imports","d":"imports = [\n  ./python\n];","p":"modules/home-manager/term/programming/default.nix","r":1011,"sp":[3,5,3,5],"sh":"84b8e378b145f9cd434263e4218e09ad4144bd0a88a44da7ef03d83487c3cd54","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1015,"i":"fe359c6c-ca8c-4032-825e-7b9834d38730","k":"variable","n":"options","d":"options = {\n  programming = {\n    enable = lib.mkEnableOption \"Enable programming\";\n    R.enable = lib.mkEnableOption \"Enable R\";\n  };\n};","p":"modules/home-manager/term/programming/default.nix","r":1011,"sp":[6,11,3,5],"sh":"f3ff9c474afb83debaf4ad8c2815a6d48211dfe9e75fc858ee24b772b3ecc8a6","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1016,"i":"af75c865-6243-4848-b941-4fc246852b9c","k":"variable","n":"programming","d":"programming = {\n  python.enable = lib.mkDefault true;\n  R.enable = lib.mkDefault true;\n};","p":"modules/home-manager/term/programming/default.nix","r":1012,"sp":[13,16,5,7],"sh":"cfd523d9457dd5ade3619897697c131858b77c04759913c3c79211e16e716348","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1017,"i":"e0e66570-562b-4e35-a3fd-a0497efe27c3","k":"variable","n":"programming","d":"programming = {\n  enable = lib.mkEnableOption \"Enable programming\";\n  R.enable = lib.mkEnableOption \"Enable R\";\n};","p":"modules/home-manager/term/programming/default.nix","r":1015,"sp":[7,10,5,7],"sh":"9a4ca72a840fe5aafb1dd93636faec12ba2063d759de9c2caad651925a7f5308","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1018,"i":"33e78263-61ca-45c1-8c4c-33b75fd6e3ee","k":"module","n":"Python Programming Package Module","d":"Adds a Home Manager option to enable a Python programming environment; when the option is enabled it installs Python 3 together with common scientific libraries (matplotlib, scipy, numpy, sympy, pandas) as part of the user's home packages.","p":"modules/home-manager/term/programming/python","r":1010,"tg":["evidence:source","lang:nix","layer:architecture","source:arch-agent"]}
{"t":"n","a":1019,"i":"bd1d0688-6bb3-4560-ac11-57ba2e5c521c","k":"file","n":"default.nix","d":"Home Manager module that adds an enableable option to install a Python interpreter with common scientific packages (matplotlib, scipy, numpy, sympy, pandas) into the user’s home environment.","p":"modules/home-manager/term/programming/python/default.nix","r":1018,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1020,"i":"eec5543e-2544-4465-b4f3-8dd377f7df83","k":"variable","n":"config","d":"config = lib.mkIf config.programming.python.enable {\n  home.packages = with pkgs; [\n    (pkgs.python3.withPackages (python-pkgs: with python-pkgs; [\n      matplotlib\n      scipy\n      numpy\n      sympy\n      pandas\n    ]))\n  ];\n};","p":"modules/home-manager/term/programming/python/default.nix","r":1019,"sp":[8,18,3,5],"sh":"8367f5a0a4ab7a8c12e4d9b00979df326610cda8a90753cb106ddd924e76d782","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1021,"i":"c64d7156-ab11-4448-8ad4-5cf629896199","k":"variable","n":"home.packages","d":"home.packages = with pkgs; [\n  (pkgs.python3.withPackages (python-pkgs: with python-pkgs; [\n    matplotlib\n    scipy\n    numpy\n    sympy\n    pandas\n  ]))\n];","p":"modules/home-manager/term/programming/python/default.nix","r":1020,"sp":[9,17,5,7],"sh":"e54bdc9b310c5fd59063a396edb9b090af36b1f6311414737017cbbd954e41a9","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1022,"i":"9ab9a3b0-714f-45b9-9b48-ca6bbde60644","k":"variable","n":"options","d":"options = {\n  programming.python = {\n    enable = lib.mkEnableOption \"Enable programming\";\n  };\n};","p":"modules/home-manager/term/programming/python/default.nix","r":1019,"sp":[3,7,3,5],"sh":"585e4ed68ef74168d516f96fd6bbc79723d85c8ecb6140c05eff01d6b97012d5","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1023,"i":"fb2c6898-eca6-4ea1-b088-35c35c3b0439","k":"variable","n":"programming.python","d":"programming.python = {\n  enable = lib.mkEnableOption \"Enable programming\";\n};","p":"modules/home-manager/term/programming/python/default.nix","r":1022,"sp":[4,6,5,7],"sh":"af1c5edc200d12cd53d1adbf3be638cb5db7cd610e1afc5600a1c2859c8e1080","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1024,"i":"b270148e-adc0-467c-807b-14473cb14266","k":"file","n":"ssh.nix","d":"Home-manager module that configures the SSH client when enabled, adding extra SSH settings such as connection sharing and automatic key addition via AddKeysToAgent.","p":"modules/home-manager/term/ssh.nix","r":912,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1025,"i":"f389c2b1-8b43-4071-bf4c-50fe0efe44cd","k":"variable","n":"config","d":"config = lib.mkIf config.programs.ssh.enable {\n  programs.ssh = {\n    # Enable connection sharing to reuse authenticated connections\n    # This allows SSH to cache authentication during a session\n    extraConfig = ''\n      # Add keys to agent automatically\n      AddKeysToAgent yes\n\n      # Use SSH agent for authentication\n      IdentitiesOnly yes\n    '';\n  };\n\n  # Enable SSH agent service to cache passphrases during session\n  services.ssh-agent.enable = true;\n};","p":"modules/home-manager/term/ssh.nix","r":1024,"sp":[4,19,3,5],"sh":"f2ecaf4f7b02b1eca70068b02edfecc748124993fa1b709b5c393be419974cb6","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1026,"i":"927d1e08-fb94-4b5a-a95b-eee2e1846658","k":"variable","n":"programs.ssh","d":"programs.ssh = {\n  # Enable connection sharing to reuse authenticated connections\n  # This allows SSH to cache authentication during a session\n  extraConfig = ''\n    # Add keys to agent automatically\n    AddKeysToAgent yes\n\n    # Use SSH agent for authentication\n    IdentitiesOnly yes\n  '';\n};","p":"modules/home-manager/term/ssh.nix","r":1025,"sp":[5,15,5,7],"sh":"5e3fe99e6791778e025ab6e559ab7e30c5b83897e6daa2e20fceb0c19cdc03d1","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1027,"i":"fc7d409c-65df-461a-b990-17fe106e925a","k":"variable","n":"services.ssh-agent.enable","d":"services.ssh-agent.enable = true;","p":"modules/home-manager/term/ssh.nix","r":1025,"sp":[17,18,1,38],"sh":"a030f3fe762c41e7e4ecc73f27a7ca339a3157cff90531944f3841264502fbce","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":1028,"i":"eb6e39c7-1b3f-4289-8a5b-f07599b4549e","k":"module","n":"Terminal TUI Applications","d":"Provides a Home Manager option to enable terminal TUI apps and, when enabled, configures Neovim (with additional editor packages), Newsboat (with extensive keybindings, color schemes, and OCNews integration), and installs common terminal utilities such as btop and optional media players. It composes these settings via imported sub-modules for Neovim and Newsboat configuration.","p":"modules/home-manager/term/tui","r":913,"tg":["evidence:source","lang:nix","layer:architecture","source:arch-agent"]}
{"t":"n","a":1029,"i":"326b2ab8-00b5-48a6-b375-0da825f067a7","k":"file","n":"default.nix","d":"Home Manager module that provides a ‘tui’ enable option to configure and install a collection of terminal UI applications (Neovim, Newsboat, btop, ncmpcpp, ytfzf) and includes the vim and newsboat sub-modules.","p":"modules/home-manager/term/tui/default.nix","r":1028,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1030,"i":"68ba4bde-15f9-49d0-9116-46df750ba7c1","k":"variable","n":"config","d":"config = lib.mkIf config.tui.enable {\n  programs.neovim.enable = lib.mkDefault true;\n  programs.newsboat.enable = lib.mkIf config.desktop.enable (lib.mkDefault true);\n  home.packages = with pkgs; [\n    btop\n    (lib.mkIf config.media.enable ncmpcpp)\n    (lib.mkIf config.media.enable unfree.ytfzf)\n  ];\n};","p":"modules/home-manager/term/tui/default.nix","r":1029,"sp":[12,20,3,5],"sh":"c860653245981d4cd34f9a79dc9e8e5afb84ebda9cd62fb7ce17f9c9e96394da","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1031,"i":"2314324b-57dc-45e5-9b58-cf3b097654b4","k":"variable","n":"home.packages","d":"home.packages = with pkgs; [\n  btop\n  (lib.mkIf config.media.enable ncmpcpp)\n  (lib.mkIf config.media.enable unfree.ytfzf)\n];","p":"modules/home-manager/term/tui/default.nix","r":1030,"sp":[15,19,5,7],"sh":"4babbc20403ccc20cb648a60ff5ca123199cbb6d516542c67beb545e3d5ded18","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1032,"i":"453a8d0d-50ea-4eba-9d69-d13ea7d18ecf","k":"variable","n":"imports","d":"imports = [\n  ./vim.nix\n  ./newsboat.nix\n];","p":"modules/home-manager/term/tui/default.nix","r":1029,"sp":[3,6,3,5],"sh":"690c2dcc31b405abb8e6b662c61c07e71b215730c1687a27c931bc738245bb60","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1033,"i":"ef7dc691-6ee8-4e68-9f5c-c3110b8686ca","k":"variable","n":"options","d":"options = {\n  tui = {\n    enable = lib.mkEnableOption \"Enable tui apps\";\n  };\n};","p":"modules/home-manager/term/tui/default.nix","r":1029,"sp":[7,11,3,5],"sh":"432dead2f52fee8d45c207a32136af310cf1b0a4a89bed5a42172005655c83f4","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
