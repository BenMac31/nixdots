{"t":"n","a":772,"i":"77f8f0a2-5dcb-47d9-ad1a-291eb6e18049","k":"variable","n":"options.healthAlerts","d":"options.healthAlerts = {\n  enable = lib.mkEnableOption \"Laptop system health alerts (battery, disk, release deprecation)\";\n\n  disk = {\n    warnPercent = lib.mkOption {\n      type = lib.types.int;\n      default = 90;\n      description = \"Disk usage percentage that triggers a terminal warning.\";\n    };\n    critPercent = lib.mkOption {\n      type = lib.types.int;\n      default = 95;\n      description = \"Disk usage percentage that triggers a critical terminal warning.\";\n    };\n  };\n\n  battery = {\n    warnPercent = lib.mkOption {\n      type = lib.types.int;\n      default = 30;\n… (truncated)","p":"modules/home-manager/desktop/health-alerts.nix","r":760,"sp":[193,226,3,5],"sh":"f999107b2fe6cac03b11709f8d72c9b71821dfb778c999f2f48f31d15a1365b5","tg":["arch:auto-attached","description:declaration","lang:nix","nix:option","source:tree-sitter","visibility:public"]}
{"t":"n","a":773,"i":"ede42711-f29c-4c94-8cde-479b72caffb0","k":"variable","n":"programs.zsh.initExtra","d":"programs.zsh.initExtra = lib.mkIf config.programs.zsh.enable (\n  lib.mkAfter /*bash*/ ''\n    system_health_cache=\"$HOME/.cache/system-health\"\n    if [[ -d \"$system_health_cache\" ]]; then\n      for warning_file in \"$system_health_cache\"/*-warning(N); do\n        print -P \"%F{red}$(<\"$warning_file\")%f\" >&2\n      done\n    fi\n  ''\n);","p":"modules/home-manager/desktop/health-alerts.nix","r":765,"sp":[284,293,5,7],"sh":"f60915074c89ecf51606c620570fae222c522995a1e5fe2e74270bffb3377f48","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":774,"i":"66945aa6-99d6-4940-b0ad-253368baf60a","k":"variable","n":"ref","d":"ref = lock.nodes.${nixpkgsNode}.original.ref or \"\";","p":"modules/home-manager/desktop/health-alerts.nix","r":770,"sp":[12,12,7,58],"sh":"684a75144dab52a4b8e9dc6faf70b3e7c83883a16314ffd2bd422913216c0265","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":775,"i":"59366d57-ecb5-460d-89ee-3adf3af0a131","k":"variable","n":"releaseScript","d":"releaseScript =\nif nixpkgsChannel == null then\n  pkgs.writeShellScript \"health-alerts-release\" \"exit 0\"\nelse\n  pkgs.writeShellScript \"health-alerts-release\" ''\n    set -eu\n\n    CHANNEL=\"${nixpkgsChannel}\"\n    CACHE_DIR=\"${cacheDir}\"\n    WARN_FILE=\"$CACHE_DIR/release-warning\"\n\n    mkdir -p \"$CACHE_DIR\"\n\n    if ! data=$(${pkgs.curl}/bin/curl -sf 'https://prometheus.nixos.org/api/v1/query?query=channel_revision'); then\n      exit 0\n    fi\n\n    status=$(${pkgs.jq}/bin/jq -r --arg ch \"$CHANNEL\" \\\n… (truncated)","p":"modules/home-manager/desktop/health-alerts.nix","r":760,"sp":[139,190,3,10],"sh":"e6bd49bf7c1e7f93fae6147026254c79654d7dbe6c87a624b518a19a69b91482","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":776,"i":"5426afe1-348b-4791-a440-bddad50397a6","k":"variable","n":"systemd.user.services.health-alerts-battery","d":"systemd.user.services.health-alerts-battery = {\n  Unit = {\n    Description = \"Battery low alerts via UPower\";\n    After = [ \"graphical-session.target\" ];\n  };\n  Service = {\n    ExecStart = \"${batteryScript}\";\n    Restart = \"always\";\n    RestartSec = \"10\";\n  };\n  Install.WantedBy = [ \"default.target\" ];\n};","p":"modules/home-manager/desktop/health-alerts.nix","r":765,"sp":[229,240,5,7],"sh":"a088f8f7c1dd89c197e43fccc1f41f7984a70765d0300b5a0aa1a7fbf1bf6cd3","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":777,"i":"396e2864-7675-48f3-8e2a-dbc61fe429d4","k":"variable","n":"systemd.user.services.health-alerts-disk","d":"systemd.user.services.health-alerts-disk = {\n  Unit = {\n    Description = \"Check disk space and update terminal warning cache\";\n  };\n  Service = {\n    Type = \"oneshot\";\n    ExecStart = \"${diskScript}\";\n  };\n};","p":"modules/home-manager/desktop/health-alerts.nix","r":765,"sp":[242,250,5,7],"sh":"051ebc61e3cdac6f59a5e3cf83a80fb6e47129a8716a12afcd83516c3780a2a3","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":778,"i":"9eaefc88-734a-46a2-b10d-f8f246df6b04","k":"variable","n":"systemd.user.services.health-alerts-release","d":"systemd.user.services.health-alerts-release = {\n  Unit = {\n    Description = \"Check NixOS release deprecation and update terminal warning cache\";\n  };\n  Service = {\n    Type = \"oneshot\";\n    ExecStart = \"${releaseScript}\";\n  };\n};","p":"modules/home-manager/desktop/health-alerts.nix","r":765,"sp":[263,271,5,7],"sh":"4d73664d6a2fc23cbd5e0d46d25b9725c6d769188a33e00f7b715820f64ea95b","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":779,"i":"817b73dc-b179-4973-af08-201da859e75f","k":"variable","n":"systemd.user.timers.health-alerts-disk","d":"systemd.user.timers.health-alerts-disk = {\n  Unit = {\n    Description = \"Daily disk space check\";\n  };\n  Timer = {\n    OnCalendar = \"daily\";\n    Persistent = true;\n  };\n  Install.WantedBy = [ \"timers.target\" ];\n};","p":"modules/home-manager/desktop/health-alerts.nix","r":765,"sp":[252,261,5,7],"sh":"60d0b9e1fcc2953af873d16037d7e35829f6e566877cd445e10daa0943282127","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":780,"i":"48d859b3-96fc-4248-ac9a-f620d59b37a7","k":"variable","n":"systemd.user.timers.health-alerts-release","d":"systemd.user.timers.health-alerts-release = {\n  Unit = {\n    Description = \"Weekly NixOS release deprecation check\";\n  };\n  Timer = {\n    OnCalendar = \"Mon *-*-* 09:00:00\";\n    Persistent = true;\n  };\n  Install.WantedBy = [ \"timers.target\" ];\n};","p":"modules/home-manager/desktop/health-alerts.nix","r":765,"sp":[273,282,5,7],"sh":"eee5d0cbd810b5205262b02e06cc352d345abdfb3e8c6e36debd04fd9e53a9b9","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":781,"i":"6120e092-ac2b-4d94-aefb-40ebac5fca12","k":"file","n":"japanese.nix","d":"Home Manager desktop module that adds Japanese language support, exposing the options.desktop.japanese enable flags and, when enabled, installs Japanese fonts and input utilities into the user’s home environment.","p":"modules/home-manager/desktop/japanese.nix","r":475,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":782,"i":"013e9d99-2fd9-4318-a2f3-6a6192682260","k":"variable","n":"config","d":"config = lib.mkIf config.desktop.japanese.enable {\n  desktop.japanese.input.enable = lib.mkDefault true;\n  home.packages = with pkgs;\n    [\n      (lib.mkIf config.media.enable mokuro)\n      noto-fonts-cjk-sans\n      source-han-sans\n      source-han-mono\n      source-han-serif\n      source-han-sans-vf-ttf\n      source-han-sans-vf-otf\n    ];\n  home.sessionVariables = lib.mkIf config.desktop.japanese.input.enable {\n    QT_IM_MODULE = \"fcitx\";\n  };\n  i18n.inputMethod = lib.mkIf config.desktop.japanese.input.enable {\n    enable = true;\n    type = \"fcitx5\";\n… (truncated)","p":"modules/home-manager/desktop/japanese.nix","r":781,"sp":[7,34,3,5],"sh":"b8ed00447629a9ed0cca71aab3fe0d9e6758b70c7fd3c96bb2325a8110fdb1b5","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":783,"i":"1812b773-0bf3-46b1-990e-442847e395aa","k":"variable","n":"desktop.japanese.input.enable","d":"desktop.japanese.input.enable = lib.mkDefault true;","p":"modules/home-manager/desktop/japanese.nix","r":782,"sp":[8,8,5,56],"sh":"95a0937f1e0a51bb0ded9294dc417d18ef89befab20bc0f5cdad91d29743a7e6","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":784,"i":"f2ea74da-1db2-41d9-afd0-de56f21b9873","k":"variable","n":"enable","d":"enable = lib.mkEnableOption \"Enable Japanese\";","p":"modules/home-manager/desktop/japanese.nix","r":789,"sp":[4,4,5,51],"sh":"f17b9514218dd4d9fb7f696ac6353712ea36af45aeeb3e35dae50d95b07f3fb2","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":785,"i":"71a3f725-6f0c-497c-95ac-6704f148b00a","k":"variable","n":"home.packages","d":"home.packages = with pkgs;\n[\n  (lib.mkIf config.media.enable mokuro)\n  noto-fonts-cjk-sans\n  source-han-sans\n  source-han-mono\n  source-han-serif\n  source-han-sans-vf-ttf\n  source-han-sans-vf-otf\n];","p":"modules/home-manager/desktop/japanese.nix","r":782,"sp":[9,18,5,9],"sh":"57589bfb559522811fd807a402df527b99d2ffe4448d8b502f3e13200c2f702c","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":786,"i":"6bd81a7a-02e8-44b0-8910-371d714c9b37","k":"variable","n":"home.sessionVariables","d":"home.sessionVariables = lib.mkIf config.desktop.japanese.input.enable {\n  QT_IM_MODULE = \"fcitx\";\n};","p":"modules/home-manager/desktop/japanese.nix","r":782,"sp":[19,21,5,7],"sh":"f4846d689c352c435b44466861350e8e1a0662e079a238ba423513c3c6414dd6","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":787,"i":"0f9b23e6-492b-430a-904a-cd2f79b78c72","k":"variable","n":"i18n.inputMethod","d":"i18n.inputMethod = lib.mkIf config.desktop.japanese.input.enable {\n  enable = true;\n  type = \"fcitx5\";\n  fcitx5.addons = with pkgs; [\n    fcitx5-mozc-ut\n    fcitx5-gtk\n    qt6Packages.fcitx5-configtool\n  ];\n};","p":"modules/home-manager/desktop/japanese.nix","r":782,"sp":[22,30,5,7],"sh":"028d13a8d4984d0305357b0d6473f752af172c4146b91a2303d674ad07778450","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
