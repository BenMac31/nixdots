{"t":"n","a":1005,"i":"dd85d21f-dca2-493a-aee1-9b8e9340aed8","k":"file","n":"media.nix","d":"Home-manager module that adds media support: when config.media.enable is true it enables the mpv program and installs yt-dlp, mpc, ffmpeg-full, and imagemagick as user packages.","p":"modules/home-manager/term/media.nix","r":912,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1006,"i":"ac6304e3-a1ea-4235-8071-b36f4d71f8c1","k":"variable","n":"config","d":"config = lib.mkIf config.media.enable {\n  programs.mpv.enable = true;\n  home.packages = with pkgs; [\n    yt-dlp\n    mpc\n    unfree.ffmpeg-full\n    imagemagick\n  ];\n};","p":"modules/home-manager/term/media.nix","r":1005,"sp":[3,11,3,5],"sh":"5ebdc748ed4586766b7fa38da2c9adaf01d1b8c5c9c2ccaf987d2cf3f3ffaa87","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
