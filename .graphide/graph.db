{"t":"n","a":1413,"i":"61ebaa21-f805-4d05-ac71-d852a85a4637","k":"variable","n":"installConfig","d":"installConfig = pkgs.writeShellScript \"you-have-mail-install-config\" ''\n  set -euo pipefail\n\n  install -d -m 0700 -o ${user} -g ${user} ${stateDir} ${logDir}\n\n  umask 077\n  tmp=\"$(mktemp)\"\n  trap 'rm -f \"$tmp\"' EXIT\n  cp ${configTemplate} \"$tmp\"\n\n  ${lib.concatStrings (lib.imap0 (i: server:\n    lib.optionalString (server.authTokenFile != null) ''\n      token=\"$(cat ${lib.escapeShellArg server.authTokenFile})\"\n      sed -i \"s|${tokenPlaceholder i}|$token|g\" \"$tmp\"\n    '') cfg.ntfy)}\n\n  install -m 0600 -o ${user} -g ${user} \"$tmp\" ${configFile}\n'';","p":"modules/nixos/serv/you-have-mail.nix","r":1401,"sp":[44,61,3,6],"sh":"12cc2bb7632631fcbeb51c449efcb122b5fab56ca07065e2a2dc2265b441bba1","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1414,"i":"86e48fc0-92ee-4797-82fa-f53e6bbf0a41","k":"variable","n":"logDir","d":"logDir = \"${stateDir}/logs\";","p":"modules/nixos/serv/you-have-mail.nix","r":1401,"sp":[8,8,3,31],"sh":"01063f4f54b33ae2e691c42ab713c24150a9e0d4f2850269da47a20ae1ea584c","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1415,"i":"b8ebeef0-e345-4a58-8f3f-d7b4f3018288","k":"variable","n":"ntfy","d":"ntfy = lib.mkOption {\n  default = [ ];\n  description = \"ntfy instances to publish notifications to.\";\n  type = lib.types.listOf (lib.types.submodule {\n    options = {\n      name = lib.mkOption {\n        type = lib.types.str;\n        description = \"Label for this instance, used in the service logs.\";\n      };\n      url = lib.mkOption {\n        type = lib.types.str;\n        example = \"https://ntfy.sh/some-unguessable-topic\";\n        description = ''\n          Full topic URL to POST to. This ends up in the Nix store, which is\n… (truncated)","p":"modules/nixos/serv/you-have-mail.nix","r":1416,"sp":[131,162,5,7],"sh":"415c65d796b2809db6d872a76844df09d13931a5a2ac733a8dd4eb69c342c82f","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1416,"i":"41c22b51-da67-45ae-a845-5743c227cdcd","k":"variable","n":"options.serv.youHaveMail","d":"options.serv.youHaveMail = {\n  enable = lib.mkEnableOption \"You Have Mail email notification observer\";\n\n  package = lib.mkOption {\n    type = lib.types.package;\n    default = pkgs.you-have-mail-cli;\n    defaultText = lib.literalExpression \"pkgs.you-have-mail-cli\";\n    description = \"The you-have-mail-cli package to use.\";\n  };\n\n  pollInterval = lib.mkOption {\n    type = lib.types.ints.positive;\n    default = 300;\n    description = ''\n      Seconds between mailbox polls. Proton throttles aggressive clients, so\n      keep this comfortably above a minute.\n    '';\n  };\n… (truncated)","p":"modules/nixos/serv/you-have-mail.nix","r":1401,"sp":[85,163,3,5],"sh":"3026c48ac181d362ef6e8e6ae67b5c2d6a88299d81ad960e39f7462845e54aa9","tg":["arch:auto-attached","description:declaration","lang:nix","nix:option","source:tree-sitter","visibility:public"]}
{"t":"n","a":1417,"i":"331e5104-ccf3-4b37-aa5f-128a23cee404","k":"variable","n":"package","d":"package = lib.mkOption {\n  type = lib.types.package;\n  default = pkgs.you-have-mail-cli;\n  defaultText = lib.literalExpression \"pkgs.you-have-mail-cli\";\n  description = \"The you-have-mail-cli package to use.\";\n};","p":"modules/nixos/serv/you-have-mail.nix","r":1416,"sp":[88,93,5,7],"sh":"2acc85b2d1e7a1eba0ef1e1e5e30a0368d21d5972d7931434eac35be91d2a28e","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1418,"i":"c2dee410-8551-493f-91ff-288593837c53","k":"variable","n":"pollInterval","d":"pollInterval = lib.mkOption {\n  type = lib.types.ints.positive;\n  default = 300;\n  description = ''\n    Seconds between mailbox polls. Proton throttles aggressive clients, so\n    keep this comfortably above a minute.\n  '';\n};","p":"modules/nixos/serv/you-have-mail.nix","r":1416,"sp":[95,102,5,7],"sh":"95476081116afce251a674c5bee501acd99bb1789be690469ac24e454e20dbec","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1419,"i":"d309c1d6-54cf-4734-bc0d-f4322d676b4d","k":"variable","n":"setupScript","d":"setupScript = pkgs.writeShellScriptBin \"you-have-mail-setup\" ''\n  set -euo pipefail\n\n  if [ \"$(id -u)\" -ne 0 ]; then\n    echo \"you-have-mail-setup must be run as root\" >&2\n    exit 1\n  fi\n\n  systemctl stop you-have-mail.service || true\n  systemctl restart you-have-mail-config.service\n\n  runuser -u ${user} -- ${cfg.package}/bin/you-have-mail-cli \\\n    --config-dir ${stateDir} --log-dir ${logDir} --configure-accounts\n\n  systemctl start you-have-mail.service\n  echo \"Observer restarted. Follow it with: journalctl -fu you-have-mail\"\n'';","p":"modules/nixos/serv/you-have-mail.nix","r":1401,"sp":[63,82,1,6],"sh":"484cd16f2c77caa408d05bc78d8f7131383eb4f778e08438c21238bb094cee0a","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1420,"i":"e6399770-5327-4064-8565-6584daa0a21a","k":"variable","n":"stateDir","d":"stateDir = \"/var/lib/you-have-mail\";","p":"modules/nixos/serv/you-have-mail.nix","r":1401,"sp":[7,7,3,39],"sh":"bcb88c3d35c0488e7b9220ada39ab163751d4af11e39c5c98e39d434cc7cad94","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1421,"i":"5e6c9545-5b85-4e1c-90cc-e5660d49f5c2","k":"variable","n":"stdoutNotifier","d":"stdoutNotifier = lib.mkOption {\n  type = lib.types.bool;\n  default = false;\n  description = \"Echo every notification to the journal as well as to ntfy.\";\n};","p":"modules/nixos/serv/you-have-mail.nix","r":1416,"sp":[104,108,5,7],"sh":"100d20ceeb59ba3ab5b4ade2becb1696d41c7219ea8443d6a3f73442c64784ef","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1422,"i":"018e0a4d-266d-494b-b570-40fc4c73dfb2","k":"variable","n":"systemd.services.you-have-mail","d":"systemd.services.you-have-mail = {\n  description = \"You Have Mail email notification observer\";\n  wantedBy = [ \"multi-user.target\" ];\n  wants = [ \"network-online.target\" ];\n  after = [ \"network-online.target\" \"you-have-mail-config.service\" ];\n  serviceConfig = {\n    User = user;\n    Group = user;\n    ExecStart = \"${cfg.package}/bin/you-have-mail-cli --config-dir ${stateDir} --log-dir ${logDir}\";\n    Restart = \"always\";\n    RestartSec = 30;\n    WorkingDirectory = stateDir;\n\n    NoNewPrivileges = true;\n    PrivateTmp = true;\n    PrivateDevices = true;\n    ProtectHome = true;\n… (truncated)","p":"modules/nixos/serv/you-have-mail.nix","r":1408,"sp":[200,227,5,7],"sh":"2c99e91e15b1aa6bac61578c41444ca93d0b8197f4f0b4c43769bb051bdc8551","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1423,"i":"9d3017f5-e327-4dd9-b7d4-05ce67dff0ea","k":"variable","n":"systemd.services.you-have-mail-config","d":"systemd.services.you-have-mail-config = {\n  description = \"Render the You Have Mail configuration file\";\n  wantedBy = [ \"multi-user.target\" ];\n  before = [ \"you-have-mail.service\" ];\n  requiredBy = [ \"you-have-mail.service\" ];\n  path = with pkgs; [ coreutils gnused ];\n  serviceConfig = {\n    Type = \"oneshot\";\n    RemainAfterExit = true;\n    ExecStart = installConfig;\n  };\n};","p":"modules/nixos/serv/you-have-mail.nix","r":1408,"sp":[187,198,5,7],"sh":"b038a3cec249d5e4a792d78e12fab1802508a78d4fedce2e6d9d4becd5368d80","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
