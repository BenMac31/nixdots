{"t":"n","a":1278,"i":"27ddeed4-16fe-484d-b032-8a10c626379e","k":"variable","n":"adminPermissions","d":"adminPermissions = lib.listToAttrs (\n  map (localpart: lib.nameValuePair \"@${localpart}:${cfg.serverName}\" \"admin\") cfg.admins\n);","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1277,"sp":[11,13,3,5],"sh":"5a5fb31f2280b9f1e206915bf0564b3bf92a8c67972b30ee09bef067a34ccfec","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1279,"i":"b0925eed-7e3e-41b4-ab2e-53ccd571a44c","k":"variable","n":"appservice","d":"appservice = {\n  address = \"http://127.0.0.1:${toString slack.port}\";\n  hostname = \"127.0.0.1\";\n  port = slack.port;\n  id = slack.appserviceId;\n  bot = {\n    username = slack.botLocalpart;\n    displayname = \"Slack bridge bot\";\n    avatar = \"mxc://maunium.net/pVtzLmChZejGxLqmXtQjFxem\";\n  };\n  ephemeral_events = true;\n  as_token = \"@AS_TOKEN@\";\n  hs_token = \"@HS_TOKEN@\";\n  username_template = \"${slack.usernamePrefix}{{.}}\";\n};","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1284,"sp":[22,36,5,7],"sh":"cc8970466164404df83bf63157f899be3f6e506921f8ccc3c3bf9e12c6a68370","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1280,"i":"ab5bfa58-f698-492e-9048-504ca9b60e8d","k":"variable","n":"backfill","d":"backfill = {\n  enabled = true;\n  max_initial_messages = 50;\n  max_catchup_messages = 500;\n};","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1284,"sp":[69,73,5,7],"sh":"21b58274e820b4a5934a07ecd1a03fb5a73ca7105785ca0cfc8f39ced61273e4","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1281,"i":"f44d3c6a-97c0-409f-a6b3-4b3923e50e1b","k":"variable","n":"bridge","d":"bridge = {\n  command_prefix = \"!slack\";\n  permissions = {\n    \"${cfg.serverName}\" = \"user\";\n  }\n  // adminPermissions;\n};","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1284,"sp":[43,49,5,7],"sh":"042b8857c237a4da4e23596ce696c4585b3f59e052abea32d62bcace80d94662","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1282,"i":"466e1d8c-8c41-4fa5-95d0-706583b2e74a","k":"variable","n":"cfg","d":"cfg = config.serv.matrix;","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1277,"sp":[8,8,3,28],"sh":"a5778949504c61209623b7c551a0991824cad7d29f80a9bf4a73aa5959f98ee8","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1283,"i":"3d8714fe-bdd5-4a33-873e-40c2262e6863","k":"variable","n":"config","d":"config = lib.mkIf (cfg.enable && slack.enable) {\n  serv.matrix.internal.slackConfigTemplate = configTemplate;\n\n  users.users.mautrix-slack = {\n    isSystemUser = true;\n    group = \"mautrix-slack\";\n    home = \"/var/lib/mautrix-slack\";\n  };\n  users.groups.mautrix-slack = { };\n\n  systemd.services.mautrix-slack = {\n    description = \"mautrix-slack Matrix-Slack puppeting bridge\";\n    wantedBy = [ \"multi-user.target\" ];\n    wants = [ \"network-online.target\" ];\n    after = [\n      \"network-online.target\"\n      \"postgresql.service\"\n      \"matrix-synapse.service\"\n… (truncated)","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1277,"sp":[89,155,3,5],"sh":"7a8b1dd0bed323752d0bccc3b97d49abc8c41524bb6c08a12fcd04f6ae1cb8ca","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1284,"i":"09884539-7a60-4489-9806-6a84156f8e1e","k":"variable","n":"configTemplate","d":"configTemplate = (pkgs.formats.yaml { }).generate \"mautrix-slack-config.yaml\" {\n  homeserver = {\n    address = \"http://127.0.0.1:8008\";\n    domain = cfg.serverName;\n    software = \"standard\";\n  };\n\n  appservice = {\n    address = \"http://127.0.0.1:${toString slack.port}\";\n    hostname = \"127.0.0.1\";\n    port = slack.port;\n    id = slack.appserviceId;\n    bot = {\n      username = slack.botLocalpart;\n      displayname = \"Slack bridge bot\";\n      avatar = \"mxc://maunium.net/pVtzLmChZejGxLqmXtQjFxem\";\n    };\n    ephemeral_events = true;\n    as_token = \"@AS_TOKEN@\";\n… (truncated)","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1277,"sp":[15,86,3,5],"sh":"1a613e146416d9b3b5180a8298ab84a1d422e26f6e5686f29285b4fb68e2cd90","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1285,"i":"4d879154-6e4f-4fef-8a69-2103e622b9e2","k":"variable","n":"database","d":"database = {\n  type = \"postgres\";\n  uri = \"postgres:///mautrix-slack?host=/run/postgresql\";\n};","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1284,"sp":[38,41,5,7],"sh":"573e490f3ba49d8e7fdefd1d1bc5d016c603bc43caf650f2da8e2048f9482b21","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1286,"i":"7ac6f8a1-061d-49eb-979f-a08a4445f564","k":"variable","n":"double_puppet","d":"double_puppet = {\n  # leading @ keeps the value quoted in YAML; an unquoted scalar would be\n  # mis-parsed as a nested mapping\n  secrets = {\n    \"${cfg.serverName}\" = \"@DOUBLE_PUPPET_SECRET@\";\n  };\n  servers = { };\n  allow_discovery = false;\n};","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1284,"sp":[51,59,5,7],"sh":"fd236cabfd96c90cb5fed4f830ce0a3d5eee6f7d631397153f7da2cc1748958e","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1287,"i":"eed6edca-24b9-4b5f-8f97-13cb6fccc69a","k":"variable","n":"encryption","d":"encryption = {\n  allow = cfg.encryption.enable;\n  default = cfg.encryption.enable;\n  require = false;\n  allow_key_sharing = true;\n  pickle_key = \"generate\";\n};","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1284,"sp":[61,67,5,7],"sh":"fe74edae6b3bf16847b498edcd8fd82c1080401148e256586c771a1e0bc2971e","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1288,"i":"ac8e8668-5a3b-420a-9bbe-87260a2f30bd","k":"variable","n":"homeserver","d":"homeserver = {\n  address = \"http://127.0.0.1:8008\";\n  domain = cfg.serverName;\n  software = \"standard\";\n};","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1284,"sp":[16,20,5,7],"sh":"808456b2a1acbdf1622141d408e7adfe8503328588a181267ae398448c26f69d","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1289,"i":"c941f89f-c3ed-4033-b713-62661c64912c","k":"variable","n":"logging","d":"logging = {\n  min_level = \"info\";\n  writers = [\n    {\n      type = \"stdout\";\n      format = \"json\";\n    }\n  ];\n};","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1284,"sp":[77,85,5,7],"sh":"94979a0dc7d2d3eb1de8627b9c3bf0fad1da954c9d988e4a628a194d9ec190fa","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1290,"i":"450b04a2-b758-4293-8975-ca8871d76b09","k":"variable","n":"provisioning.shared_secret","d":"provisioning.shared_secret = \"disable\";","p":"modules/nixos/serv/matrix/mautrix-slack.nix","r":1284,"sp":[75,75,5,44],"sh":"12c29800110b65779bb978890539966a9d60870089233a2310041eebb215a128","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
