{"t":"n","a":910,"i":"ba815f72-8b92-43a1-9bbf-2b57301807bf","k":"variable","n":"theme","d":"theme = {\n  package = pkgs.gruvbox-gtk-theme;\n  name = \"Gruvbox-Dark\";\n};","p":"modules/home-manager/rice.nix","r":895,"sp":[11,14,5,7],"sh":"e1dc0c05eda735ab4167a47df50b4a7f0b78706af238730a0e78eb8c893e09fc","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":911,"i":"eaeeb038-7743-412b-9e56-e8811b5e9698","k":"variable","n":"xdg.configFile","d":"xdg.configFile = lib.mkIf config.desktop.enable {\n  \"Kvantum/gruvbox-kvantum/\".source = \"${inputs.gruvbox-kvantum}/gruvbox-kvantum/\";\n  \"Kvantum/kvantum.kvconfig\".text = \"[General]\\ntheme=gruvbox-kvantum\";\n};","p":"modules/home-manager/rice.nix","r":888,"sp":[20,23,3,5],"sh":"c4d02394cb8b1a086f30bcc5ff26ff8e35a8c9a2e7b7c86daea80fc219461f1b","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":912,"i":"014c6d70-b9e0-4205-9ed3-5af335c2c481","k":"module","n":"Terminal Home Manager Configuration","d":"Provides a Home Manager configuration for the terminal environment, aggregating sub-modules for AI, programming, and TUI support and setting up a suite of terminal‑related programs and services. It enables fastfetch with a custom logo, configures git aliases, activates SSH agent and connection sharing, installs media tools (mpv, yt-dlp, ffmpeg, imagemagick), sets up Zsh with plugins and aliases, and integrates Graphide auto‑update and checkout synchronization, all conditionally based on desktop and media feature flags.","p":"modules/home-manager/term","r":913,"tg":["evidence:source","lang:nix","layer:architecture","source:arch-agent"]}
{"t":"n","a":913,"i":"90dd33c8-cafa-4b35-947d-1a1599d23e03","k":"subsystem","n":"modules/home-manager/term — Terminal environment configuration","d":"Nix modules that set up terminal‑based tools, AI integrations, programming support and TUI applications for the user.","p":"modules/home-manager/term","r":470,"tg":["evidence:signatures","layer:overview","overview:rung:directory","source:overview-agent"]}
{"t":"n","a":914,"i":"d12ea48f-c0f4-4827-bc85-29d01128e553","k":"module","n":"Home Manager AI Integration","d":"Provides Home Manager options and configuration to enable and wire AI tooling. It bundles sub‑modules for aichat, aiclip, Claude code, local AI runtimes, and selected account commands, installing the respective binaries, generating configuration files, and exposing a service that selects the appropriate vendor executable via PATH.","p":"modules/home-manager/term/ai","r":913,"tg":["evidence:source","lang:nix","layer:architecture","source:arch-agent"]}
{"t":"n","a":915,"i":"f593561c-d522-4f8a-b3fb-23c57e701989","k":"file","n":"accounts.nix","d":"A Home Manager module that sets up the graphide-accounts service, creates high‑priority wrapper scripts for the Claude and Codex AI binaries, and installs them (along with the Codex package) into the user’s environment when the service is enabled.","p":"modules/home-manager/term/ai/accounts.nix","r":914,"tg":["description:agent","evidence:source","lang:nix","source:tree-sitter"]}
{"t":"n","a":916,"i":"77b1223e-68f8-4bbf-b10d-0fb982c59a79","k":"variable","n":"cfg","d":"cfg = config.services.graphide-accounts;","p":"modules/home-manager/term/ai/accounts.nix","r":915,"sp":[3,3,3,43],"sh":"0cd9ebcb6c79b719c86e7aa74cec88573bc054c13e243b86d510f9ea4783debd","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":917,"i":"4469d99d-1162-4e0b-8455-8f06c5487967","k":"variable","n":"claudeCommand","d":"claudeCommand = lib.getExe config.ai.claude.package;","p":"modules/home-manager/term/ai/accounts.nix","r":929,"sp":[36,36,5,57],"sh":"fdd82c6d63861380c9383ee9b962c840337c535f753a87276d0b238ed3606571","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
