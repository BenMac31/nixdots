{"t":"n","a":610,"i":"fddf9b77-b1ee-44ae-91ad-62cec7488eed","k":"variable","n":"wayland.windowManager.hyprland.settings.exec-once","d":"wayland.windowManager.hyprland.settings.exec-once = lib.mkIf config.services.hyprpaper.enable [ \"swapwallpaper\" ];","p":"modules/home-manager/desktop/env/wm/hyprpaper.nix","r":603,"sp":[15,15,3,117],"sh":"1c466754cc7ec2b8057fc8b512d41e1f3f99328d05d0dc66b959799dff913dbd","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":611,"i":"c1804fb0-c3e6-4f09-8c1a-378a26e82714","k":"variable","n":"xdg.dataFile","d":"xdg.dataFile = lib.mkIf config.desktop.enable {\n  \"wallpapers\".source = inputs.gruvbox-wallpapers;\n};","p":"modules/home-manager/desktop/env/wm/hyprpaper.nix","r":603,"sp":[3,5,3,5],"sh":"c63035ca83cba27c337ce7d261621c49814ed9185721153e6669afafafda70ea","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":612,"i":"fb243948-2f49-4da2-9dd2-60919a930f9a","k":"file","n":"default.nix","d":"Takes the standard Nix module arguments and defines the Home‑manager module for the Quickshell window manager. It declares an option `services.windowManager.quickshell.enable` to toggle the manager, a `services.windowManager.quickshell.package` sub‑option to override the package used, and a `services.windowManager.quickshell.configFile` sub‑option for the path of a configuration file. When `config.services.windowManager.quickshell.enable` is true, the module installs the selected package, ensures the configuration directory exists, copies or creates the config file, and registers Quickshell as an Xsession window manager in the user’s desktop session. If the option is false or omitted, the module does nothing. Access to `config.services.windowManager.quickshell` follows normal Home‑manager semantics, returning the resolved set of options and applied configuration.","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":596,"tg":["description:agent","lang:nix","source:tree-sitter"]}
{"t":"n","a":613,"i":"d979d067-ca36-4d93-8a0f-17bd5a537dd4","k":"variable","n":"cfg","d":"cfg = config.desktop.graphideShell;","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":612,"sp":[3,3,3,38],"sh":"ca080f484432bce8d3f11696936a0c95bf692d983bf7cddc7ef59599ef15b4e4","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":614,"i":"77f014e0-5884-4fc4-96cd-448d2b22a83b","k":"variable","n":"config","d":"config = lib.mkIf cfg.enable {\n  programs.rbw.settings = {\n    pinentry = lib.mkForce pinentry;\n  };\n  # Runtime dependencies stay in this wrapper's closure, not the user's\n  # profile (notably Python, which already has its own configured environment).\n  home.packages = [ shell pkgs.quickshell pkgs.inter pkgs.jetbrains-mono shared.agent-desktops ];\n  fonts.fontconfig.enable = true;\n  xdg.configFile.\"quickshell/graphide\" = { source = ./shell; recursive = true; };\n  xdg.configFile.\"quickshell/graphide/settings.json\".text = builtins.toJSON {\n… (truncated)","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":612,"sp":[34,74,3,5],"sh":"388d58af82d3e42828bce30a7252c21d2a592360eaf75fd944ad0c82d85ecb3b","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":615,"i":"45a1f87d-7c2b-4d4b-a982-d14c0bb9649b","k":"variable","n":"enable","d":"enable = lib.mkEnableOption \"the Graphide Quickshell desktop\";","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":618,"sp":[22,22,5,67],"sh":"700dd9f08a4fecf5dca789ec968d1b3f471f8834f5785c0487a2f422051dbd08","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":616,"i":"1f68a3e6-e311-47c9-a156-07fd37cd1f60","k":"variable","n":"fonts.fontconfig.enable","d":"fonts.fontconfig.enable = true;","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":614,"sp":[41,41,5,36],"sh":"4654cc766a6c91136c0281eda5e97df24f7a7170d8972fc09732a12c01214e1a","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":617,"i":"b4bc452f-c654-4ade-bc81-954e7d5396fa","k":"variable","n":"home.packages","d":"home.packages = [ shell pkgs.quickshell pkgs.inter pkgs.jetbrains-mono shared.agent-desktops ];","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":614,"sp":[38,40,1,100],"sh":"28de00dd15d30014221ff29906a054357a86880988bb8b253e73eaf024ea90c4","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":618,"i":"6c8b18bb-76ec-4163-b363-c6b48d115c3a","k":"variable","n":"options.desktop.graphideShell","d":"options.desktop.graphideShell = {\n  enable = lib.mkEnableOption \"the Graphide Quickshell desktop\";\n  widgetMonitor = lib.mkOption {\n    type = lib.types.str;\n    default = \"eDP-1\";\n    description = \"Monitor for permanent widgets; falls back to the first connected screen.\";\n  };\n  reserveWidgetSpace = lib.mkOption {\n    type = lib.types.bool;\n    default = false;\n    description = \"Reserve a company sidebar alongside tiled windows.\";\n  };\n};","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":612,"sp":[21,33,3,5],"sh":"1bc212894b99b970c94e553568c9f684ca37e61404c3170432b7396e6e2e9b2c","tg":["description:declaration","lang:nix","nix:option","source:tree-sitter","visibility:public"]}
{"t":"n","a":619,"i":"adf8ad84-0a2a-44dd-a38b-affd060f132f","k":"variable","n":"pinentry","d":"pinentry = pkgs.writeShellScriptBin \"graphide-pinentry\" ''\n  exec ${lib.getExe pkgs.python3} ${./shell/vault.py} pinentry ${pkgs.pinentry-qt}/bin/pinentry \"$@\"\n'';","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":612,"sp":[17,19,3,6],"sh":"0ea5d4e56a54cc24b45c97c552d2f3bbde4555f3d7c1c1ce3b32505a2041db83","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
