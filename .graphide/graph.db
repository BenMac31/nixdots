{"t":"n","a":1317,"i":"e4b97c04-853d-472c-ba53-4bf755f77332","k":"variable","n":"\"org.matrix.msc3575.proxy\".url","d":"\"org.matrix.msc3575.proxy\".url = \"https://${cfg.hostName}\";","p":"modules/nixos/serv/matrix/web.nix","r":1324,"sp":[13,13,5,64],"sh":"2d5e5292c9f5c51ee9fa89df44a3d9aea3870028981ba8c7029a83a5302cb748","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
