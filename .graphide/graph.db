{"t":"n","a":1059,"i":"8766d3ce-6e5d-4b9a-82bc-7554332e027b","k":"variable","n":"initContent","d":"initContent = lib.mkMerge [\n  (lib.mkOrder 550 /*bash*/ ''\n    # Set the root name of the plugins files (.txt and .zsh) antidote will use.\n    zsh_plugins=''${ZDOTDIR:-~}/.zsh_plugins\n\n    # Ensure the .zsh_plugins.txt file exists so you can add plugins.\n    [[ -f ''${zsh_plugins}.txt ]] || touch ''${zsh_plugins}.txt\n\n    # Lazy-load antidote from its functions directory.\n    fpath=(${pkgs.antidote}/share/antidote/functions $fpath)\n    autoload -Uz antidote\n\n    # Generate a new static file whenever .zsh_plugins.txt is updated.\n… (truncated)","p":"modules/home-manager/term/zsh.nix","r":1060,"sp":[56,182,5,7],"sh":"14ef7b5743529b38ab855e31d8964ddb58290e52c9d7a057cfc2f67ec67cbc58","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1060,"i":"ae0de64b-0cff-454e-b2da-ffb2db1c3e04","k":"variable","n":"programs.zsh","d":"programs.zsh = {\n  completionInit = \"\";\n  enable = true;\n  history = {\n    extended = true;\n    ignoreAllDups = true;\n    ignoreSpace = true;\n    path = \"$HOME/.local/share/zsh/history\";\n  };\n  enableCompletion = false;\n  defaultKeymap = \"viins\";\n  shellAliases = lib.mkMerge [\n    (lib.mkIf config.desktop.enable {\n      nixswitch = \"st=\\\"$(date +%s)\\\"; sudo nixos-rebuild switch --flake $HOME/nixos/#${flakeAttr} --cores 6 && notify-send 'updated' \\\"Took: $(($(date +%s)-$st))s\\\"\";\n… (truncated)","p":"modules/home-manager/term/zsh.nix","r":1052,"sp":[10,183,3,5],"sh":"6dc16dc671e204a1b19826e7df2864fcde5693d75d47f093c7c61455783452db","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1061,"i":"2765e69b-0836-4af9-b54b-cb33d8a0c398","k":"variable","n":"shellAliases","d":"shellAliases = lib.mkMerge [\n  (lib.mkIf config.desktop.enable {\n    nixswitch = \"st=\\\"$(date +%s)\\\"; sudo nixos-rebuild switch --flake $HOME/nixos/#${flakeAttr} --cores 6 && notify-send 'updated' \\\"Took: $(($(date +%s)-$st))s\\\"\";\n    homeswitch = \"st=\\\"$(date +%s)\\\"; home-manager switch --flake $HOME/nixos/#${flakeAttr} --cores 6 && notify-send 'updated' \\\"Took: $(($(date +%s)-$st))s\\\"\";\n    nixtest = \"st=\\\"$(date +%s)\\\"; sudo nixos-rebuild test --fast --flake $HOME/nixos/#${flakeAttr} --cores 6 && notify-send 'updated' \\\"Took: $(($(date +%s)-$st))s\\\"\";\n  })\n… (truncated)","p":"modules/home-manager/term/zsh.nix","r":1060,"sp":[25,55,5,7],"sh":"b76ec9040f5dca59944a1146799bb262e5e08b5048a6a5601c3a5692713e6a22","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1062,"i":"9003497a-cfc8-4e8c-83ad-e713b155ca64","k":"module","n":"Verdigris Ink Theme Configuration","d":"Provides the Verdigris Ink desktop theme for home-manager, exposing an enable option (desktop.verdigris.enable) and, when enabled, generates GTK CSS, Qt color definitions, GNOME dconf interface settings, LibreWolf userChrome tweaks, and related configuration files based on the project's color palette, merging them into the user's desktop environment.","p":"modules/home-manager/themes","r":470,"tg":["evidence:source","lang:nix","layer:architecture","source:arch-agent","source:tree-sitter"]}
{"t":"n","a":1063,"i":"ca292021-a09f-498d-bf06-f9e88ff9ba2c","k":"file","n":"verdigris-ink.nix","d":"This Nix file defines the Verdigris‑ink theme for Home Manager, exporting a Nix attribute set named \"verdigris-ink\" that contains color definitions (background, foreground, accents, etc.) used by Home Manager to style its components.","p":"modules/home-manager/themes/verdigris-ink.nix","r":1062,"tg":["description:agent","lang:nix","source:tree-sitter"]}
{"t":"n","a":1064,"i":"ee344669-4eff-42ed-bab9-a227757a69c3","k":"variable","n":"cfg","d":"cfg = config.desktop.verdigris;","p":"modules/home-manager/themes/verdigris-ink.nix","r":1063,"sp":[3,3,3,34],"sh":"1bb26b882c56cee04d5891bc403cb8037dc66d067e05cb9987711cd12bec2bdf","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
