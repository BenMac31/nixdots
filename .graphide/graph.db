{"t":"n","a":748,"i":"6522429e-d179-4cc3-a00d-b2738142e7d1","k":"file","n":"xdg.nix","d":"Home Manager module that configures XDG support and portal integration for the user's desktop environment, exposing a config attribute that sets systemd user environment variables and enables XDG portals, and a flag detecting GNOME enablement.","p":"modules/home-manager/desktop/env/xdg.nix","r":565,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":749,"i":"0cb80236-c787-4c9b-85bb-3bb27b0a85e8","k":"variable","n":"config","d":"config = lib.mkIf config.desktop.enable {\n  systemd.user.settings.Manager.DefaultEnvironment = {\n    PATH = \"/run/wrappers/bin:/etc/profiles/per-user/%u/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin\";\n  };\n  xdg = {\n    enable = true;\n    portal = {\n      enable = true;\n      xdgOpenUsePortal = true;\n      configPackages = with pkgs; [\n        (lib.mkIf gnomeEnabled gnome-session)\n      ];\n      extraPortals = with pkgs; [\n        (lib.mkIf gnomeEnabled xdg-desktop-portal-gtk)\n        (lib.mkIf osConfig.programs.hyprland.enable xdg-desktop-portal-hyprland)\n… (truncated)","p":"modules/home-manager/desktop/env/xdg.nix","r":748,"sp":[8,32,3,5],"sh":"79f415defbc12ce071407d343f4605c32397353777171836537ddb61d0900a75","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":750,"i":"14453595-1f01-40dc-af60-ae065b39f3da","k":"variable","n":"gnomeEnabled","d":"gnomeEnabled =\nlib.attrByPath [ \"services\" \"desktopManager\" \"gnome\" \"enable\" ] false osConfig;","p":"modules/home-manager/desktop/env/xdg.nix","r":748,"sp":[4,5,3,84],"sh":"2de219bfa29188d9feb26a6dfca88d320c99524d04485c2e3b839d0168ce996e","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":751,"i":"ffc5a186-f0de-4115-a499-26db55f850b9","k":"variable","n":"systemd.user.settings.Manager.DefaultEnvironment","d":"systemd.user.settings.Manager.DefaultEnvironment = {\n  PATH = \"/run/wrappers/bin:/etc/profiles/per-user/%u/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin\";\n};","p":"modules/home-manager/desktop/env/xdg.nix","r":749,"sp":[9,11,5,7],"sh":"aa0f24cf86c96f21fbfe113cc05d31b7b2b513a216e7db7e9fca807bcbb2bf50","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":752,"i":"63fa1405-ecd2-431c-916a-0bc6e47dc1f2","k":"variable","n":"xdg","d":"xdg = {\n  enable = true;\n  portal = {\n    enable = true;\n    xdgOpenUsePortal = true;\n    configPackages = with pkgs; [\n      (lib.mkIf gnomeEnabled gnome-session)\n    ];\n    extraPortals = with pkgs; [\n      (lib.mkIf gnomeEnabled xdg-desktop-portal-gtk)\n      (lib.mkIf osConfig.programs.hyprland.enable xdg-desktop-portal-hyprland)\n    ];\n  };\n  mime.enable = true;\n  mimeApps.enable = true;\n  userDirs = {\n    enable = true;\n    createDirectories = true;\n  };\n};","p":"modules/home-manager/desktop/env/xdg.nix","r":749,"sp":[12,31,5,7],"sh":"c2ab50fd17e6a733a4fea4facd06f2209dc5eb988410b86f01baee839d8bc5fc","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":753,"i":"fc4066a2-e730-48fc-9db8-1fdb06bfbe6d","k":"file","n":"gaming.nix","d":"Home Manager desktop gaming module that, when enabled via options.desktop.gaming.enable, installs gaming packages such as r2modman and a custom Steam wrapper, configures Flatpak gaming applications, and exposes the ydotoold executable path for other components.","p":"modules/home-manager/desktop/gaming.nix","r":475,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":754,"i":"b0619c36-6338-4c91-950f-e1c57a93e6e9","k":"variable","n":"config","d":"config = lib.mkIf config.desktop.gaming.enable {\n  home.packages = with pkgs; [\n    pkgs.r2modman\n    (pkgs.writeShellScriptBin \"steam\" ''\n      ${pkgs.flatpak}/bin/flatpak run com.valvesoftware.Steam -silent \"$@\"\n    '')\n  ];\n  services.flatpak = {\n    packages = [\n      \"com.valvesoftware.Steam\"\n      \"net.lutris.Lutris\"\n      \"org.prismlauncher.PrismLauncher\"\n      \"net.veloren.airshipper\"\n    ];\n    overrides = {\n      \"org.prismlauncher.PrismLauncher\" = {\n        Context = {\n          filesystems = [\n            \"xdg-data/applications:create\"\n          ];\n        };\n… (truncated)","p":"modules/home-manager/desktop/gaming.nix","r":753,"sp":[7,54,3,5],"sh":"50648ba48a843032f158691f18d963692b8230c4dcd750b52c79979ec17e50c0","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":755,"i":"ced6c0c7-b658-4358-96de-c28df5f06b1f","k":"variable","n":"home.packages","d":"home.packages = with pkgs; [\n  pkgs.r2modman\n  (pkgs.writeShellScriptBin \"steam\" ''\n    ${pkgs.flatpak}/bin/flatpak run com.valvesoftware.Steam -silent \"$@\"\n  '')\n];","p":"modules/home-manager/desktop/gaming.nix","r":754,"sp":[8,13,5,7],"sh":"5c45034fda3a44d8c3d9c5a0925362d00d37ff55cc1260a63f7d381cb083dd58","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":756,"i":"977a39ad-1007-4ae5-8460-0ea9304c8afc","k":"variable","n":"options.desktop.gaming.enable","d":"options.desktop.gaming.enable = lib.mkEnableOption \"Enable gaming\";","p":"modules/home-manager/desktop/gaming.nix","r":753,"sp":[6,6,3,70],"sh":"fe9de731f4c56b38dffb260382a0cfcc4ffd7309f0f43a30bad18cae3023b0bb","tg":["arch:auto-attached","description:declaration","lang:nix","nix:option","source:tree-sitter","visibility:public"]}
{"t":"n","a":757,"i":"596a2d0a-b3be-4c81-adfe-10bb85eaaf5e","k":"variable","n":"programs.zsh.shellAliases.stardewmacro","d":"programs.zsh.shellAliases.stardewmacro = lib.mkIf osConfig.programs.hyprland.enable \"hyprctl keyword bind ',mouse:276,exec,env YDOTOOL_SOCKET=/run/user/1000/.$ ydotool key 54:1 111:1 19:1 19:0 54:0 111:0' && ${ydotoold}\";","p":"modules/home-manager/desktop/gaming.nix","r":754,"sp":[53,53,5,226],"sh":"9b909bf4b50062acc8e7b1f409450ce31f7c69fda38f14349341ce0f75dbf48d","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":758,"i":"4cc99405-f216-4523-a8cd-54588de19323","k":"variable","n":"services.flatpak","d":"services.flatpak = {\n  packages = [\n    \"com.valvesoftware.Steam\"\n    \"net.lutris.Lutris\"\n    \"org.prismlauncher.PrismLauncher\"\n    \"net.veloren.airshipper\"\n  ];\n  overrides = {\n    \"org.prismlauncher.PrismLauncher\" = {\n      Context = {\n        filesystems = [\n          \"xdg-data/applications:create\"\n        ];\n      };\n    };\n    \"com.valvesoftware.Steam\" = {\n      Context = {\n        filesystems = [\n          \"xdg-config/r2modmanPlus-local:rw\"\n          \"xdg-data/icons:create\"\n          \"xdg-data/applications:create\"\n        ];\n        device = [\n          \"dri\"\n        ];\n… (truncated)","p":"modules/home-manager/desktop/gaming.nix","r":754,"sp":[14,52,5,7],"sh":"d837ab54f8974c6b80ff1cb4c5a1be4fe3acfbb761f785027ae3048d72be8025","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
