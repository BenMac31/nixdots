{"t":"n","a":501,"i":"585777d9-f5c3-4d75-a214-57a413fc5f97","k":"variable","n":"programs.librewolf","d":"programs.librewolf = {\n  package = pkgs.librewolf.override {\n    cfg = {\n      enableGnomeExtensions = true;\n    };\n    nativeMessagingHosts = [\n      pkgs.tridactyl-native\n    ];\n  };\n  policies = {\n    DisableTelemetry = true;\n    DisableFirefoxStudies = true;\n    DontCheckDefaultBrowser = true;\n    DisablePocket = true;\n    SearchBar = \"unified\";\n    # Librewolf clears cookies on shutdown; sites with an explicit \"allow\"\n    # cookie permission are skipped by the shutdown sanitizer.\n    Cookies = {\n      Allow = [\n        \"https://claude.ai\"\n        \"https://anthropic.com\"\n… (truncated)","p":"modules/home-manager/desktop/apps/firefox.nix","r":495,"sp":[35,188,5,7],"sh":"0d234f20266d6ef86c83b137305779140c9dbf9498f6d46e879744fa61edd2ca","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":502,"i":"4e8622cc-76df-4cf3-84d7-57655c2f966f","k":"variable","n":"xdg.configFile.\"tridactyl/tridactylrc\".text","d":"xdg.configFile.\"tridactyl/tridactylrc\".text = /*vim*/ ''\n        \" Comment toggler for Reddit, Hacker News and Lobste.rs\n        bind ;c hint -Jc [class*=\"expand\"],[class*=\"togg\"],[class=\"comment_folder\"]\n\n        bind d composite tabprev; tabclose #\n        bind D tabclose\n        \" Make gu take you back to subreddit from comments\n        bindurl reddit.com gu urlparent 4\n\n        \" Only hint search results on Google and DDG\n        bindurl www.google.com f hint -Jc #search a\n        bindurl www.google.com F hint -Jbc #search a\n\n        \" Handy multiwindow/multitasking binds\n… (truncated)","p":"modules/home-manager/desktop/apps/firefox.nix","r":495,"sp":[189,236,5,8],"sh":"101709742d51551f221fbdf6c34f8442eaf2cf008de3022dd5965749a4dd39d9","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":503,"i":"8daa7d72-55ab-4127-99ce-23d689cd1422","k":"variable","n":"xdg.mimeApps.defaultApplications","d":"xdg.mimeApps.defaultApplications = {\n  \"text/html\" = \"librewolf.desktop\";\n  \"x-scheme-handler/http\" = \"librewolf.desktop\";\n  \"x-scheme-handler/https\" = \"librewolf.desktop\";\n  \"x-scheme-handler/about\" = \"librewolf.desktop\";\n  \"x-scheme-handler/unknown\" = \"librewolf.desktop\";\n};","p":"modules/home-manager/desktop/apps/firefox.nix","r":495,"sp":[24,30,5,7],"sh":"24c07f598a488577efc03765553af0cb05dd1f18c378b7c05c10faea3ff03f62","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":504,"i":"1b540557-4df0-41f4-bd4f-9c696b442047","k":"file","n":"foot.nix","d":"Home Manager module that defines the programs.foot attribute, configuring the foot terminal emulator (enabling its server and providing default font, DPI-aware settings, and color palette integration) for inclusion in the user's Home Manager configuration.","p":"modules/home-manager/desktop/apps/foot.nix","r":482,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":505,"i":"83941491-9ea0-470d-8c1e-751757fd4f5d","k":"variable","n":"programs.foot","d":"programs.foot = {\n  server.enable = true;\n  settings = {\n    main = {\n      font = \"FiraCodeNerdFont-Regular:size=10\";\n      dpi-aware = true;\n    };\n    colors = with config.colorScheme.palette; {\n      regular0 = \"${base00}\";\n      regular1 = \"${base08}\";\n      regular2 = \"${base09}\";\n      regular3 = \"${base0A}\";\n      regular4 = \"${base0B}\";\n      regular5 = \"${base0C}\";\n      regular6 = \"${base0D}\";\n      regular7 = \"${base0E}\";\n      bright0 = \"${base03}\";\n      bright1 = \"${base08}\";\n      bright2 = \"${base09}\";\n      bright3 = \"${base0A}\";\n      bright4 = \"${base0B}\";\n… (truncated)","p":"modules/home-manager/desktop/apps/foot.nix","r":504,"sp":[3,34,3,5],"sh":"d9e8020df699efe0ee4b03f879709dc376ba8794bab2c0ea51e6c973413bb706","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":506,"i":"19e4855a-134d-4ff7-87aa-ab6fd00d27be","k":"variable","n":"server.enable","d":"server.enable = true;","p":"modules/home-manager/desktop/apps/foot.nix","r":505,"sp":[4,4,5,26],"sh":"4fba979a98e22eafe9d4cc1dab6a1f6eaa606bf95871e6f067f44dd81d86830c","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":507,"i":"999011eb-d940-4bc0-bb01-1b661b0f0416","k":"variable","n":"settings","d":"settings = {\n  main = {\n    font = \"FiraCodeNerdFont-Regular:size=10\";\n    dpi-aware = true;\n  };\n  colors = with config.colorScheme.palette; {\n    regular0 = \"${base00}\";\n    regular1 = \"${base08}\";\n    regular2 = \"${base09}\";\n    regular3 = \"${base0A}\";\n    regular4 = \"${base0B}\";\n    regular5 = \"${base0C}\";\n    regular6 = \"${base0D}\";\n    regular7 = \"${base0E}\";\n    bright0 = \"${base03}\";\n    bright1 = \"${base08}\";\n    bright2 = \"${base09}\";\n    bright3 = \"${base0A}\";\n    bright4 = \"${base0B}\";\n    bright5 = \"${base0C}\";\n    bright6 = \"${base0D}\";\n    bright7 = \"${base0E}\";\n… (truncated)","p":"modules/home-manager/desktop/apps/foot.nix","r":505,"sp":[5,33,5,7],"sh":"0628605ee57be32d9f264db4a8745fcb50bce87fe111e7270e07f562240b498f","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":508,"i":"9b0bb40a-3c3f-4630-a2ea-001acdc53453","k":"file","n":"kitty.nix","d":"Home Manager module configuring the Kitty terminal emulator: sets it as the default TERMINAL and supplies customized Kitty settings (fonts, colors, and other options) drawn from the user’s color scheme.","p":"modules/home-manager/desktop/apps/kitty.nix","r":482,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":509,"i":"d77936b9-caf4-4caf-adaf-015fd5c6b1e6","k":"variable","n":"TERMINAL","d":"TERMINAL = \"kitty\";","p":"modules/home-manager/desktop/apps/kitty.nix","r":510,"sp":[3,3,67,86],"sh":"a88071392f2919fb8e358cf7bf515318b6a2811b60cbb686d5148cefd88805c0","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":510,"i":"a74449c0-7151-4752-8361-94de1db64ca9","k":"variable","n":"home.sessionVariables","d":"home.sessionVariables = lib.mkIf config.programs.kitty.enable { TERMINAL = \"kitty\"; };","p":"modules/home-manager/desktop/apps/kitty.nix","r":508,"sp":[3,3,3,89],"sh":"a88071392f2919fb8e358cf7bf515318b6a2811b60cbb686d5148cefd88805c0","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":511,"i":"81cf9485-a579-4a23-8df4-c81ebd67ca89","k":"variable","n":"programs.kitty","d":"programs.kitty = {\n  settings = with config.colorScheme.palette; {\n    font_family = \"FiraCodeNerdFont-Regular\";\n    enable_audio_bell = true;\n    font_size = 10;\n    color0 = \"#${base00}\";\n    color1 = \"#${base08}\";\n    color2 = \"#${base09}\";\n    color3 = \"#${base0A}\";\n    color4 = \"#${base0B}\";\n    color5 = \"#${base0C}\";\n    color6 = \"#${base0D}\";\n    color7 = \"#${base0E}\";\n    color8 = \"#${base03}\";\n    color9 = \"#${base08}\";\n    color10 = \"#${base09}\";\n    color11 = \"#${base0A}\";\n    color12 = \"#${base0B}\";\n    color13 = \"#${base0C}\";\n    color14 = \"#${base0D}\";\n… (truncated)","p":"modules/home-manager/desktop/apps/kitty.nix","r":508,"sp":[4,29,3,5],"sh":"b166e2cb605575c1b01fa8770a74bb3dbb6629c57ba2ac733247363ecc557e7a","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":512,"i":"950f52ae-892a-4a5a-a682-8e7d305b6402","k":"variable","n":"settings","d":"settings = with config.colorScheme.palette; {\n  font_family = \"FiraCodeNerdFont-Regular\";\n  enable_audio_bell = true;\n  font_size = 10;\n  color0 = \"#${base00}\";\n  color1 = \"#${base08}\";\n  color2 = \"#${base09}\";\n  color3 = \"#${base0A}\";\n  color4 = \"#${base0B}\";\n  color5 = \"#${base0C}\";\n  color6 = \"#${base0D}\";\n  color7 = \"#${base0E}\";\n  color8 = \"#${base03}\";\n  color9 = \"#${base08}\";\n  color10 = \"#${base09}\";\n  color11 = \"#${base0A}\";\n  color12 = \"#${base0B}\";\n  color13 = \"#${base0C}\";\n  color14 = \"#${base0D}\";\n  color15 = \"#${base0E}\";\n  # alpha = 0.8;\n… (truncated)","p":"modules/home-manager/desktop/apps/kitty.nix","r":511,"sp":[5,28,5,7],"sh":"c1f9dc4266b937a5a0410f32df9df4de8dd07770611a446960a5662b0197c94d","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":513,"i":"66a17f01-7f82-49cd-8de5-6b7c0651443d","k":"file","n":"mpv.nix","d":"Home-manager module that supplies mpv configuration, installing a speed‑breakpoints Lua script and applying sensible default settings when programs.mpv.enable is true.","p":"modules/home-manager/desktop/apps/mpv.nix","r":482,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":514,"i":"19c9f8be-dc4f-420d-b60a-84efed0980d6","k":"variable","n":"config","d":"config = lib.mkIf config.programs.mpv.enable {\n  xdg.configFile.\"mpv/scripts/speed-breakpoints.lua\".source =\n    ./mpv-scripts/speed-breakpoints.lua;\n\n  programs.mpv.config = {\n    # Software-only decode can't keep up with the large speed swings\n    # speed-breakpoints.lua produces (e.g. 45x+ on 1080p h264), causing\n    # dropped frames and A/V desync that make applied speed changes look\n    # like they didn't take effect. mpv's own desync warning suggests\n    # this exact fix.\n    hwdec = \"auto-safe\";\n  };\n\n  # programs.mpv = {\n  #   scripts = with pkgs.mpvScripts; [\n… (truncated)","p":"modules/home-manager/desktop/apps/mpv.nix","r":513,"sp":[3,56,3,5],"sh":"2b234f137cc48475002051a3164e76bb0e58aadc6ca5d531255c433609ca999d","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":515,"i":"1770ccc5-fa65-4aab-8441-562f2f854b5f","k":"variable","n":"programs.mpv.config","d":"programs.mpv.config = {\n  # Software-only decode can't keep up with the large speed swings\n  # speed-breakpoints.lua produces (e.g. 45x+ on 1080p h264), causing\n  # dropped frames and A/V desync that make applied speed changes look\n  # like they didn't take effect. mpv's own desync warning suggests\n  # this exact fix.\n  hwdec = \"auto-safe\";\n};","p":"modules/home-manager/desktop/apps/mpv.nix","r":514,"sp":[7,14,5,7],"sh":"2f6efac72639cdaff6c94d059e8c3dbd3266edb2f11175e77a35e508884f24c5","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":516,"i":"0099d15b-69e0-43e4-921f-6ed8503514c9","k":"variable","n":"xdg.configFile.\"mpv/scripts/speed-breakpoints.lua\".source","d":"xdg.configFile.\"mpv/scripts/speed-breakpoints.lua\".source =\n./mpv-scripts/speed-breakpoints.lua;","p":"modules/home-manager/desktop/apps/mpv.nix","r":514,"sp":[4,5,5,43],"sh":"3e23bba298c9dfb70bebc5a6f661de8d6a45f4188914571e0e82cfd93d7caffd","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
