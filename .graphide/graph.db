{"t":"n","a":959,"i":"e293077a-9fb2-4824-afce-25908f3a3318","k":"file","n":"default.nix","d":"Home Manager terminal module that provides the default configuration for terminal utilities, packages, and programs, and aggregates related sub-modules (programming, tui, ai, git, yc, media, zsh, ssh).","p":"modules/home-manager/term/default.nix","r":912,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":960,"i":"64eb87f1-a1a4-4c26-99f0-2dc6b9d5a76c","k":"variable","n":"config","d":"config = {\n  tui.enable = lib.mkDefault true;\n  home.packages = with pkgs; [\n    (lib.mkIf config.desktop.enable brightnessctl)\n    (lib.mkIf config.desktop.enable wl-clipboard)\n    fastfetch\n    libnotify\n    jq\n    yt-dlp\n  ];\n  programs = {\n    gpg.enable = true;\n    ssh.enable = lib.mkDefault true;\n    direnv = {\n      enable = true;\n      nix-direnv.enable = true;\n      enableBashIntegration = true;\n      enableZshIntegration = true;\n      enableFishIntegration = true;\n    };\n  };\n};","p":"modules/home-manager/term/default.nix","r":959,"sp":[13,34,3,5],"sh":"ccbe07cd8cdf66b313421ee157d1748fcb8bdf8d685a8771a1bef2ec3b7e8e8d","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":961,"i":"777e5664-e5f3-4914-8688-f733e3db4eb9","k":"variable","n":"home.packages","d":"home.packages = with pkgs; [\n  (lib.mkIf config.desktop.enable brightnessctl)\n  (lib.mkIf config.desktop.enable wl-clipboard)\n  fastfetch\n  libnotify\n  jq\n  yt-dlp\n];","p":"modules/home-manager/term/default.nix","r":960,"sp":[15,21,5,7],"sh":"6a3053bd0c19c453cf653038df3769a4808f7d3584ece0513763c39d8c3add00","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
