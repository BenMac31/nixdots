{"t":"n","a":789,"i":"74d69398-d541-431c-a2a8-ce140b7f0359","k":"variable","n":"options.desktop.japanese","d":"options.desktop.japanese = {\n  enable = lib.mkEnableOption \"Enable Japanese\";\n  input.enable = lib.mkEnableOption \"Enable japanese input\";\n};","p":"modules/home-manager/desktop/japanese.nix","r":781,"sp":[3,6,3,5],"sh":"5973f1b8eece0c52d7087eedcdcc913b54b92f8a14836eaad8a155fbf5a39459","tg":["arch:auto-attached","description:declaration","lang:nix","nix:option","source:tree-sitter","visibility:public"]}
