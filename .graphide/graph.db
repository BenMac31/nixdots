{"t":"n","a":794,"i":"14f003b1-2020-4a0d-9417-5af5a1898245","k":"variable","n":"programs.ncmpcpp","d":"programs.ncmpcpp = {\n  enable = true;\n  bindings = [\n    { key = \"h\"; command = \"previous_column\"; }\n    { key = \"j\"; command = \"scroll_down\"; }\n    { key = \"k\"; command = \"scroll_up\"; }\n    { key = \"l\"; command = \"next_column\"; }\n    { key = \"J\"; command = [ \"select_item\" \"scroll_down\" ]; }\n    { key = \"K\"; command = [ \"select_item\" \"scroll_up\" ]; }\n    { key = \".\"; command = [ \"show_lyrics\" ]; }\n    { key = \"n\"; command = [ \"next_found_item\" ]; }\n    { key = \"N\"; command = [ \"previous_found_item\" ]; }\n    { key = \"ctrl-u\"; command = [ \"page_up\" ]; }\n… (truncated)","p":"modules/home-manager/desktop/media.nix","r":792,"sp":[21,36,5,7],"sh":"93823407c42fe66cb4818d31e0a4875f69a0ea9b3bd1be348d01e0a73b9c4824","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
