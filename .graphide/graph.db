{"t":"n","a":498,"i":"99656b4e-e8a7-47dd-bdec-7957152b4852","k":"variable","n":"lock-empty-string","d":"lock-empty-string = {\n  Value = \"\";\n  Status = \"locked\";\n};","p":"modules/home-manager/desktop/apps/firefox.nix","r":488,"sp":[12,15,3,5],"sh":"5b832867628da95bc360803ccc8f27be2c1d7d99a70fba893bb8da383affd053","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
