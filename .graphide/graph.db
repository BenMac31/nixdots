{"t":"n","a":863,"i":"71840a30-ff6c-4391-8cf3-b02f299fbd6c","k":"variable","n":"themePatcher","d":"themePatcher = pkgs.writeText \"proton-mail-theme-patch.py\" ''\n  import sys, json\n  import asar\n\n  CSS = ${builtins.toJSON css}\n\n  # Proton Mail's UI is served from *.proton.me, so the palette is injected\n  # as user-origin CSS into those pages on every load.\n  INJECT = (\n      \"(()=>{const css=\" + json.dumps(CSS) + \";\"\n      \"require(\\\"electron\\\").app.on(\\\"web-contents-created\\\",(_,wc)=>{\"\n      \"wc.on(\\\"dom-ready\\\",()=>{let host=\\\"\\\";\"\n      \"try{host=new URL(wc.getURL()).hostname}catch{}\"\n      \"if(host===\\\"proton.me\\\"||host.endsWith(\\\".proton.me\\\"))\"\n… (truncated)","p":"modules/home-manager/desktop/proton-mail.nix","r":803,"sp":[76,101,3,6],"sh":"d19b565f3950624fea284455bf9ccb9c0370ee926e3236fb87323feeadffaf3e","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":864,"i":"b587584b-0206-464c-8949-677cd2b13aa8","k":"variable","n":"themedProtonMail","d":"themedProtonMail = pkgs.protonmail-desktop.overrideAttrs (old: {\n  nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [ pkgs.python3 ];\n  postInstall = (old.postInstall or \"\") + ''\n    echo \"Applying system palette to Proton Mail ASAR...\"\n    PYTHONPATH=${asarLib} python3 ${themePatcher} $out/share/proton-mail/app.asar\n  '';\n});","p":"modules/home-manager/desktop/proton-mail.nix","r":803,"sp":[103,109,3,6],"sh":"a926bc4fc6670fa07595dec04eeac62a4ae52b6099851db7e6abf20b98301bfd","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":865,"i":"2d6eef68-bd35-42aa-8c36-72ebf83f33e2","k":"variable","n":"tokens","d":"tokens = scale \"primary\" accent p.base00\n// scale \"interaction-norm\" accent p.base00\n// scale \"signal-danger\" p.base08 p.base00\n// scale \"signal-warning\" p.base0A p.base00\n// scale \"signal-success\" p.base0B p.base00\n// scale \"signal-info\" p.base0C p.base00\n// {\n  \"interaction-weak-minor-2\" = \"#${p.base00}\";\n  \"interaction-weak-minor-1\" = \"#${p.base01}\";\n  interaction-weak = \"#${p.base02}\";\n  \"interaction-weak-major-1\" = mix p.base02 p.base03 50;\n  \"interaction-weak-major-2\" = \"#${p.base03}\";\n  \"interaction-weak-major-3\" = mix p.base03 p.base04 50;\n… (truncated)","p":"modules/home-manager/desktop/proton-mail.nix","r":803,"sp":[21,68,3,7],"sh":"811d0f8c795928ca5721e471e0f66fb71e5b42d70639b0da25da01ddb0e94d93","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":866,"i":"460e5140-cbef-4663-9a14-bd3f07814461","k":"file","n":"signal.nix","d":"Adds a Home Manager option to enable Signal Desktop with a Gruvbox theme, building a wrapped Signal package that applies custom flags and patches the ASAR file, and exposing the resulting themed binary via home.packages.","p":"modules/home-manager/desktop/signal.nix","r":475,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":867,"i":"e9f57013-37ed-46e1-a2a9-7748ccfe7f41","k":"variable","n":"accent","d":"accent = if config.desktop.verdigris.enable then p.base0C else p.base0D;","p":"modules/home-manager/desktop/signal.nix","r":866,"sp":[4,4,3,75],"sh":"a3ce47afc44d0e13b6c9b92bddb9da1f5634cf8d4cfa44551faa45b679424f0f","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":868,"i":"2df1dd48-ee9b-4ee4-a39a-054ba705d9d9","k":"variable","n":"asarLib","d":"asarLib = pkgs.writeTextDir \"asar.py\" (builtins.readFile ./asar.py);","p":"modules/home-manager/desktop/signal.nix","r":866,"sp":[5,5,3,71],"sh":"45cc1e354a3db1981bce164477d693211203284309dee9190838efa29626a251","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":869,"i":"5ec7f6d6-e6fa-441a-bde9-f4d507040f1e","k":"variable","n":"config","d":"config = lib.mkIf config.signal.enable {\n  home.packages = [\n    (pkgs.symlinkJoin {\n      name = \"signal-desktop\";\n      paths = [ themedSignal ];\n      buildInputs = [ pkgs.makeWrapper ];\n      postBuild = ''\n        wrapProgram $out/bin/signal-desktop --add-flags \"${flags}\"\n      '';\n    })\n  ];\n};","p":"modules/home-manager/desktop/signal.nix","r":866,"sp":[241,252,3,5],"sh":"0d7deedeca307776e44f96a09213fcd822486670a1b9e44bbcf93c1862d20579","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":870,"i":"e0306d87-5940-444e-bc74-5c8fdefa7603","k":"variable","n":"flags","d":"flags = lib.concatStringsSep \" \" (\n  [ \"--hide-menu-bar\" ]\n  ++ lib.optional config.desktop.japanese.input.enable \"--enable-wayland-ime=true\"\n);","p":"modules/home-manager/desktop/signal.nix","r":866,"sp":[233,236,3,5],"sh":"94220b371522f3fe15d3e288bee6d0bcd2e97c30a8acd0b043d7357f0a251dd3","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
