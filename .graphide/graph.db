{"t":"n","a":542,"i":"c5989e42-4e6e-4664-8f36-e7da8d52988d","k":"file","n":"asar.py","d":"Provides utilities to rewrite an ASAR archive in place: extracts packed file bytes, allows a caller‑supplied transform to modify them, then recomputes header offsets, sizes and SHA‑256 integrity blocks before writing the updated archive back.","p":"modules/home-manager/desktop/asar.py","r":475,"tg":["description:agent","evidence:source","lang:python","source:tree-sitter"]}
{"t":"n","a":543,"i":"170122dc-f7ab-488b-8672-f6ab55f5844e","k":"function","n":"collect","d":"Takes a node dict that either contains a \"files\" mapping of child nodes or an \"offset\" leaf entry, and an optional path string (default empty). Returns a dictionary mapping each leaf’s full path—constructed by joining names with '/' (no leading slash)—to the leaf node dict; empty dict is returned when the node has neither \"files\" nor \"offset\".","p":"modules/home-manager/desktop/asar.py","r":544,"sg":"def collect(node, path=\"\"):","lt":"[\"files\",\"{path}/{name}\",\"offset\"]","sp":[21,28,5,19],"sh":"fb89c6dbaa720a3c40bc997180d81061412bcb7c100a7576ccb1e5e4bd4b1c68","tg":["description:agent","evidence:source","lang:python","source:tree-sitter","visibility:public"]}
{"t":"n","a":544,"i":"dcf80c38-ba4e-4870-89c0-b58ef800ff07","k":"function","n":"patch","d":"Rewrite an ASAR in place. `transform` gets a {path: bytes} dict of the packed files and mutates it; offsets, sizes and integrity are recomputed.","p":"modules/home-manager/desktop/asar.py","r":542,"sg":"def patch(asar, transform):","lt":"[\"rb\",\"\\u003cI\",\"files\",\"{path}/{name}\",\"offset\",\"size\",\"integrity\",\"blockSize\"]","sp":[11,71,1,26],"sh":"9f739a0b901ae64b52ba7c7a023d477f0cbb051107f25574e4bcd2c095753afc","tg":["arch:auto-attached","description:docstring","lang:python","source:tree-sitter","visibility:public"]}
{"t":"n","a":545,"i":"b7cb9131-545a-4426-ac7d-7df68aa62f55","k":"function","n":"sha256_blocks","p":"modules/home-manager/desktop/asar.py","r":542,"sg":"def sha256_blocks(data, block_size):","sp":[4,8,1,6],"tg":["arch:auto-attached","description:stub","lang:python","source:tree-sitter","visibility:public"]}
{"t":"n","a":546,"i":"c6d8937f-2fc4-44b8-b3f1-2e3d00797527","k":"function","n":"update","d":"Takes a node dictionary and an optional path string (default empty). Recursively walks the node: if the node has a \"files\" key, calls itself for each child with the child’s path appended; otherwise, if the node has an \"offset\" key, looks up the file data for the current path in the external mapping `file_data`, sets the node’s \"offset\" to the current cumulative byte offset (converted to string), sets its \"size\" to the length of that data, and if the node contains an \"integrity\" key, replaces it with a dictionary containing \"algorithm\": \"SHA256\", the hex SHA256 hash of the data, a \"blockSize\" (taken from the original integrity entry or default 4194304), and a list of block hashes computed by `sha256_blocks(data, blockSize)`. After processing the leaf, increments the outer `offset` by the data length and appends the data to the external list `file_list`. Returns None.","p":"modules/home-manager/desktop/asar.py","r":544,"sg":"def update(node, path=\"\"):","lt":"[\"files\",\"{path}/{name}\",\"offset\",\"size\",\"integrity\",\"blockSize\",\"algorithm\",\"SHA256\"]","sp":[40,58,5,35],"sh":"4ffb082077958af20b6a90d60064ef6404273d159bbc1d2692db77f090e65c47","tg":["description:agent","evidence:source","lang:python","source:tree-sitter","visibility:public"]}
{"t":"n","a":547,"i":"5d2a4b0f-a588-416e-b5bb-a29212c838e9","k":"file","n":"comms.nix","d":"Home Manager desktop communications module that conditionally enables signal support and installs common communication applications (Thunderbird, ProtonMail Desktop, FluffyChat, and Element Desktop) when the comms option is enabled.","p":"modules/home-manager/desktop/comms.nix","r":475,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":548,"i":"b75526d3-99a9-425e-bb62-11f5ede54f78","k":"variable","n":"config","d":"config = lib.mkIf config.comms.enable {\n  signal.enable = lib.mkDefault true;\n\n  home.packages = [\n    pkgs.thunderbird\n    pkgs.protonmail-desktop\n    pkgs.fluffychat\n    (lib.mkIf config.desktop.japanese.input.enable (pkgs.symlinkJoin\n      {\n        name = \"element-desktop\";\n        paths = [ pkgs.element-desktop ];\n        buildInputs = [ pkgs.makeWrapper ];\n        postBuild = ''\n          wrapProgram $out/bin/element-desktop \\\n                --add-flags \"--enable-wayland-ime=true\"\n        '';\n      }))\n    (lib.mkIf (!config.desktop.japanese.input.enable) pkgs.element-desktop)\n  ];\n};","p":"modules/home-manager/desktop/comms.nix","r":547,"sp":[7,26,3,5],"sh":"10d912a33d0397922930b3523f019e489fb83ad4b50bc04cc06365dd67b71c77","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":549,"i":"9993dd0c-9e56-4911-acc5-b5ca14e0969e","k":"variable","n":"home.packages","d":"home.packages = [\n  pkgs.thunderbird\n  pkgs.protonmail-desktop\n  pkgs.fluffychat\n  (lib.mkIf config.desktop.japanese.input.enable (pkgs.symlinkJoin\n    {\n      name = \"element-desktop\";\n      paths = [ pkgs.element-desktop ];\n      buildInputs = [ pkgs.makeWrapper ];\n      postBuild = ''\n        wrapProgram $out/bin/element-desktop \\\n              --add-flags \"--enable-wayland-ime=true\"\n      '';\n    }))\n  (lib.mkIf (!config.desktop.japanese.input.enable) pkgs.element-desktop)\n];","p":"modules/home-manager/desktop/comms.nix","r":548,"sp":[11,25,5,7],"sh":"e0c5580bb831c5d2e80eb922d38a815ff4415129b14ebb32e61feb0f32533a29","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
