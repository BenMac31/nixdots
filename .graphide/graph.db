{"t":"n","a":922,"i":"a5b38311-7290-40d2-9bd6-e10b6ec800db","k":"variable","n":"interval","d":"interval = 240;","p":"modules/home-manager/term/ai/accounts.nix","r":929,"sp":[39,41,1,20],"sh":"8a7e29f4e87f5b5a503d404f40c250197dbca1ed488ac225e1b99a20d6426d8f","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":923,"i":"b61a0674-64dc-42a5-b1c8-8e35a3d63310","k":"variable","n":"intoAgentsSlice","d":"intoAgentsSlice = ''\n  if [[ $(< /proc/self/cgroup) != */agents.slice/* && -S \"''${XDG_RUNTIME_DIR:-/nonexistent}/bus\" ]] \\\n      && command -v systemd-run >/dev/null; then\n    exec systemd-run --user --scope --slice=agents.slice --quiet --collect -- \"$0\" \"$@\"\n  fi\n'';","p":"modules/home-manager/term/ai/accounts.nix","r":915,"sp":[4,17,1,6],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":924,"i":"575339c2-132c-4af3-b2da-563a163466e0","k":"variable","n":"name","d":"name = \"graphide-selected-account-commands\";","p":"modules/home-manager/term/ai/accounts.nix","r":926,"sp":[29,29,5,49],"sh":"627402acf666ca3550671aa7cc42cacd95569a377ca98854d2c47f9028fc410f","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":925,"i":"af82b5e3-688d-4257-9e4e-bf646446ff09","k":"variable","n":"paths","d":"paths = [ selectedClaude selectedCodex ];","p":"modules/home-manager/term/ai/accounts.nix","r":926,"sp":[30,30,5,46],"sh":"27180bc586781240728aec7476111164c5d8cd4919dad1af9dd815567a288527","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":926,"i":"e85fb50b-06b2-4ab0-adba-51ec278957ae","k":"variable","n":"selectedAccountCommands","d":"selectedAccountCommands = pkgs.symlinkJoin {\n  name = \"graphide-selected-account-commands\";\n  paths = [ selectedClaude selectedCodex ];\n};","p":"modules/home-manager/term/ai/accounts.nix","r":915,"sp":[28,31,3,5],"sh":"e499cf25a2d6427103247d2d541b4aa5dc97db05dab98ac515f1c155c32dc96b","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":927,"i":"fcc9f13d-1480-4742-89ab-a27376ec3793","k":"variable","n":"selectedClaude","d":"selectedClaude = pkgs.writeShellScriptBin \"claude\" ''\n  export GRAPHIDE_CLAUDE_BIN=${lib.escapeShellArg (lib.getExe config.ai.claude.package)}\n  exec ${cfg.package}/bin/graphide-claude \"$@\"\n'';","p":"modules/home-manager/term/ai/accounts.nix","r":915,"sp":[18,22,3,6],"sh":"76f1ff0d6bc95973829eabdb4552a784de49948c44e7e712d201ebc2292694df","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":928,"i":"eb4c697f-a355-43a2-93b9-5834b5ba5e4b","k":"variable","n":"selectedCodex","d":"selectedCodex = pkgs.writeShellScriptBin \"codex\" ''\n  export GRAPHIDE_CODEX_BIN=${lib.escapeShellArg (lib.getExe pkgs.unstable.unfree.codex)}\n  exec ${cfg.package}/bin/graphide-codex \"$@\"\n'';","p":"modules/home-manager/term/ai/accounts.nix","r":915,"sp":[23,27,3,6],"sh":"f899aaa7a69d0c0d1cf257bcaeb23e8944fcbd7f7bcc315ec7f5598e3bd42f14","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":929,"i":"5745a0fb-a4cb-408c-b06c-56ac3b5fbf78","k":"variable","n":"services.graphide-accounts","d":"services.graphide-accounts = {\n  enable = lib.mkDefault config.ai.enable;\n  claudeCommand = lib.getExe config.ai.claude.package;\n  # This flake's unstable package set lives under the unfree-enabled overlay.\n  codexCommand = lib.getExe pkgs.unstable.unfree.codex;\n};","p":"modules/home-manager/term/ai/accounts.nix","r":915,"sp":[34,42,3,5],"sh":"83cfe83c46515a3940323303eab44adea2c08ff720331694d9866cf5eaea413e","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":930,"i":"62fa6e59-c114-4a9c-9e13-e54394dae4e2","k":"file","n":"aichat.nix","d":"Nix home-manager module that adds the aichat AI chat tool to a user's environment, exposing an enable option (ai.aichat.enable) and, when enabled, installing the aichat package and supplying a default aichat config.yaml file.","p":"modules/home-manager/term/ai/aichat.nix","r":914,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":931,"i":"66c50176-713f-42c6-9e27-31d58bc084da","k":"variable","n":"ai.aichat","d":"ai.aichat = {\n  enable = lib.mkEnableOption \"Enable aichat\";\n};","p":"modules/home-manager/term/ai/aichat.nix","r":934,"sp":[4,6,5,7],"sh":"fde46ebb58302e07215b7f19c4485e27dcdfe0ef3fa5439d09c63e6f3997e5f6","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":932,"i":"d667b113-a9b3-4b4d-ac83-e1a7e978b74a","k":"variable","n":"config","d":"config = lib.mkIf config.ai.aichat.enable {\n  home.packages = [ pkgs.aichat ];\n  xdg.configFile.\"aichat/config.yaml\".text = /*yaml */\n    ''\n      function_calling: true\n      model: g4f\n      clients:\n      - type: openai-compatible\n        name: g4f\n        api_base: http://localhost:1337/v1\n        api_key: xxx\n        models:\n        - name: deepseek-chat\n          max_input_tokens: null\n          supports_function_calling: true\n          supports_reasoning: true\n        - name: gpt-4o\n          max_input_tokens: null\n          supports_function_calling: true\n… (truncated)","p":"modules/home-manager/term/ai/aichat.nix","r":930,"sp":[8,65,3,5],"sh":"74db33cd949f19971350167d8cbf324e30fde6d93e3a24670618a8d4e82e4bb8","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":933,"i":"a70e3af6-eef2-4ac3-87d6-ca188f3bbcb7","k":"variable","n":"home.packages","d":"home.packages = [ pkgs.aichat ];","p":"modules/home-manager/term/ai/aichat.nix","r":932,"sp":[9,9,5,37],"sh":"ee74f7ee98fc0f1e8e4a34d83b3a2518ff1a4dabd34bcc3491990b2b408247c7","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":934,"i":"3b7af148-2f2c-4b6e-aa85-6807a25c7b37","k":"variable","n":"options","d":"options = {\n  ai.aichat = {\n    enable = lib.mkEnableOption \"Enable aichat\";\n  };\n};","p":"modules/home-manager/term/ai/aichat.nix","r":930,"sp":[3,7,3,5],"sh":"3d71a8c813a41b37d623d6c19a9c2fcfce7779f706eb8aff322e1e5c8f516d24","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":935,"i":"170c04a5-5704-4588-aeb1-c2b682c7f681","k":"variable","n":"xdg.configFile.\"aichat/config.yaml\".text","d":"xdg.configFile.\"aichat/config.yaml\".text = /*yaml */\n''\n  function_calling: true\n  model: g4f\n  clients:\n  - type: openai-compatible\n    name: g4f\n    api_base: http://localhost:1337/v1\n    api_key: xxx\n    models:\n    - name: deepseek-chat\n      max_input_tokens: null\n      supports_function_calling: true\n      supports_reasoning: true\n    - name: gpt-4o\n      max_input_tokens: null\n      supports_function_calling: true\n    - name: gpt-4o-mini\n      max_input_tokens: null\n      supports_function_calling: true\n'';","p":"modules/home-manager/term/ai/aichat.nix","r":932,"sp":[10,30,5,10],"sh":"962559fc29e5e3f21f27e6a9a7cd2d41127f24b94ec753e899cc07433482afba","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":936,"i":"a7a68d74-426d-4e3a-9154-1d4f44cd7e27","k":"variable","n":"xdg.configFile.\"aichat/roles/test.md\".text","d":"xdg.configFile.\"aichat/roles/test.md\".text = /*md*/\n''\n  ---\n  model: g4f:deepseek-chat\n  temperature: 0\n  top_p: 0\n\n  ---\n  For the first question you recieve you will comply with the following process:\n  First write out your in depth thought on how to answer the question.\n  Once you come up with an answer format it as follows:\n  ANSWER: <answer>\n  EXPLANATION: <explanation>\n  Your answer should be a single word or phrase. If there are multiple answers, separate them with commas.\n  Your explanation should be as brief as possible (ideally less than 2 sentences.)\n… (truncated)","p":"modules/home-manager/term/ai/aichat.nix","r":932,"sp":[31,64,5,10],"sh":"6ee62bc0bbe2c8f24bcf00da3d1ed094d4331d6b4a7b5c07a0927d0ec0600ca4","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":937,"i":"e8505288-5183-4700-8b41-28b5b61c48bc","k":"file","n":"aiclip.nix","d":"Home Manager module enabling the aiclip clipboard-to-aichat notification popup, exposing an enable option and installing the aiclip wrapper with its runtime dependencies.","p":"modules/home-manager/term/ai/aiclip.nix","r":914,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":938,"i":"efe2801b-6c08-4b50-b247-39515c33b9b0","k":"variable","n":"ai.aiclip","d":"ai.aiclip = {\n  enable = lib.mkEnableOption \"Enable aiclip, the clipboard-to-aichat notification popup\";\n};","p":"modules/home-manager/term/ai/aiclip.nix","r":941,"sp":[4,6,5,7],"sh":"906449b9bacfc180f3a096a0f6f308b220a538b6b2429035d700cca0998e615b","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":939,"i":"9545fa4b-8749-4fbb-a370-a77e4b8e35e7","k":"variable","n":"config","d":"config = lib.mkIf config.ai.aiclip.enable {\n  home.packages = [\n    (pkgs.writeShellApplication\n      {\n        name = \"aiclip\";\n        runtimeInputs = [ pkgs.aichat pkgs.libnotify pkgs.wl-clipboard pkgs.coreutils pkgs.expect ];\n        text = ''\n                  lockfile=\"/tmp/aiclip.lock.$$\"\n                  outfile=\"/tmp/aiclip.out.$$\"\n                  sessionfile=\"$XDG_CONFIG_HOME/aichat/sessions/test-$$\"\n                  touch $lockfile\n… (truncated)","p":"modules/home-manager/term/ai/aiclip.nix","r":937,"sp":[8,55,3,5],"sh":"b472ee86997ab614ba3932d1246ada8a2eb6145bf3b710c43626af0d0891b4a3","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":940,"i":"61dc5018-f1c8-40ad-baeb-198780733b10","k":"variable","n":"home.packages","d":"home.packages = [\n  (pkgs.writeShellApplication\n    {\n      name = \"aiclip\";\n      runtimeInputs = [ pkgs.aichat pkgs.libnotify pkgs.wl-clipboard pkgs.coreutils pkgs.expect ];\n      text = ''\n                lockfile=\"/tmp/aiclip.lock.$$\"\n                outfile=\"/tmp/aiclip.out.$$\"\n                sessionfile=\"$XDG_CONFIG_HOME/aichat/sessions/test-$$\"\n                touch $lockfile\n… (truncated)","p":"modules/home-manager/term/ai/aiclip.nix","r":939,"sp":[9,54,5,7],"sh":"654ad15ed0ebe8cd83b56dd1cbed6e2b6ac32753fb0988510fdc05f90ce26698","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":941,"i":"60cc8c6d-3ef7-44c2-9d8a-9eb5cb9210d6","k":"variable","n":"options","d":"options = {\n  ai.aiclip = {\n    enable = lib.mkEnableOption \"Enable aiclip, the clipboard-to-aichat notification popup\";\n  };\n};","p":"modules/home-manager/term/ai/aiclip.nix","r":937,"sp":[3,7,3,5],"sh":"0e8f6fbb46238372c3a62512969e46a8a47b480085c009fe496d242468b82759","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":942,"i":"e69b8884-906a-4ccd-808d-c10de3a77a9d","k":"file","n":"claude-code.nix","d":"Home Manager module that adds the ai.claude options and configures the claude-code program, allowing users to enable Claude Code and select its package.","p":"modules/home-manager/term/ai/claude-code.nix","r":914,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":943,"i":"cc61e0bb-fe63-455f-9d45-c21845757dad","k":"variable","n":"ai.claude","d":"ai.claude = {\n  enable = lib.mkEnableOption \"Enable Claude Code\";\n  package = lib.mkOption {\n    type = lib.types.package;\n    default = pkgs.unstable.unfree.claude-code;\n    defaultText = lib.literalExpression \"pkgs.unstable.unfree.claude-code\";\n    description = \"Which claude-code build to install; unfree, so it tracks the unstable overlay.\";\n  };\n};","p":"modules/home-manager/term/ai/claude-code.nix","r":945,"sp":[4,12,5,7],"sh":"c012ea432f8e8ddf6fb8dc7fb68ea8c9583c6ca9be0490f14477db233816c7f7","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":944,"i":"e7f1c7c1-725f-443c-a081-42a71c819cf4","k":"variable","n":"config","d":"config = lib.mkIf config.ai.claude.enable {\n  programs.claude-code = {\n    enable = true;\n    inherit (config.ai.claude) package;\n  };\n};","p":"modules/home-manager/term/ai/claude-code.nix","r":942,"sp":[15,20,3,5],"sh":"5d359b5821ea33cc203a9591c6deca5d08f241f29c6e469f7859f8b82f7e1729","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":945,"i":"ea458161-898a-4433-b740-a38d35806344","k":"variable","n":"options","d":"options = {\n  ai.claude = {\n    enable = lib.mkEnableOption \"Enable Claude Code\";\n    package = lib.mkOption {\n      type = lib.types.package;\n      default = pkgs.unstable.unfree.claude-code;\n      defaultText = lib.literalExpression \"pkgs.unstable.unfree.claude-code\";\n      description = \"Which claude-code build to install; unfree, so it tracks the unstable overlay.\";\n    };\n  };\n};","p":"modules/home-manager/term/ai/claude-code.nix","r":942,"sp":[3,13,3,5],"sh":"74dedddf86650de61b7e298d9bf38cb735e740ba891a256ac793212d4e98d69f","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
