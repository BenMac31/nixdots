{"t":"n","a":1313,"i":"98b9daf1-5f49-42a7-a661-62bd7b015249","k":"variable","n":"synapsePort","d":"synapsePort = 8008;","p":"modules/nixos/serv/matrix/synapse.nix","r":1307,"sp":[9,9,3,22],"sh":"cc81abaaa89aa6dd21cd2149d63f60179425b62bccd00fec782cba2a7b0833d9","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
