{"t":"n","a":1041,"i":"6e062a80-14e6-4395-89e8-c19548f8fa0b","k":"file","n":"vim.nix","d":"Home-manager module that configures Neovim (vim) when programs.neovim.enable is true, installing the unwrapped Neovim package, setting it as the default editor, enabling vimdiff alias, and applying the associated Home Manager settings.","p":"modules/home-manager/term/tui/vim.nix","r":1028,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1042,"i":"a523f834-2d5b-4865-895a-6f5316b90d35","k":"variable","n":"config","d":"config = lib.mkIf config.programs.neovim.enable {\n  programs.neovim = {\n    package = inputs.nixpkgs-unstable.legacyPackages.${pkgs.stdenv.hostPlatform.system}.neovim-unwrapped;\n    defaultEditor = true;\n    vimdiffAlias = true;\n    # HM 26.05 writes nvim/init.lua by default; sideload so our live symlinked config dir is not overridden.\n    sideloadInitLua = true;\n    withNodeJs = true;\n    withPython3 = true;\n    withRuby = true;\n    extraLuaPackages = ps: [ ps.magick ];\n    extraPackages = [\n      pkgs.lsof\n      pkgs.librsvg\n      pkgs.imagemagick\n… (truncated)","p":"modules/home-manager/term/tui/vim.nix","r":1041,"sp":[3,42,3,5],"sh":"b326f3b8489c9957887068154878858c44bf70fd9f03d38eb7b6aa9361854e64","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1043,"i":"fe98a8ba-a3b3-458f-b8ab-271f5859089d","k":"variable","n":"home.packages","d":"home.packages = [\n  pkgs.stylua\n  pkgs.python312Packages.flake8\n  pkgs.shellcheck\n  pkgs.rustup\n  pkgs.gcc\n  pkgs.tree-sitter\n  pkgs.luajitPackages.magick\n  pkgs.clang-tools\n];","p":"modules/home-manager/term/tui/vim.nix","r":1042,"sp":[22,31,5,7],"sh":"d803d8dbfbc37314213bde3ad32a68b3fb8765674de29ff7ec01c58d82f4ca5b","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1044,"i":"0fa66de4-70a5-43ff-9a3a-fbb293fe0086","k":"variable","n":"programs.neovim","d":"programs.neovim = {\n  package = inputs.nixpkgs-unstable.legacyPackages.${pkgs.stdenv.hostPlatform.system}.neovim-unwrapped;\n  defaultEditor = true;\n  vimdiffAlias = true;\n  # HM 26.05 writes nvim/init.lua by default; sideload so our live symlinked config dir is not overridden.\n  sideloadInitLua = true;\n  withNodeJs = true;\n  withPython3 = true;\n  withRuby = true;\n  extraLuaPackages = ps: [ ps.magick ];\n  extraPackages = [\n    pkgs.lsof\n    pkgs.librsvg\n    pkgs.imagemagick\n    inputs.nixpkgs-unstable.legacyPackages.${pkgs.stdenv.hostPlatform.system}.opencode\n    pkgs.jdk21\n  ];\n};","p":"modules/home-manager/term/tui/vim.nix","r":1042,"sp":[4,21,5,7],"sh":"06b45c2f91c38116798121ecc62c922021fa9a40a3f91bde39831c1e88cd8272","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1045,"i":"db54d707-df21-4c88-84d5-1beb86dffbf3","k":"variable","n":"xdg.configFile","d":"xdg.configFile = lib.mkIf (flakeAttr == \"nixWorks\") {\n  \"lvim\" = {\n    enable = true;\n    source = config.lib.file.mkOutOfStoreSymlink \"${config.home.homeDirectory}/nixos/confs/lvim\";\n  };\n  \"nvim\" = {\n    enable = true;\n    source = config.lib.file.mkOutOfStoreSymlink \"${config.home.homeDirectory}/nixos/confs/nvim\";\n  };\n};","p":"modules/home-manager/term/tui/vim.nix","r":1042,"sp":[32,41,5,7],"sh":"c9815e0785a4a370710c24ee18e7125a37f23ec3bbb944b647a24901fc3c3472","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1046,"i":"c532b572-d924-4cc8-9403-bb3b08d2754f","k":"file","n":"yc.nix","d":"Home Manager module that adds a configurable option to enable the YC CLI, installs the yc-cli package when enabled, and removes any upstream installer‑provided binary to avoid conflicts.","p":"modules/home-manager/term/yc.nix","r":912,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1047,"i":"74589735-46fb-4186-9547-c2c7278bd5a4","k":"variable","n":"config","d":"config = lib.mkIf config.yc.enable {\n  home.packages = [ pkgs.yc-cli ];\n\n  # ~/.yc/bin is where upstream's installer drops its own copy of the binary,\n  # which the packaged one replaces; prune it so it doesn't shadow ours.\n  home.activation.pruneYcInstallerBin =\n    lib.hm.dag.entryAfter [ \"writeBoundary\" ] ''\n      run rm -rf \"$HOME/.yc/bin\"\n    '';\n};","p":"modules/home-manager/term/yc.nix","r":1046,"sp":[8,17,3,5],"sh":"420bbe5ea43250f08416a4efc371134abd15c6c97e09e04a6d4f7b36912115d7","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1048,"i":"6e3c1d99-b180-4905-9408-115ad1160893","k":"variable","n":"home.activation.pruneYcInstallerBin","d":"home.activation.pruneYcInstallerBin =\nlib.hm.dag.entryAfter [ \"writeBoundary\" ] ''\n  run rm -rf \"$HOME/.yc/bin\"\n'';","p":"modules/home-manager/term/yc.nix","r":1047,"sp":[11,16,1,10],"sh":"da0e846d48b7e7b2c5c90d142c11b3f7c848a4e6b4c1b909c39cb3cf7b757121","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1049,"i":"b1f43817-d78d-4c52-b35a-6d3299bee313","k":"variable","n":"home.packages","d":"home.packages = [ pkgs.yc-cli ];","p":"modules/home-manager/term/yc.nix","r":1047,"sp":[9,9,5,98],"sh":"a38b4250497f18cf9478ad609ec601af3f997b0d521637ee995ad6c9b6753d79","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
