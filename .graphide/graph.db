{"t":"n","a":760,"i":"9d1f1c50-2bdb-4fed-96cd-4c3d3658dfcc","k":"file","n":"health-alerts.nix","d":"Implements the Home Manager health‑alerts feature: defines configurable options for battery, disk and Nixpkgs channel monitoring, generates the corresponding shell scripts, and sets up a user‑level systemd service to run the battery script (and related checks) and emit alerts.","p":"modules/home-manager/desktop/health-alerts.nix","r":475,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":761,"i":"6eb5b168-99df-4ebb-8609-4adaea614883","k":"variable","n":"battery","d":"battery = {\n  warnPercent = lib.mkOption {\n    type = lib.types.int;\n    default = 30;\n    description = \"Battery percentage for a desktop notification.\";\n  };\n  critPercent = lib.mkOption {\n    type = lib.types.int;\n    default = 20;\n    description = \"Battery percentage for a critical desktop notification.\";\n  };\n  urgentPercent = lib.mkOption {\n    type = lib.types.int;\n    default = 10;\n    description = \"Battery percentage for an urgent desktop notification.\";\n  };\n};","p":"modules/home-manager/desktop/health-alerts.nix","r":772,"sp":[209,225,5,7],"sh":"4a29310d292250e5e3873350aa2e93c40c32cd655162abd9e2a441796c0a81a7","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":762,"i":"b83dddaf-c83c-4842-af66-78f1a6106d75","k":"variable","n":"batteryScript","d":"batteryScript = pkgs.writeShellScript \"health-alerts-battery\" ''\n  set -eu\n\n  WARN=${toString cfg.battery.warnPercent}\n  CRIT=${toString cfg.battery.critPercent}\n  URGENT=${toString cfg.battery.urgentPercent}\n  HYSTERESIS=5\n\n  STATE_DIR=\"''${XDG_RUNTIME_DIR:-/tmp}/health-alerts\"\n  mkdir -p \"$STATE_DIR\"\n  STATE_FILE=\"$STATE_DIR/battery\"\n\n  battery_path=$(${pkgs.upower}/bin/upower -e | ${pkgs.gnugrep}/bin/grep -m1 'battery' || true)\n  if [ -z \"$battery_path\" ]; then\n    exit 0\n  fi\n\n  get_pct() {\n… (truncated)","p":"modules/home-manager/desktop/health-alerts.nix","r":760,"sp":[16,108,3,6],"sh":"b544b0d84b9b479ed9897c6c2f4b4c6a1dbed61c27281646ccf0055bfdf32588","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":763,"i":"c8c20a7a-e90c-4082-a703-238a6300310d","k":"variable","n":"cacheDir","d":"cacheDir = \"${config.home.homeDirectory}/.cache/system-health\";","p":"modules/home-manager/desktop/health-alerts.nix","r":760,"sp":[6,6,3,66],"sh":"ae6e332f6623e84439909ba928e53d6c686b82d5c725d77b54733a14881f1273","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":764,"i":"b6f76631-3988-4d28-8275-3de1f4f48ce0","k":"variable","n":"cfg","d":"cfg = config.healthAlerts;","p":"modules/home-manager/desktop/health-alerts.nix","r":760,"sp":[4,4,3,29],"sh":"c4a24cf49de0656c7cf3c7f759333079fed0da46dbdadf3c0432b1d3a277aaca","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":765,"i":"7edc5413-956f-4b45-b9c4-976e461e0f7c","k":"variable","n":"config","d":"config = lib.mkIf cfg.enable {\n  systemd.user.services.health-alerts-battery = {\n    Unit = {\n      Description = \"Battery low alerts via UPower\";\n      After = [ \"graphical-session.target\" ];\n    };\n    Service = {\n      ExecStart = \"${batteryScript}\";\n      Restart = \"always\";\n      RestartSec = \"10\";\n    };\n    Install.WantedBy = [ \"default.target\" ];\n  };\n\n  systemd.user.services.health-alerts-disk = {\n    Unit = {\n      Description = \"Check disk space and update terminal warning cache\";\n    };\n    Service = {\n      Type = \"oneshot\";\n      ExecStart = \"${diskScript}\";\n… (truncated)","p":"modules/home-manager/desktop/health-alerts.nix","r":760,"sp":[228,294,3,5],"sh":"880f4c954a06161d0bf4ac5d74c3234e67fdd744d75293690ea006c669563692","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":766,"i":"49b392d2-7de7-446d-a74e-43543e031d39","k":"variable","n":"disk","d":"disk = {\n  warnPercent = lib.mkOption {\n    type = lib.types.int;\n    default = 90;\n    description = \"Disk usage percentage that triggers a terminal warning.\";\n  };\n  critPercent = lib.mkOption {\n    type = lib.types.int;\n    default = 95;\n    description = \"Disk usage percentage that triggers a critical terminal warning.\";\n  };\n};","p":"modules/home-manager/desktop/health-alerts.nix","r":772,"sp":[196,207,5,7],"sh":"d0060afd9036f0f0fc5e4722e65cfafe97b10dcf7fc54e147136569ac51bf6dd","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":767,"i":"bade850b-23f8-40d8-8e21-f2849d1c6221","k":"variable","n":"diskScript","d":"diskScript = pkgs.writeShellScript \"health-alerts-disk\" ''\n  set -eu\n\n  CACHE_DIR=\"${cacheDir}\"\n  WARN_FILE=\"$CACHE_DIR/disk-warning\"\n  WARN_PCT=${toString cfg.disk.warnPercent}\n  CRIT_PCT=${toString cfg.disk.critPercent}\n\n  mkdir -p \"$CACHE_DIR\"\n\n  warnings=\"\"\n  for mount in / /nix; do\n    if ! pct=$(${pkgs.coreutils}/bin/df --output=pcent \"$mount\" 2>/dev/null | ${pkgs.coreutils}/bin/tail -1 | tr -dc '0-9'); then\n      continue\n    fi\n    if [ \"$pct\" -ge \"$CRIT_PCT\" ]; then\n      warnings=\"''${warnings}CRITICAL: $mount is ''${pct}% full (threshold: ''${CRIT_PCT}%)\\n\"\n… (truncated)","p":"modules/home-manager/desktop/health-alerts.nix","r":760,"sp":[110,137,3,6],"sh":"0cf3468b98ca0fa3d9537aa4f5e7e8161d83416083a4b9f14afaf3292b7553e2","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":768,"i":"09f1d3c4-dbe2-41cb-98df-8ccb53f96eb0","k":"variable","n":"enable","d":"enable = lib.mkEnableOption \"Laptop system health alerts (battery, disk, release deprecation)\";","p":"modules/home-manager/desktop/health-alerts.nix","r":772,"sp":[194,194,5,100],"sh":"6f077b9a8c53c4fe8ca5bb0c2979d5d79eb21c87c2f3bad59da8b820fd389817","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":769,"i":"93a3eb8d-53e6-4530-bc17-ec33d4b80ab5","k":"variable","n":"lock","d":"lock = builtins.fromJSON (builtins.readFile \"${inputs.self}/flake.lock\");","p":"modules/home-manager/desktop/health-alerts.nix","r":770,"sp":[10,10,7,80],"sh":"f67e3d00739d418add373e93402f1258c60d9ba321af789d049b34c010ddc35a","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":770,"i":"edfc61ab-0139-49ce-81c8-cefce73ef899","k":"variable","n":"nixpkgsChannel","d":"nixpkgsChannel =\nlet\n  lock = builtins.fromJSON (builtins.readFile \"${inputs.self}/flake.lock\");\n  nixpkgsNode = lock.nodes.root.inputs.nixpkgs;\n  ref = lock.nodes.${nixpkgsNode}.original.ref or \"\";\nin\nif lib.hasPrefix \"nixos-\" ref then ref else null;","p":"modules/home-manager/desktop/health-alerts.nix","r":760,"sp":[8,14,3,54],"sh":"49b64a8d5e82e94b1c7cf79e0ffe439e88b32ed963d93ecb30ae78921ca5d808","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
