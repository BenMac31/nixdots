{"t":"n","a":1104,"i":"45f5ba78-ef7b-4093-a2a2-29f7c5f365be","k":"module","n":"Head System Configuration","d":"Provides a NixOS module for systems with a graphical interface. Enables a boot splash via Plymouth, configures the SDDM display manager (with Wayland and a custom theme), sets up PipeWire audio (including ALSA and PulseAudio support) while disabling Pulseaudio, and optionally activates gaming‑related programs such as gamemode and gamescope when the head.gaming option is enabled. It also enables font directories and uinput for gaming input devices.","p":"modules/nixos/head","r":1105,"tg":["evidence:source","lang:nix","layer:architecture","source:arch-agent"]}
{"t":"n","a":1105,"i":"f8c2f286-a31b-42c3-a892-b93682fd70a3","k":"subsystem","n":"modules/nixos/head — Graphical (head) system configuration","d":"Nix modules configuring the graphical stack, including the SDDM display manager.","p":"modules/nixos/head","r":1080,"tg":["evidence:signatures","layer:overview","overview:rung:directory","source:overview-agent"]}
{"t":"n","a":1106,"i":"11f2e893-9403-4b05-a91f-01ee4ab2f055","k":"file","n":"default.nix","d":"NixOS module that defines the \"head\" feature set, providing enable and gaming options, importing plymouth and sddm configurations, and adding default graphical services (plymouth, SDDM, PipeWire, and PulseAudio) when enabled.","p":"modules/nixos/head/default.nix","r":1104,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1107,"i":"d3ba82de-2743-4731-89cd-07f5d6c9a7f1","k":"variable","n":"boot.plymouth.enable","d":"boot.plymouth.enable = lib.mkDefault true;","p":"modules/nixos/head/default.nix","r":1108,"sp":[14,14,5,47],"sh":"df882d86eac56529a183e465bd4b5733a927f039d8523b6207075baaa276c656","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1108,"i":"fb097484-81d8-4476-91f8-83f73515055d","k":"variable","n":"config","d":"config = lib.mkIf config.head.enable {\n  boot.plymouth.enable = lib.mkDefault true;\n  services = {\n    displayManager.sddm.enable = lib.mkDefault true;\n    pipewire = {\n      enable = true;\n      alsa.enable = true;\n      alsa.support32Bit = true;\n      pulse.enable = true;\n    };\n  };\n  hardware.pulseaudio.enable = false;\n  programs = lib.mkIf config.head.gaming {\n    gamemode.enable = true;\n    gamescope.enable = true;\n  };\n  fonts.fontDir.enable = true;\n  hardware.uinput.enable = lib.mkIf config.head.gaming true;\n};","p":"modules/nixos/head/default.nix","r":1106,"sp":[13,31,3,5],"sh":"33d875477beb41afc68e364bd095c0ff96e6051e584cd0d35cdf39a80650a52a","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
