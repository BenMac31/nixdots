{"t":"n","a":963,"i":"9e1e400f-0458-4894-bdd9-1588ddb00a48","k":"variable","n":"programs","d":"programs = {\n  gpg.enable = true;\n  ssh.enable = lib.mkDefault true;\n  direnv = {\n    enable = true;\n    nix-direnv.enable = true;\n    enableBashIntegration = true;\n    enableZshIntegration = true;\n    enableFishIntegration = true;\n  };\n};","p":"modules/home-manager/term/default.nix","r":960,"sp":[22,33,5,7],"sh":"2c63624221c6a931579df3c9ff45668d44f6ec2e5730d18a351c5417bc053b94","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
