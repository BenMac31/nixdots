{"t":"n","a":965,"i":"a90ac665-b472-48fe-982e-f450200415b4","k":"file","n":"fastfetch.nix","d":"Provides Home Manager fastfetch configuration, generating a raster logo from the project's SVG and setting a privacy‑focused layout of display modules and colors when the Verdigris desktop theme is enabled.","p":"modules/home-manager/term/fastfetch.nix","r":912,"tg":["description:agent","evidence:source","lang:nix","source:tree-sitter"]}
{"t":"n","a":966,"i":"431ce223-6142-4aa6-bad1-18e086002899","k":"variable","n":"flatLogo","d":"flatLogo = pkgs.runCommand \"graphide-flat-logo.png\" {\n  nativeBuildInputs = [ pkgs.librsvg ];\n} ''\n  rsvg-convert -w 512 -h 512 ${inputs.graphide-tools}/website/public/logo.svg > \"$out\"\n'';","p":"modules/home-manager/term/fastfetch.nix","r":965,"sp":[3,9,1,6],"sh":"5b575ab54adf4507a91c357222faea2be0308cd782a8b6fc7ec84e6603f5b6a2","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":967,"i":"d8358cc9-0a4f-4426-b413-3c5bcb1d1fa4","k":"variable","n":"nativeBuildInputs","d":"nativeBuildInputs = [ pkgs.librsvg ];","p":"modules/home-manager/term/fastfetch.nix","r":966,"sp":[6,6,5,42],"sh":"db9e6de1b5042f78cee4e27a90c9057497c90afcf99214c09683437d310d3f9e","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":968,"i":"3fe9c0a8-b7e4-41a7-a83b-d80b520d48b2","k":"variable","n":"programs.fastfetch","d":"programs.fastfetch = lib.mkIf config.programs.fastfetch.enable {\n  settings = lib.mkIf config.desktop.verdigris.enable {\n    logo = {\n      type = \"kitty\";\n      source = \"${flatLogo}\";\n      width = 18;\n      height = 9;\n      padding = { top = 1; left = 1; right = 4; };\n    };\n    display = {\n      separator = \"  ·  \";\n      color = { keys = \"#4fa396\"; title = \"#6dbcb0\"; output = \"#bcc6cd\"; };\n    };\n    # No usernames, network addresses, account data, or company metrics.\n    modules = [\n      { type = \"os\"; key = \"System\"; }\n      { type = \"kernel\"; key = \"Kernel\"; }\n… (truncated)","p":"modules/home-manager/term/fastfetch.nix","r":965,"sp":[11,39,3,5],"sh":"e0c7f8ea18a64d058c14a7d9effb3c198dcc7324fa988a371581d105a49636e6","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":969,"i":"72940bd1-6f0f-4411-ad73-a03e169d4bae","k":"variable","n":"settings","d":"settings = lib.mkIf config.desktop.verdigris.enable {\n  logo = {\n    type = \"kitty\";\n    source = \"${flatLogo}\";\n    width = 18;\n    height = 9;\n    padding = { top = 1; left = 1; right = 4; };\n  };\n  display = {\n    separator = \"  ·  \";\n    color = { keys = \"#4fa396\"; title = \"#6dbcb0\"; output = \"#bcc6cd\"; };\n  };\n  # No usernames, network addresses, account data, or company metrics.\n  modules = [\n    { type = \"os\"; key = \"System\"; }\n    { type = \"kernel\"; key = \"Kernel\"; }\n    { type = \"wm\"; key = \"Desktop\"; }\n    { type = \"terminal\"; key = \"Terminal\"; }\n… (truncated)","p":"modules/home-manager/term/fastfetch.nix","r":968,"sp":[12,38,5,7],"sh":"0493d912c24a316f8cb54044fa517e0c2f71294f8578c28ea7b88976ebda41b3","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":970,"i":"803432c2-43bf-4f26-8076-5c5f1c17bc55","k":"file","n":"git.nix","d":"Home Manager configuration for Git: enables the Git program, sets user name and email, and defines custom Git command aliases.","p":"modules/home-manager/term/git.nix","r":912,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":971,"i":"643c7dab-8c28-444d-8600-8214d8040d01","k":"variable","n":"aliases","d":"aliases = {\n  # Push HEAD as it was at the current moment (useful for resetting a branch\n  # to its state before a rebase/amend that happened \"just now\").\n  pushtillnow = ''!git push origin $(git rev-list -1 --before=\"@{now}\" HEAD):master'';\n};","p":"modules/home-manager/term/git.nix","r":973,"sp":[7,11,5,7],"sh":"1be5cb2d675d016c5c1cd6fd331fae837c2162f75dcd3f32fcf96613e87dad35","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":972,"i":"1c2a48b1-2278-4963-a959-6d47d9714ded","k":"variable","n":"enable","d":"enable = true;","p":"modules/home-manager/term/git.nix","r":973,"sp":[4,4,5,19],"sh":"dffb0e569772e112c1f30bbae904e566fc4a4c898b009e6c28d7cc30f53f0d3e","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":973,"i":"cf660ccd-27ac-4816-9ece-d9f6203deda7","k":"variable","n":"programs.git","d":"programs.git = {\n  enable = true;\n  userName = \"Benjamin McIntyre\";\n  userEmail = \"mcintybi@mail.uc.edu\";\n  aliases = {\n    # Push HEAD as it was at the current moment (useful for resetting a branch\n    # to its state before a rebase/amend that happened \"just now\").\n    pushtillnow = ''!git push origin $(git rev-list -1 --before=\"@{now}\" HEAD):master'';\n  };\n};","p":"modules/home-manager/term/git.nix","r":970,"sp":[3,12,3,5],"sh":"838b8dfcf935e22ddc86e62dbfada0cd3188191abbee2ae56a73b1e02bb05139","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":974,"i":"eb0748ac-8cc8-418b-a0bf-bc326579b3a5","k":"variable","n":"userEmail","d":"userEmail = \"mcintybi@mail.uc.edu\";","p":"modules/home-manager/term/git.nix","r":973,"sp":[6,6,5,40],"sh":"130b4e13f0eff3b4e8c6b90564b56c33f28662e3b9f29c6941395ffcc74f4d89","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":975,"i":"53022ec7-1e14-4355-bdbf-3341b8c870f6","k":"variable","n":"userName","d":"userName = \"Benjamin McIntyre\";","p":"modules/home-manager/term/git.nix","r":973,"sp":[5,5,5,36],"sh":"b7661fe267279f549173f71dad9e594b2cefa8476d57e711415dbb8f1fa64d42","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":976,"i":"cca326ed-892c-4730-ba6d-eae275135318","k":"file","n":"graphide-sync.nix","p":"modules/home-manager/term/graphide-sync.nix","r":912,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":977,"i":"cdeb7289-541b-4b8b-9c48-ba79bb8e1b66","k":"variable","n":"allowlist","d":"allowlist = lib.mkOption {\n  type = lib.types.listOf lib.types.str;\n  default = defaultAllowlist;\n  description = ''\n    Repo-relative prefixes whose local state may be discarded to unblock\n    the fast-forward. Every entry must be regenerable from something else\n    on this machine; see the comment above defaultAllowlist for why these\n    two are tracked rather than gitignored.\n  '';\n};","p":"modules/home-manager/term/graphide-sync.nix","r":987,"sp":[197,206,5,7],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":978,"i":"bee814bb-1625-439e-8ecb-2625183371e6","k":"variable","n":"branch","d":"branch = lib.mkOption {\n  type = lib.types.str;\n  default = \"master\";\n  description = \"Branch to sync. The run is a no-op unless HEAD is on it.\";\n};","p":"modules/home-manager/term/graphide-sync.nix","r":987,"sp":[185,189,5,7],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":979,"i":"4b4dc531-aa03-4a89-8821-9a110fb758a0","k":"variable","n":"cfg","d":"cfg = config.graphide.checkoutSync;","p":"modules/home-manager/term/graphide-sync.nix","r":976,"sp":[3,3,3,38],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":980,"i":"c08d6fdd-91b0-4c2f-a668-cc7633a0becf","k":"variable","n":"checkout","d":"checkout = lib.mkOption {\n  type = lib.types.str;\n  default = defaultCheckout;\n  description = \"Main checkout to keep fast-forwarded. Must not be a worktree.\";\n};","p":"modules/home-manager/term/graphide-sync.nix","r":987,"sp":[179,183,5,7],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":981,"i":"ccc38c55-f2c0-4eda-a38d-d909bb9cbf91","k":"variable","n":"config","d":"config = lib.mkIf (config.graphide.enable && cfg.enable) {\n  systemd.user.services.graphide-checkout-sync = {\n    Unit = {\n      Description = \"Fast-forward the shared graphide main checkout to origin/master\";\n      After = [ \"network-online.target\" ];\n      Wants = [ \"network-online.target\" ];\n    };\n    Service = {\n      Type = \"oneshot\";\n      ExecStart = lib.getExe syncScript;\n      # The same agent-held SSH key the shell uses; the repo is private and\n      # this machine has no GitHub token in nix.conf.\n      Environment = [ \"SSH_AUTH_SOCK=%t/ssh-agent\" ];\n… (truncated)","p":"modules/home-manager/term/graphide-sync.nix","r":976,"sp":[215,246,3,5],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":982,"i":"b0e084c9-4edd-4b50-b0de-9ed3740aa32d","k":"variable","n":"defaultAllowlist","d":"defaultAllowlist = [\n  \".graphide/authored\"\n  \"gred/extensions/graphide/out\"\n];","p":"modules/home-manager/term/graphide-sync.nix","r":976,"sp":[12,32,1,5],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":983,"i":"62af984a-59fe-45ed-8b16-4dd65e9556b4","k":"variable","n":"defaultCheckout","d":"defaultCheckout = \"/home/greencheetah/Projects/graphide/graphide\";","p":"modules/home-manager/term/graphide-sync.nix","r":976,"sp":[5,10,1,69],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":984,"i":"89cdecec-c4a7-4e31-b2cd-5313e7c30789","k":"variable","n":"enable","d":"enable = lib.mkEnableOption ''\n  a user timer that fast-forwards the shared main graphide checkout to\n  origin/master, discarding only the two generated paths that otherwise\n  block it. It never merges, never rebases, never stashes, and never\n  touches a checkout that is ahead or dirty outside that allowlist\n'';","p":"modules/home-manager/term/graphide-sync.nix","r":987,"sp":[172,177,5,8],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":985,"i":"9afbefbf-b452-43cb-b675-8b9d903c6994","k":"variable","n":"interval","d":"interval = lib.mkOption {\n  type = lib.types.str;\n  default = \"30m\";\n  description = \"OnUnitActiveSec for the sync timer.\";\n};","p":"modules/home-manager/term/graphide-sync.nix","r":987,"sp":[208,212,5,7],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":986,"i":"83308d9c-e393-4733-bdbc-e4dab73b2811","k":"variable","n":"name","d":"name = \"graphide-checkout-sync\";","p":"modules/home-manager/term/graphide-sync.nix","r":990,"sp":[35,35,5,37],"tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":987,"i":"b18d1513-67d5-4696-84e1-839e11101090","k":"variable","n":"options.graphide.checkoutSync","d":"options.graphide.checkoutSync = {\n  enable = lib.mkEnableOption ''\n    a user timer that fast-forwards the shared main graphide checkout to\n    origin/master, discarding only the two generated paths that otherwise\n    block it. It never merges, never rebases, never stashes, and never\n    touches a checkout that is ahead or dirty outside that allowlist\n  '';\n\n  checkout = lib.mkOption {\n    type = lib.types.str;\n    default = defaultCheckout;\n    description = \"Main checkout to keep fast-forwarded. Must not be a worktree.\";\n  };\n\n  branch = lib.mkOption {\n… (truncated)","p":"modules/home-manager/term/graphide-sync.nix","r":976,"sp":[171,213,3,5],"tg":["description:declaration","lang:nix","nix:option","source:tree-sitter","visibility:public"]}
{"t":"n","a":988,"i":"332fdb9f-9b0f-4d8f-a039-7402fb77fa51","k":"variable","n":"remote","d":"remote = lib.mkOption {\n  type = lib.types.str;\n  default = \"origin\";\n  description = \"Remote to fast-forward from.\";\n};","p":"modules/home-manager/term/graphide-sync.nix","r":987,"sp":[191,195,5,7],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":989,"i":"6f9d2efb-e3ba-4293-bd11-a029a3dec60e","k":"variable","n":"runtimeInputs","d":"runtimeInputs = [\n  pkgs.git\n  pkgs.openssh\n  pkgs.util-linux\n  pkgs.libnotify\n  pkgs.coreutils\n];","p":"modules/home-manager/term/graphide-sync.nix","r":990,"sp":[36,42,5,7],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":990,"i":"be52d36c-9434-4085-81a5-633e06a288b3","k":"variable","n":"syncScript","d":"syncScript = pkgs.writeShellApplication {\n  name = \"graphide-checkout-sync\";\n  runtimeInputs = [\n    pkgs.git\n    pkgs.openssh\n    pkgs.util-linux\n    pkgs.libnotify\n    pkgs.coreutils\n  ];\n  text = ''\n    CHECKOUT=${lib.escapeShellArg cfg.checkout}\n    BRANCH=${lib.escapeShellArg cfg.branch}\n    REMOTE=${lib.escapeShellArg cfg.remote}\n    ALLOWLIST=(${lib.concatMapStringsSep \" \" lib.escapeShellArg cfg.allowlist})\n\n    note() { echo \"graphide-checkout-sync: $1\"; }\n\n    # Escalation channel. The script handles the case it was built for and\n… (truncated)","p":"modules/home-manager/term/graphide-sync.nix","r":976,"sp":[34,168,3,5],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":991,"i":"ea068da2-f907-424f-bcfd-163068d56229","k":"variable","n":"systemd.user.services.graphide-checkout-sync","d":"systemd.user.services.graphide-checkout-sync = {\n  Unit = {\n    Description = \"Fast-forward the shared graphide main checkout to origin/master\";\n    After = [ \"network-online.target\" ];\n    Wants = [ \"network-online.target\" ];\n  };\n  Service = {\n    Type = \"oneshot\";\n    ExecStart = lib.getExe syncScript;\n    # The same agent-held SSH key the shell uses; the repo is private and\n    # this machine has no GitHub token in nix.conf.\n    Environment = [ \"SSH_AUTH_SOCK=%t/ssh-agent\" ];\n    # Must never win a scheduling fight with the editor or a test run.\n    Nice = 10;\n… (truncated)","p":"modules/home-manager/term/graphide-sync.nix","r":981,"sp":[216,232,5,7],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":992,"i":"3f7b3b71-bff1-48d8-88f2-5c3cd0792dfb","k":"variable","n":"systemd.user.timers.graphide-checkout-sync","d":"systemd.user.timers.graphide-checkout-sync = {\n  Unit.Description = \"Check whether the graphide main checkout is behind origin/master\";\n  Timer = {\n    # Offset from graphide-autoupdate's 5m so the two do not contend for\n    # the network, the ssh agent, or the disk on every login.\n    OnStartupSec = \"8m\";\n    OnUnitActiveSec = cfg.interval;\n    RandomizedDelaySec = \"2m\";\n    Persistent = true;\n  };\n  Install.WantedBy = [ \"timers.target\" ];\n};","p":"modules/home-manager/term/graphide-sync.nix","r":981,"sp":[234,245,5,7],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":993,"i":"8753408e-51c3-48bd-b3ef-f1ea12621d2e","k":"variable","n":"text","d":"text = ''\n  CHECKOUT=${lib.escapeShellArg cfg.checkout}\n  BRANCH=${lib.escapeShellArg cfg.branch}\n  REMOTE=${lib.escapeShellArg cfg.remote}\n  ALLOWLIST=(${lib.concatMapStringsSep \" \" lib.escapeShellArg cfg.allowlist})\n\n  note() { echo \"graphide-checkout-sync: $1\"; }\n\n  # Escalation channel. The script handles the case it was built for and\n  # NOTHING else; every refusal below is a human's call, so it has to be\n  # visible rather than buried in `journalctl --user`.\n  escalate() {\n    note \"$1\"\n    notify-send -u normal \"Graphide checkout out of sync\" \"$1\" || true\n  }\n… (truncated)","p":"modules/home-manager/term/graphide-sync.nix","r":990,"sp":[43,167,5,8],"tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":994,"i":"d0b98ca1-e9d8-4621-a67c-8dae70eb326b","k":"file","n":"graphide.nix","d":"Home Manager module that wires the graphide tool into a user’s environment, exposing the release flake, configuring automatic updates, and syncing a local checkout with a curated allowlist of files and directories.","p":"modules/home-manager/term/graphide.nix","r":912,"tg":["description:agent","evidence:source","lang:nix","source:tree-sitter"]}
{"t":"n","a":995,"i":"17cb6806-9335-4b42-9642-231b9669fc93","k":"variable","n":"allowlist","d":"allowlist = [ \".graphide/authored\" \"gred/extensions/graphide/out\" ];","p":"modules/home-manager/term/graphide.nix","r":1000,"sp":[13,27,1,7],"sh":"bccbcd009eb7d5624956e4c4e5c719e2df358fd75cbe83cacf2404df39b58049","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
