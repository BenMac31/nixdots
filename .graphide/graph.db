{"t":"n","a":63,"i":"9548c8a4-fe09-4bba-b688-5ec9251590db","k":"variable","n":"_state","d":"_state = {\"text\": \"--:--\", \"class\": \"idle\"}","p":"confs/startpage/pomo-bridge.py","r":52,"sp":[9,9,1,44],"sh":"933789d2897a5fd2399bd50d9a988adb0c1c7e29ff9792cebc87f89c0051b56c","tg":["arch:auto-attached","description:declaration","lang:python","source:tree-sitter","visibility:private"]}
