{"t":"n","a":998,"i":"2e96caa7-b949-4c71-ab62-8d24f5ba4440","k":"variable","n":"flakeAttr","d":"flakeAttr = flakeAttr;","p":"modules/home-manager/term/graphide.nix","r":999,"sp":[6,6,5,27],"sh":"c56c561fa2d4b44cbb926e1661cd6ee6c05c91d6bedd91e52ed3aa522ccab74e","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":999,"i":"60a86cc6-61e2-4ff4-a25e-8edf830946a5","k":"variable","n":"graphide.autoUpdate","d":"graphide.autoUpdate = {\n  flakeAttr = flakeAttr;\n  homeManagerPackage = inputs.home-manager.packages.${pkgs.stdenv.hostPlatform.system}.home-manager;\n  sshAuthSock = \"%t/ssh-agent\";\n};","p":"modules/home-manager/term/graphide.nix","r":994,"sp":[5,8,3,5],"sh":"42b0a8d81c892afc8777f76ed79f8fe95e6abd25e9b27d09ce6a2a0f315f0591","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1000,"i":"7c2d6ff3-d575-4a12-83ec-2b1cedbd47a9","k":"variable","n":"graphide.checkoutSync","d":"graphide.checkoutSync = {\n  enable = lib.mkDefault config.graphide.enable;\n  checkout = \"${config.home.homeDirectory}/Projects/graphide/graphide\";\n  sshAuthSock = \"%t/ssh-agent\";\n  # These existing generated paths are the only local state sync may discard.\n  allowlist = [ \".graphide/authored\" \"gred/extensions/graphide/out\" ];\n};","p":"modules/home-manager/term/graphide.nix","r":994,"sp":[9,28,3,5],"sh":"1dfb46db8558028c254dfd0fa40ef98c62d1f2d51cf64d10f2766528b19dced7","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
