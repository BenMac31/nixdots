{"t":"n","a":1100,"i":"213670f4-7a28-4460-bd33-0796a4e4b072","k":"variable","n":"system.autoUpgrade","d":"system.autoUpgrade = {\n  enable = lib.mkDefault true;\n  flake = inputs.self.outPath;\n  flags = [\n    \"--update-input\"\n    \"nixpkgs\"\n    \"-L\" # print build logs\n  ];\n  dates = \"02:00\";\n  randomizedDelaySec = \"45min\";\n};","p":"modules/nixos/default.nix","r":1085,"sp":[75,85,5,7],"sh":"c5344d34381f12f349305f012db7f8c19650ebc1c4a87f38481a64a86762c8c9","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
