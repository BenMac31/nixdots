{"t":"n","a":1319,"i":"3d3dc073-7779-43d9-bf9d-bb3092abdd3a","k":"variable","n":"conf","d":"conf = {\n  default_server_config = {\n    \"m.homeserver\" = {\n      base_url = \"https://${cfg.hostName}\";\n      server_name = cfg.serverName;\n    };\n  };\n  brand = \"Graphide Chat\";\n  disable_custom_urls = true;\n  disable_guests = true;\n  show_labs_settings = true;\n  default_country_code = \"US\";\n};","p":"modules/nixos/serv/matrix/web.nix","r":1321,"sp":[17,29,5,7],"sh":"5d1f9f7b128c338ec1e6b47332574a5b9bf9bed923168a48cbff2eb0293b89d1","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1320,"i":"76957991-7fde-45fb-b84f-b1816fe6c1a5","k":"variable","n":"config","d":"config = lib.mkIf cfg.enable {\n  services.caddy = {\n    enable = true;\n    email = cfg.acmeEmail;\n\n    virtualHosts.${cfg.hostName}.extraConfig = ''\n      encode zstd gzip\n\n      header {\n        Strict-Transport-Security \"max-age=31536000; includeSubDomains\"\n        X-Content-Type-Options \"nosniff\"\n        Referrer-Policy \"same-origin\"\n      }\n\n      handle /_matrix/* {\n        request_body {\n          max_size 100MB\n        }\n        reverse_proxy 127.0.0.1:8008\n      }\n\n      handle /_synapse/client/* {\n        reverse_proxy 127.0.0.1:8008\n      }\n… (truncated)","p":"modules/nixos/serv/matrix/web.nix","r":1314,"sp":[33,82,3,5],"sh":"6b860385bce3619e300111a3a9d807df9979184d0606a2869c806215816304f2","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1321,"i":"55e53b1d-d0e9-4245-b582-25b0f30c4a7f","k":"variable","n":"elementWeb","d":"elementWeb = pkgs.element-web.override {\n  conf = {\n    default_server_config = {\n      \"m.homeserver\" = {\n        base_url = \"https://${cfg.hostName}\";\n        server_name = cfg.serverName;\n      };\n    };\n    brand = \"Graphide Chat\";\n    disable_custom_urls = true;\n    disable_guests = true;\n    show_labs_settings = true;\n    default_country_code = \"US\";\n  };\n};","p":"modules/nixos/serv/matrix/web.nix","r":1314,"sp":[16,30,3,5],"sh":"422167c75274484098019924924edae3aeda5b97d0c7c45fb4c75af21ca9a948","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
