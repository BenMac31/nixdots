{"t":"n","a":707,"i":"83f2c23d-ed72-47af-958c-8ad5a29e880c","k":"module","n":"Rofi Launcher Configuration","d":"Provides Home Manager settings to install and configure the Rofi application launcher. It defines custom Rasi theme files (including a long view and an emoji view), binds colors to the global color scheme, installs optional integrations like rofi‑rbw‑wayland and pinentry‑rofi, and creates a dmenu‑compatible wrapper script. The module activates these settings when programs.rofi.enable is true.","p":"modules/home-manager/desktop/env/wm/rofi","r":597,"tg":["evidence:source","lang:nix","layer:architecture","source:arch-agent"]}
{"t":"n","a":708,"i":"34db77f7-19e3-4913-a8e3-b2e259194225","k":"file","n":"config-emoji.nix","d":"Provides the Rofi configuration for an emoji picker, defining the UI layout and placeholder text and exposing it as a home.file entry for .config/rofi/config-emoji.rasi.","p":"modules/home-manager/desktop/env/wm/rofi/config-emoji.nix","r":707,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":709,"i":"b52f1303-ef76-4f09-92c6-99b175e8ffa9","k":"variable","n":"home.file.\".config/rofi/config-emoji.rasi\".text","d":"home.file.\".config/rofi/config-emoji.rasi\".text = ''\n  @import \"~/.config/rofi/config-long.rasi\"\n  entry {\n    width: 45%;\n    placeholder: \"🔎 Search Emoji's 👀\";\n  }\n'';","p":"modules/home-manager/desktop/env/wm/rofi/config-emoji.nix","r":708,"sp":[4,10,3,6],"sh":"eaaead10549c5a78c158fa737d2afd9b8e8f2ead78d25f05e1c4913b237d7a98","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":710,"i":"fd55e6ba-639b-4136-8f8b-aa143b8c6066","k":"file","n":"config-long.nix","d":"Provides the Home Manager fragment that installs a custom Rasi file for rofi, defining a longer layout with 50% window width, placeholder text, and list view settings.","p":"modules/home-manager/desktop/env/wm/rofi/config-long.nix","r":707,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":711,"i":"5368a5a3-bb2b-47c8-b769-1d8e79c71429","k":"variable","n":"home.file.\".config/rofi/config-long.rasi\".text","d":"home.file.\".config/rofi/config-long.rasi\".text = ''\n  @import \"~/.config/rofi/config.rasi\" \n  window {\n    width: 50%;\n  }\n  entry {\n    placeholder: \"🔎 Search       \";\n  }\n  listview {\n    columns: 1;\n    lines: 8;\n    scrollbar: true;\n  }\n'';","p":"modules/home-manager/desktop/env/wm/rofi/config-long.nix","r":710,"sp":[4,17,3,6],"sh":"87587c2fc1b7733a5d348374728c2ce3367d8e8e23db58c9b2c9dab3cad9cf49","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":712,"i":"39461e36-17a4-4095-bd4f-d19ffbf2df08","k":"file","n":"default.nix","d":"Provides Home Manager configuration for the rofi launcher, adding its package and a dmenu wrapper, integrating pinentry-rofi and optional rbw support, and exposing rofi program options such as modi, icons, theme, location and font.","p":"modules/home-manager/desktop/env/wm/rofi/default.nix","r":707,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":713,"i":"d338fb95-9078-4b5e-8d5c-e52b8edc09dc","k":"variable","n":"home.packages","d":"home.packages = lib.mkIf config.programs.rofi.enable [\n  (lib.mkIf config.programs.rbw.enable pkgs.rofi-rbw-wayland)\n  pkgs.pinentry-rofi\n  (pkgs.writeShellScriptBin \"dmenu\" ''\n    ${pkgs.rofi}/bin/rofi -dmenu $@\n  '')\n];","p":"modules/home-manager/desktop/env/wm/rofi/default.nix","r":712,"sp":[6,12,3,5],"sh":"1a312b73acc5bcdb8acfcb73cb443b6d5f87831d76e96aded94e984af5a38762","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":714,"i":"adde08fd-a9b6-46ce-9168-ef58fd8c42a8","k":"variable","n":"programs","d":"programs = {\n  rbw = {\n    settings = {\n      pinentry = pkgs.pinentry-rofi;\n      email = \"benjaminmcintyre06@protonmail.com\";\n    };\n  };\n  rofi = {\n    package = pkgs.rofi;\n    extraConfig = {\n      modi = \"drun,filebrowser,run\";\n      show-icons = true;\n      icon-theme = \"Papirus\";\n      location = 0;\n      font = \"JetBrainsMono Nerd Font Mono 12\";\n      drun-display-format = \"{icon} {name}\";\n      display-drun = \" Apps\";\n      display-run = \" Run\";\n      display-filebrowser = \" File\";\n    };\n    theme =\n      let\n… (truncated)","p":"modules/home-manager/desktop/env/wm/rofi/default.nix","r":712,"sp":[13,227,3,5],"sh":"8d1bff5b5f1110afa60c3f84098cf70465beb168624f9ced4727c5594979513a","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":715,"i":"0aae503f-fbb5-4f50-8930-7d49ef5a713e","k":"variable","n":"rbw","d":"rbw = {\n  settings = {\n    pinentry = pkgs.pinentry-rofi;\n    email = \"benjaminmcintyre06@protonmail.com\";\n  };\n};","p":"modules/home-manager/desktop/env/wm/rofi/default.nix","r":714,"sp":[14,19,5,7],"sh":"b45921902832696e522b1b409787014aad48c7094651842d87df897d3fbefa68","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":716,"i":"c2982653-ffaf-4488-84ed-0caa81fdfd31","k":"variable","n":"rofi","d":"rofi = {\n  package = pkgs.rofi;\n  extraConfig = {\n    modi = \"drun,filebrowser,run\";\n    show-icons = true;\n    icon-theme = \"Papirus\";\n    location = 0;\n    font = \"JetBrainsMono Nerd Font Mono 12\";\n    drun-display-format = \"{icon} {name}\";\n    display-drun = \" Apps\";\n    display-run = \" Run\";\n    display-filebrowser = \" File\";\n  };\n  theme =\n    let\n      inherit (config.lib.formats.rasi) mkLiteral;\n    in\n    {\n      \"*\" = with config.colorScheme.palette; {\n        bg = lib.mkForce (mkLiteral \"#${base00}\");\n        bg-alt = lib.mkForce (mkLiteral \"#${base09}\");\n… (truncated)","p":"modules/home-manager/desktop/env/wm/rofi/default.nix","r":714,"sp":[20,226,5,7],"sh":"6067b3698f9807eb9a8e66402cd88532d0cb5244a27b0f1d1ecd72605e635461","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":717,"i":"b91f1092-7799-4f1c-ae79-3eb95cc03c32","k":"module","n":"Waybar Status Bar Configuration","d":"Provides a Home Manager configuration for the Waybar status bar, installing the waybar-pomodoro package, enabling its systemd service for the graphical session, defining the bar layout (left, center, and right modules) with custom entries such as a Rofi launcher, backlight, network, temperature, battery, and pomodoro widgets, and supplying CSS styling that sets colours, spacing, and element appearance for the bar.","p":"modules/home-manager/desktop/env/wm/waybar","r":597,"tg":["evidence:source","lang:css","lang:nix","layer:architecture","source:arch-agent"]}
{"t":"n","a":718,"i":"390a02e1-46f9-4152-94c4-397839f8ec58","k":"file","n":"default.nix","d":"Provides a Home Manager module that installs the waybar-pomodoro package and configures Waybar with systemd activation and default panel settings such as top layer, 40‑pixel height, and output targeting.","p":"modules/home-manager/desktop/env/wm/waybar/default.nix","r":717,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":719,"i":"b80170ac-ffc6-4fb0-b952-def483ec04c4","k":"variable","n":"home.packages","d":"home.packages = [\n  pkgs.waybar-pomodoro\n];","p":"modules/home-manager/desktop/env/wm/waybar/default.nix","r":718,"sp":[3,5,3,5],"sh":"5c97e91213e3b5c575b313a9f8304183a011a339489d407c227a97d3d57e2ec0","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":720,"i":"4337e6d1-c2f2-4289-9e90-bd60c66c456f","k":"variable","n":"programs.waybar","d":"programs.waybar = {\n  systemd.enable = true;\n  systemd.targets = [ \"graphical-session.target\" ];\n\n  settings = [\n    {\n      layer = \"top\";\n      outputs = [ \"eDP-1\" ];\n      position = \"top\";\n      mod = \"dock\";\n      height = 40;\n      exclusive = true;\n      passthrough = false;\n      gtk-layer-shell = true;\n\n      modules-left = [\n        \"custom/left\"\n        \"custom/rofi\"\n        \"backlight\"\n        \"pulseaudio\"\n        \"battery\"\n        \"custom/right\"\n      ];\n      modules-center = [\n        \"custom/left\"\n        \"hyprland/workspaces\"\n        \"custom/right\"\n      ];\n… (truncated)","p":"modules/home-manager/desktop/env/wm/waybar/default.nix","r":718,"sp":[6,228,3,5],"sh":"23a77bd9146d8c2e9ae48b989b259c5790e710ce8ddfd8586a469796d3739d53","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":721,"i":"15fbd757-4789-4faa-96aa-8d7012509b47","k":"variable","n":"settings","d":"settings = [\n  {\n    layer = \"top\";\n    outputs = [ \"eDP-1\" ];\n    position = \"top\";\n    mod = \"dock\";\n    height = 40;\n    exclusive = true;\n    passthrough = false;\n    gtk-layer-shell = true;\n\n    modules-left = [\n      \"custom/left\"\n      \"custom/rofi\"\n      \"backlight\"\n      \"pulseaudio\"\n      \"battery\"\n      \"custom/right\"\n    ];\n    modules-center = [\n      \"custom/left\"\n      \"hyprland/workspaces\"\n      \"custom/right\"\n    ];\n    modules-right = [\n      \"custom/left\"\n      \"tray\"\n      \"mpris\"\n      \"custom/pomodoro\"\n      \"clock\"\n      \"custom/right\"\n    ];\n… (truncated)","p":"modules/home-manager/desktop/env/wm/waybar/default.nix","r":720,"sp":[10,207,5,7],"sh":"2e7f7cfb4540c4f28518dc6fe99baf4765903e828043aef02dedc4471b743b03","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
