{"t":"n","a":625,"i":"840373e5-8f90-4ab7-a58f-b5453b8c38cd","k":"variable","n":"shared","d":"shared = inputs.graphide-tools.packages.${pkgs.stdenv.hostPlatform.system};","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":612,"sp":[4,4,3,78],"sh":"87ca95e16f92c10b8efe036c7adaa5be5aac622a05f6d2d5f2a3e2562ac4b92a","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":626,"i":"9ee249c5-ea60-4896-bea2-d68fd3656420","k":"variable","n":"shell","d":"shell = pkgs.writeShellScriptBin \"graphide-shell\" ''\n  export PATH=${lib.makeBinPath runtime}:\"$PATH\"\n  export PYTHONPATH=${shared.hackerboard-api}/lib''${PYTHONPATH:+:\"$PYTHONPATH\"}\n  export GRAPHIDE_SHELL_SETTINGS=${lib.escapeShellArg \"${config.xdg.configHome}/quickshell/graphide/settings.json\"}\n  exec ${lib.getExe pkgs.quickshell} -c graphide \"$@\"\n'';","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":612,"sp":[11,16,3,6],"sh":"4968a8f7260c9a029bf87b02591ae82657366b487dc4935590b0c2aa52cfb63e","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":627,"i":"b71ea67d-a518-4d2f-87d3-ff7f0a0b65ac","k":"variable","n":"systemd.user.services.graphide-shell","d":"systemd.user.services.graphide-shell = {\n  Unit = {\n    Description = \"Graphide Quickshell desktop\";\n    After = [ \"graphical-session.target\" ];\n    PartOf = [ \"graphical-session.target\" ];\n  };\n  Service = {\n    ExecStart = \"${shell}/bin/graphide-shell\";\n    Restart = \"on-failure\";\n    RestartSec = 2;\n    # Some status helpers do not handle SIGTERM; keep shell reloads bounded.\n    TimeoutStopSec = 5;\n    LimitCORE = 0;\n  };\n  Install.WantedBy = [ \"graphical-session.target\" ];\n};","p":"modules/home-manager/desktop/env/wm/quickshell/default.nix","r":614,"sp":[50,65,5,7],"sh":"e131fabb40a54b5c984bb263f016f4d3af17ee549f5e1b3bd5f587b08c3183a1","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
