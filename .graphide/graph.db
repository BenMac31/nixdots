{"t":"n","a":919,"i":"3f42ddd4-75a2-42f3-aa60-fcddb3e5bed1","k":"variable","n":"enable","d":"enable = lib.mkDefault config.ai.enable;","p":"modules/home-manager/term/ai/accounts.nix","r":929,"sp":[35,35,5,45],"sh":"580fe843a649c15967e2cf85900ca968530f20711cfb782bd1209df226cbad9b","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":920,"i":"9caadacd-1f0e-4fc6-b9e6-a601a4e2275d","k":"variable","n":"home.packages","d":"home.packages = lib.mkIf cfg.enable [\n  pkgs.unstable.unfree.codex\n  (lib.hiPrio selectedAccountCommands)\n];","p":"modules/home-manager/term/ai/accounts.nix","r":915,"sp":[43,49,1,5],"sh":"a98c16833d5877a85a0062cb317867daa470ef584ed0521e08c59ce9cad34f46","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
