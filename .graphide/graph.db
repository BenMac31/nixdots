{"t":"n","a":1352,"i":"9fc04276-2396-464d-abba-a70c3f57b061","k":"file","n":"minecraft.nix","d":"NixOS service module that adds an enableable Minecraft server option and, when enabled, configures a dedicated system user and group, opens the default Minecraft port (25565) in the firewall, and sets up related service defaults.","p":"modules/nixos/serv/minecraft.nix","r":1213,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1353,"i":"eceeaec4-99ff-4ddf-9997-0d493721f31f","k":"variable","n":"config","d":"config = lib.mkIf config.serv.minecraft.enable\n{\n  users.users.sistermcserver = {\n    isNormalUser = true;\n    shell = pkgs.bash;\n    group = \"sistermcserver\";\n    description = \"Minecraft server user\";\n  };\n  users.groups.sistermcserver = { };\n\n  networking.firewall.allowedTCPPorts = [ 25565 ];\n  networking.firewall.allowedUDPPorts = [ 24454 ];\n\n  systemd.services.minecraft-server = {\n    description = \"Minecraft server in screen session\";\n    after = [ \"network.target\" ];\n    wantedBy = [ \"multi-user.target\" ];\n    path = with pkgs; [\n      jdk21\n      udev\n    ];\n… (truncated)","p":"modules/nixos/serv/minecraft.nix","r":1352,"sp":[4,35,3,7],"sh":"c278c38655327e388df43750432cd0c3481ab7ae842e3d4511a226ebc128ad5c","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1354,"i":"48a87360-2ef6-40bb-93e8-fdbaa2c5e424","k":"variable","n":"options.serv.minecraft.enable","d":"options.serv.minecraft.enable = lib.mkEnableOption \"Enable Minecraft server\";","p":"modules/nixos/serv/minecraft.nix","r":1352,"sp":[3,3,3,80],"sh":"6a0498dc56d78dee463853bbb879d2dafb64e59991e2f1830676aa472ee9ffac","tg":["arch:auto-attached","description:declaration","lang:nix","nix:option","source:tree-sitter","visibility:public"]}
{"t":"n","a":1355,"i":"99d84ca7-df31-433d-b1d1-77ed59d5d982","k":"variable","n":"systemd.services.minecraft-server","d":"systemd.services.minecraft-server = {\n  description = \"Minecraft server in screen session\";\n  after = [ \"network.target\" ];\n  wantedBy = [ \"multi-user.target\" ];\n  path = with pkgs; [\n    jdk21\n    udev\n  ];\n  environment = {\n    JAVA_HOME = \"${pkgs.jdk21.home}\";\n    LD_LIBRARY_PATH = lib.makeLibraryPath [ pkgs.udev ];\n  };\n  serviceConfig = {\n    User = \"sistermcserver\";\n    Group = \"sistermcserver\";\n    WorkingDirectory = \"/var/lib/mc/server\";\n    ExecStart = \"${pkgs.screen}/bin/screen -DmS minecraft ${pkgs.bash}/bin/bash /var/lib/mc/server/run.sh\";\n    Restart = \"always\";\n… (truncated)","p":"modules/nixos/serv/minecraft.nix","r":1353,"sp":[14,34,7,9],"sh":"640b51507c42deb02ceb4a6bfd1aa6bab761b59b0e9599d176e1602043f87ece","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1356,"i":"6aef7904-dbc3-4554-967c-79e2bba7e720","k":"variable","n":"users.groups.sistermcserver","d":"users.groups.sistermcserver = { };","p":"modules/nixos/serv/minecraft.nix","r":1353,"sp":[12,12,7,41],"sh":"e635a7226937f3e523619338f5d582bcf42ff87952815ff1de4cfc12b308dbbd","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1357,"i":"acf22f28-1d87-4242-9595-004cd7d7fa3a","k":"variable","n":"users.users.sistermcserver","d":"users.users.sistermcserver = {\n  isNormalUser = true;\n  shell = pkgs.bash;\n  group = \"sistermcserver\";\n  description = \"Minecraft server user\";\n};","p":"modules/nixos/serv/minecraft.nix","r":1353,"sp":[6,11,7,9],"sh":"add20e9dcf0a482de7ccb41e81320cb969d4efa7d02c39eb9b743f71788940b1","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1358,"i":"f96adbfe-137d-427b-8a04-9665c8cb6ea8","k":"file","n":"nextcloud-aio.nix","d":"NixOS module file defining the `serv.nextcloudAio` option tree and, when enabled, declaring the Nextcloud All-in-One mastercontainer as an OCI container, a Caddy virtual host terminating TLS for it, and the firewall ports it and Talk need. Imported by `modules/nixos/serv/default.nix`.","p":"modules/nixos/serv/nextcloud-aio.nix","r":1213,"tg":["lang:nix","plan:nextcloud-aio","source:tree-sitter"]}
{"t":"n","a":1359,"i":"efc53886-c2a6-4de0-a6f6-65967934c078","k":"variable","n":"acmeEmail","d":"acmeEmail = lib.mkOption {\n  type = lib.types.str;\n  description = \"Address ACME registers the certificate under.\";\n};","p":"modules/nixos/serv/nextcloud-aio.nix","r":1367,"sp":[19,22,5,7],"sh":"bc7fea98b13a3e9830f57486cbbe32d9e4dfab680eb21668aea03172756e8bdf","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1360,"i":"abd30a1c-9591-4da7-9b6a-c9433835b929","k":"variable","n":"adminPort","d":"adminPort = lib.mkOption {\n  type = lib.types.port;\n  default = 8080;\n  description = \"AIO's own admin interface, reachable on the LAN.\";\n};","p":"modules/nixos/serv/nextcloud-aio.nix","r":1367,"sp":[32,36,5,7],"sh":"790b2e04db0203e11152f4196317890c95ec26b3a390edc26bd12ec98a455d6a","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1361,"i":"479ccfe7-26b1-4128-bfb5-43bdd1bb3b88","k":"variable","n":"apachePort","d":"apachePort = lib.mkOption {\n  type = lib.types.port;\n  default = 11000;\n  description = ''\n    Loopback port AIO's apache container listens on; only Caddy reaches it.\n  '';\n};","p":"modules/nixos/serv/nextcloud-aio.nix","r":1367,"sp":[24,30,5,7],"sh":"add4849736783aa022d3eb37722fc53705766374b0cfb8d4cab8f7377e6381b5","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1362,"i":"6e28edda-bb9e-41a6-88a3-39dd443ff9b7","k":"variable","n":"cfg","d":"cfg = config.serv.nextcloudAio;","p":"modules/nixos/serv/nextcloud-aio.nix","r":1358,"sp":[4,4,3,34],"sh":"4c9a11d004b3c139e60897cb9953867da9166645f8a37a02b79f6c4b431599a2","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1363,"i":"0e6ee022-1fbe-44ff-bf07-2fa57b112fe4","k":"variable","n":"config","d":"The `lib.mkIf cfg.enable` block holding the OCI container declaration, the Caddy virtual host, and the firewall ports.","p":"modules/nixos/serv/nextcloud-aio.nix","r":1358,"sp":[51,101,3,5],"sh":"0048459781ee3137bd9feabf98d3310bfa41f9a9ecc1e28ad48093ff1c12396a","tg":["arch:auto-attached","description:declaration","lang:nix","plan:nextcloud-aio","source:tree-sitter","visibility:public"]}
{"t":"n","a":1364,"i":"2e5afb41-cb1e-4b10-ba43-1f6ea5e3bf45","k":"variable","n":"domain","d":"domain = lib.mkOption {\n  type = lib.types.str;\n  example = \"cloud.example.com\";\n  description = ''\n    Public FQDN. AIO persists this in its own configuration; changing it\n    makes AIO re-run domain validation.\n  '';\n};","p":"modules/nixos/serv/nextcloud-aio.nix","r":1367,"sp":[10,17,5,7],"sh":"975a5df1043f46229993c04d3c9d8e388d5309d3c3ca5a7fea9d5c140a20728f","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1365,"i":"e5d0a5aa-4ac5-46ac-9f8c-ac2dbf715189","k":"variable","n":"enable","d":"enable = lib.mkEnableOption \"the Nextcloud All-in-One mastercontainer\";","p":"modules/nixos/serv/nextcloud-aio.nix","r":1367,"sp":[8,8,5,76],"sh":"0be63ed4019fad21dc9112f7fa5150433cf160a1de2b9f490ceeb13a92fb53db","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1366,"i":"3d7ab690-2f6a-4304-82f9-04b3d2fea1fe","k":"variable","n":"networking.firewall","d":"Opens 443 for Caddy, cfg.adminPort for AIO's own admin interface on the LAN, and 3478 on both TCP and UDP for Talk's TURN server.\n\nThe UDP half is a fix, not a carry-over: the old host opened only TCP 3478, so Talk's media relay could not have worked over UDP from outside. cfg.apachePort is deliberately not opened — it is loopback-only now, reached solely through Caddy.","p":"modules/nixos/serv/nextcloud-aio.nix","r":1363,"lt":"[\"443\",\"3478\"]","sp":[97,100,5,7],"sh":"29ce71454c7835b4346569a62378acca4845f7f1b24a2b706d4c35c312adbda8","tg":["description:declaration","lang:nix","plan:nextcloud-aio","source:tree-sitter","visibility:public"]}
{"t":"n","a":1367,"i":"afe828e4-6bad-40d2-8991-44cad4eba204","k":"variable","n":"options.serv.nextcloudAio","d":"The module's option tree. `enable` is an mkEnableOption. `domain` (str) is the public FQDN AIO already has persisted in its own configuration; changing it makes AIO re-run domain validation. `acmeEmail` (str) is the ACME registration address. `apachePort` (port, default 11000) is the loopback port AIO's apache container listens on, read off the running instance. `adminPort` (port, default 8080) is AIO's own admin interface, left reachable on the LAN as it was before.\n\n`timeZone` is `nullOr str` defaulting to `config.time.timeZone`, and null omits TZ from the container rather than passing an empty value. The nullability is not defensive: this host enables `services.automatic-timezoned`, which forces `time.timeZone` to null, so a plain `str` type fails to evaluate here. omegaServ therefore sets it explicitly to the America/New_York that AIO already persisted.","p":"modules/nixos/serv/nextcloud-aio.nix","r":1358,"sp":[7,49,3,5],"sh":"c62d8888d34efaad1914fb6b0e0893ed42437f199156507494192b487f73bdfe","tg":["arch:auto-attached","description:declaration","lang:nix","nix:option","plan:nextcloud-aio","source:tree-sitter","visibility:public"]}
{"t":"n","a":1368,"i":"3cc894d7-4270-4859-b0e6-688b62606f55","k":"variable","n":"services.caddy","d":"Terminates TLS for cfg.domain and reverse-proxies it to 127.0.0.1:${cfg.apachePort}, where AIO's apache container listens. Enables Caddy with `email = lib.mkDefault cfg.acmeEmail`, matching how serv.continuwuity does it so the three modules that set this option on this host do not collide.\n\nForces TLS-ALPN-01 with `disable_http_challenge`, because port 80 is not forwarded to this host. Sets HSTS, which is what Nextcloud's own security scan looks for. Deliberately sets no request body limit: Caddy imposes none by default, and Nextcloud uploads are large.","p":"modules/nixos/serv/nextcloud-aio.nix","r":1363,"lt":"[\"disable_http_challenge\"]","sp":[74,95,5,7],"sh":"409eee86cb7414fb864ec8b454b52ab9794702448af18fe0e4ee9b70243769ba","tg":["description:declaration","lang:nix","plan:nextcloud-aio","source:tree-sitter","visibility:public"]}
{"t":"n","a":1369,"i":"8d662e4b-0034-4ac5-889e-beeb511044a7","k":"variable","n":"timeZone","d":"timeZone = lib.mkOption {\n  type = lib.types.nullOr lib.types.str;\n  default = config.time.timeZone;\n  defaultText = lib.literalExpression \"config.time.timeZone\";\n  description = ''\n    Timezone passed to the mastercontainer. Null omits TZ entirely, leaving\n    the timezone AIO has already persisted — which is what the default\n    resolves to on hosts running services.automatic-timezoned, since that\n    forces time.timeZone to null.\n  '';\n};","p":"modules/nixos/serv/nextcloud-aio.nix","r":1367,"sp":[38,48,5,7],"sh":"525b763125d59fed546419371520d44f867eee6b66fb66f128419afd45f7d637","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1370,"i":"78dd0f45-1f15-4651-9580-15664b781393","k":"variable","n":"virtualisation.oci-containers","d":"Declares the AIO mastercontainer, and sets `backend = \"docker\"` because the default backend is podman and the existing volumes belong to the host's Docker daemon at /home/docker.\n\nThe container attribute must be named `nextcloud-aio-mastercontainer` exactly: oci-containers derives the container name from the attribute, and AIO looks itself up by that name over the Docker socket. It mounts the existing named volume `nextcloud_aio_mastercontainer` at /mnt/docker-aio-config and the Docker socket, which is how AIO spawns and manages its sibling containers — the reason only this one container can be declared here.\n\nEnvironment carries the values read off the running instance: `APACHE_PORT` from cfg.apachePort, `TZ` from cfg.timeZone, and `APACHE_IP_BINDING = \"127.0.0.1\"`, which is the one deliberate change — the old container bound 0.0.0.0 for an off-host proxy, and Caddy now sits on the same machine. `--init` is passed so PID 1 in the container reaps zombies.\n\nRecreating this container is safe: AIO keeps all state in the volume, and the mastercontainer itself is disposable.","p":"modules/nixos/serv/nextcloud-aio.nix","r":1363,"lt":"[\"nextcloud-aio-mastercontainer\",\"nextcloud_aio_mastercontainer\",\"/mnt/docker-aio-config\",\"/var/run/docker.sock\",\"127.0.0.1\",\"docker\"]","sp":[52,72,5,7],"sh":"9de393fa2ce2dfbc65cd490bc727546471909fcc6a79942b12947c6939d6b4f0","tg":["description:declaration","lang:nix","plan:nextcloud-aio","source:tree-sitter","visibility:public"]}
{"t":"n","a":1371,"i":"0e10efe1-c470-4d80-91bc-197754069ba7","k":"file","n":"ntfy.nix","d":"NixOS module that installs and configures a self‑hosted ntfy push server, including automatic generation of authentication credentials, a systemd service to provision secrets, Caddy reverse‑proxy setup, firewall rules, and related options for hostname, topic, and user.","p":"modules/nixos/serv/ntfy.nix","r":1213,"tg":["description:agent","evidence:source","lang:nix","source:tree-sitter"]}
{"t":"n","a":1372,"i":"023bf37f-871f-44bb-9d7a-52d97970f5f2","k":"variable","n":"acmeEmail","d":"acmeEmail = lib.mkOption {\n  type = lib.types.str;\n  description = \"Contact address Let's Encrypt uses for expiry notices.\";\n};","p":"modules/nixos/serv/ntfy.nix","r":1383,"sp":[74,77,5,7],"sh":"90b4c53e716a4d36006870312e316581f86665e96d77c73556b5a78dae8d0538","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1373,"i":"40db3520-3a2e-4714-8483-4706d4e1296a","k":"variable","n":"cfg","d":"cfg = config.serv.ntfy;","p":"modules/nixos/serv/ntfy.nix","r":1371,"sp":[4,4,3,26],"sh":"4abab82d6fa1d00d54066a747900724ca8aa8fa2602196bc73c2210ac5a7f78c","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1374,"i":"bf3f0998-c7d8-43c4-97a8-2986e9e8d607","k":"variable","n":"config","d":"config = lib.mkIf cfg.enable {\n  serv.ntfy.internal.publishTokenFile = tokenFile;\n\n  environment.systemPackages = [ showCredentials ];\n\n  systemd.services.ntfy-secrets = {\n    description = \"Mint ntfy credentials and render its environment file\";\n    wantedBy = [ \"multi-user.target\" ];\n    before = [ \"ntfy-sh.service\" ]\n      ++ lib.optional config.serv.youHaveMail.enable \"you-have-mail-config.service\";\n    requiredBy = [ \"ntfy-sh.service\" ];\n    path = with pkgs; [ coreutils openssl ntfy-sh ];\n    serviceConfig = {\n      Type = \"oneshot\";\n      RemainAfterExit = true;\n… (truncated)","p":"modules/nixos/serv/ntfy.nix","r":1371,"sp":[113,175,3,5],"sh":"d53514b7f832d66aa970df0e6098159a786757b6f67b2841a96dac0b496314e5","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1375,"i":"0122fe05-26cf-4d3d-99ba-ee95fd467d02","k":"variable","n":"enable","d":"enable = lib.mkEnableOption \"a self-hosted ntfy push server behind Caddy\";","p":"modules/nixos/serv/ntfy.nix","r":1383,"sp":[62,62,5,79],"sh":"fb2cd0e88211aea332fa2498c49eb34a71b8765a949ec45559e0019e3eecd0d3","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1376,"i":"72419d9b-15f6-4b54-ac86-2281e4c66927","k":"variable","n":"envFile","d":"envFile = \"${secretsDir}/env\";","p":"modules/nixos/serv/ntfy.nix","r":1371,"sp":[7,7,3,33],"sh":"150ca3cb4bf31a6440d05659fade273afd6a4b6c795e835805d8d28fac41bf94","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1377,"i":"7cd3dfab-f512-49bd-845d-35b7ab318812","k":"variable","n":"environment.systemPackages","d":"environment.systemPackages = [ showCredentials ];","p":"modules/nixos/serv/ntfy.nix","r":1374,"sp":[119,119,5,54],"sh":"15325a54ca53cf075799970fabe9e6415df815b03fc897b80ad60c86f7325dfc","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":1378,"i":"20716d07-b436-441c-8fde-a5c07fc3129d","k":"variable","n":"hostname","d":"hostname = lib.mkOption {\n  type = lib.types.str;\n  example = \"ntfy.benmac.xyz\";\n  description = ''\n    Public FQDN for the server. Must already resolve to this machine's\n    public address, unproxied, before the first rebuild — Caddy requests a\n    certificate on start-up and fails if the name does not reach it.\n  '';\n};","p":"modules/nixos/serv/ntfy.nix","r":1383,"sp":[64,72,5,7],"sh":"8a8362f2921a838685810ce44308bc3ed2529e486d1330e58f21f5832c7377c4","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1379,"i":"e440c5bd-2e59-4a28-85f9-7d2601f28cb2","k":"variable","n":"internal.localPublishUrl","d":"internal.localPublishUrl = lib.mkOption {\n  type = lib.types.str;\n  internal = true;\n  description = ''\n    Topic URL for publishers running on this host. Deliberately loopback\n    rather than the public name: this machine routes the VPS's public\n    address down the WireGuard tunnel, and the VPS only DNATs traffic\n    arriving on its ethernet interface, so the public URL is refused from\n    here. Access control is unaffected — ntfy still requires the token.\n  '';\n};","p":"modules/nixos/serv/ntfy.nix","r":1383,"sp":[100,110,5,7],"sh":"20ba7bdd362650e0871ce57525de7d68f6d6ec556e81338e0eeae4d946301b79","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1380,"i":"fabe632a-6080-4145-a4a8-95180ac5d5aa","k":"variable","n":"internal.publishTokenFile","d":"internal.publishTokenFile = lib.mkOption {\n  type = lib.types.str;\n  internal = true;\n  description = \"Path to the generated publish token, for publishers on this host.\";\n};","p":"modules/nixos/serv/ntfy.nix","r":1383,"sp":[94,98,5,7],"sh":"09dfe8ba00cdeb6b2e56826b87fcbbee4efe7cad42ced09cbd569ef53101201c","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1381,"i":"72e6da66-170b-4054-8486-ee8036f605f3","k":"variable","n":"listenAddress","d":"listenAddress = \"127.0.0.1:2586\";","p":"modules/nixos/serv/ntfy.nix","r":1371,"sp":[11,11,3,36],"sh":"4081c6db3733135ef415d0fc3eccf739e7e63dabe017f99930b2acf2e0f2c01c","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1382,"i":"7b081eea-0ed4-4847-beb6-47703266139c","k":"variable","n":"networking.firewall.allowedTCPPorts","d":"networking.firewall.allowedTCPPorts = [ 443 ];","p":"modules/nixos/serv/ntfy.nix","r":1374,"sp":[174,174,5,51],"sh":"a41c61a3998d43b8254c284a80847bf19502ef1be68d2d23d51f10c14372ee98","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":1383,"i":"2429369d-4566-4775-8e20-9beb62a39402","k":"variable","n":"options.serv.ntfy","d":"options.serv.ntfy = {\n  enable = lib.mkEnableOption \"a self-hosted ntfy push server behind Caddy\";\n\n  hostname = lib.mkOption {\n    type = lib.types.str;\n    example = \"ntfy.benmac.xyz\";\n    description = ''\n      Public FQDN for the server. Must already resolve to this machine's\n      public address, unproxied, before the first rebuild — Caddy requests a\n      certificate on start-up and fails if the name does not reach it.\n    '';\n  };\n\n  acmeEmail = lib.mkOption {\n    type = lib.types.str;\n    description = \"Contact address Let's Encrypt uses for expiry notices.\";\n  };\n… (truncated)","p":"modules/nixos/serv/ntfy.nix","r":1371,"sp":[61,111,3,5],"sh":"685d551e0f1c896915da7544ea7b3ad8865297764d140bfceda88a94a874ce83","tg":["arch:auto-attached","description:declaration","lang:nix","nix:option","source:tree-sitter","visibility:public"]}
{"t":"n","a":1384,"i":"888e2012-0121-40b0-a0a5-fd9359dc2d43","k":"variable","n":"passwordFile","d":"passwordFile = \"${secretsDir}/${cfg.user}.password\";","p":"modules/nixos/serv/ntfy.nix","r":1371,"sp":[9,9,3,55],"sh":"e0fcafa0625a2a859966c09a82c925da37f69e27cb4ed3b86f16e338e545f3e3","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1385,"i":"cda02895-cffd-4ca6-ace7-82ccadb19435","k":"variable","n":"provisionSecrets","d":"provisionSecrets = pkgs.writeShellScript \"ntfy-provision-secrets\" ''\n  set -euo pipefail\n\n  install -d -m 0700 -o root -g root ${secretsDir}\n  umask 077\n\n  if [ ! -s ${passwordFile} ]; then\n    openssl rand -base64 24 | tr -d '\\n' > ${passwordFile}\n  fi\n\n  if [ ! -s ${tokenFile} ]; then\n    ntfy token generate | tail -1 | tr -d '[:space:]' > ${tokenFile}\n  fi\n\n  password=\"$(cat ${passwordFile})\"\n  token=\"$(cat ${tokenFile})\"\n  hash=\"$(printf '%s\\n%s\\n' \"$password\" \"$password\" | ntfy user hash | tail -1)\"\n\n  cat > ${envFile} <<EOF\n  NTFY_AUTH_USERS=${cfg.user}:$hash:user\n… (truncated)","p":"modules/nixos/serv/ntfy.nix","r":1371,"sp":[13,44,1,6],"sh":"7eb81845eda9b316abfcef1e71f21603de6463930708e7edb196c3a76b414cb6","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1386,"i":"59f94e6d-0bd7-407f-89d9-27d5c6b14811","k":"variable","n":"secretsDir","d":"secretsDir = \"/var/lib/ntfy-secrets\";","p":"modules/nixos/serv/ntfy.nix","r":1371,"sp":[6,6,3,40],"sh":"a87b39e2435a7d106e259be3562fd64128d431283b178673dabcc4e0d911d474","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1387,"i":"9884f53e-8352-4f71-b0b4-17b0c14dc8bd","k":"variable","n":"serv.ntfy.internal","d":"serv.ntfy.internal = {\n  publishTokenFile = tokenFile;\n  localPublishUrl = \"http://${listenAddress}/${cfg.topic}\";\n};","p":"modules/nixos/serv/ntfy.nix","r":1374,"sp":[114,117,5,7],"sh":"e345e299d7f343de16ebe6a5aa9bebe1578dcb07e795e45133b4df9c2ad81a0f","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1388,"i":"36cb759b-729e-4e57-b244-96cedfbead86","k":"variable","n":"services.caddy","d":"services.caddy = {\n  enable = true;\n  email = cfg.acmeEmail;\n\n  # Port 80 is not forwarded to this host, so the HTTP-01 challenge cannot\n  # succeed; TLS-ALPN-01 rides the 443 forward that already exists.\n  virtualHosts.${cfg.hostname}.extraConfig = ''\n    encode zstd gzip\n\n    tls {\n      issuer acme {\n        disable_http_challenge\n      }\n    }\n\n    header {\n      Strict-Transport-Security \"max-age=31536000; includeSubDomains\"\n      X-Content-Type-Options \"nosniff\"\n      Referrer-Policy \"same-origin\"\n    }\n\n    reverse_proxy ${listenAddress}\n  '';\n};","p":"modules/nixos/serv/ntfy.nix","r":1374,"sp":[149,172,5,7],"sh":"edf3bd2925483ab1f2d701a8969a536e8fd080ee8f91d73ff7b3a12e0aef814e","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1389,"i":"433db699-8af0-4dc5-b044-b398e341278f","k":"variable","n":"services.ntfy-sh","d":"services.ntfy-sh = {\n  enable = true;\n  environmentFile = envFile;\n  settings = {\n    base-url = \"https://${cfg.hostname}\";\n    listen-http = listenAddress;\n    # Rate limits must key off the real client, not Caddy's loopback address.\n    behind-proxy = true;\n    auth-default-access = \"deny-all\";\n  };\n};","p":"modules/nixos/serv/ntfy.nix","r":1374,"sp":[135,145,5,7],"sh":"b02f5cbb42adb66222d1dc465f9e5ee7f87ef3ebf9642e701bc1cc7c2752cda2","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1390,"i":"eaab7887-a2d1-45cd-851a-e288a4ed66df","k":"variable","n":"showCredentials","d":"showCredentials = pkgs.writeShellScriptBin \"ntfy-phone-credentials\" ''\n  set -euo pipefail\n\n  if [ \"$(id -u)\" -ne 0 ]; then\n    echo \"ntfy-phone-credentials must be run as root\" >&2\n    exit 1\n  fi\n\n  echo \"Server:   https://${cfg.hostname}\"\n  echo \"Topic:    ${cfg.topic}\"\n  echo \"Username: ${cfg.user}\"\n  echo \"Password: $(cat ${passwordFile})\"\n'';","p":"modules/nixos/serv/ntfy.nix","r":1371,"sp":[46,58,3,6],"sh":"85884b40e39c159f1d1079ee1232e6f5cd6593d51da7d94672334a06d8aeec21","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1391,"i":"acd26c80-43e1-4ecb-8da5-e6e12d9bf149","k":"variable","n":"systemd.services.ntfy-secrets","d":"systemd.services.ntfy-secrets = {\n  description = \"Mint ntfy credentials and render its environment file\";\n  wantedBy = [ \"multi-user.target\" ];\n  before = [ \"ntfy-sh.service\" ]\n    ++ lib.optional config.serv.youHaveMail.enable \"you-have-mail-config.service\";\n  requiredBy = [ \"ntfy-sh.service\" ];\n  path = with pkgs; [ coreutils openssl ntfy-sh ];\n  serviceConfig = {\n    Type = \"oneshot\";\n    RemainAfterExit = true;\n    ExecStart = provisionSecrets;\n  };\n};","p":"modules/nixos/serv/ntfy.nix","r":1374,"sp":[121,133,5,7],"sh":"f3493800e0c1f00624da7e4b6156a926c22bf160a084c7f41d160e8da9f3e856","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1392,"i":"9573f45b-bdce-429e-b613-22f7b367280d","k":"variable","n":"systemd.services.ntfy-sh.after","d":"systemd.services.ntfy-sh.after = [ \"ntfy-secrets.service\" ];","p":"modules/nixos/serv/ntfy.nix","r":1374,"sp":[147,147,5,65],"sh":"1fb364e4a5130eb4abff2991f1db294702d55d24267aff60d2d45053141a0f69","tg":["description:declaration","lang:nix","nix:leaf","source:tree-sitter","visibility:public"]}
{"t":"n","a":1393,"i":"a04e2461-6df8-4b01-be38-43f00e4cc05d","k":"variable","n":"tokenFile","d":"tokenFile = \"${secretsDir}/publish.token\";","p":"modules/nixos/serv/ntfy.nix","r":1371,"sp":[8,8,3,45],"sh":"9a2808375a98062c54976c02346c81e0cabc86ecae8d6b187191eeafeca7dd56","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
