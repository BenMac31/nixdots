{"t":"n","a":1074,"i":"2825f360-9c27-46cf-b12a-c0a0996a2b98","k":"variable","n":"programs.librewolf.profiles.default.userChrome","d":"programs.librewolf.profiles.default.userChrome = lib.mkAfter ''\n  :root {\n    --lwt-accent-color: #${p.base00} !important;\n    --lwt-text-color: #${p.base05} !important;\n    --toolbar-bgcolor: #${p.base01} !important;\n    --toolbar-color: #${p.base05} !important;\n    --toolbar-field-background-color: #070d12 !important;\n    --toolbar-field-color: #${p.base05} !important;\n    --sidebar-background-color: #${p.base00} !important;\n    --sidebar-text-color: #${p.base05} !important;\n    --tab-selected-bgcolor: #${p.base02} !important;\n… (truncated)","p":"modules/home-manager/themes/verdigris-ink.nix","r":1066,"sp":[117,131,7,10],"sh":"71ee8d5500562251fe30f3f36fc763750c5896284ae42c09673fe30e3546bde9","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1075,"i":"cd8074ca-5271-4296-b5a5-ebb4274d52f3","k":"variable","n":"qt","d":"qt = {\n  platformTheme.name = \"qtct\";\n  style.name = \"Fusion\";\n  qt5ctSettings = {\n    Appearance = { color_scheme_path = \"${config.xdg.configHome}/qt5ct/colors/verdigris.conf\"; custom_palette = true; icon_theme = \"Papirus-Dark\"; style = \"Fusion\"; };\n    # QSettings treats unquoted commas as a list, not a font description.\n    Fonts = { fixed = ''\"JetBrains Mono,10,-1,5,50,0,0,0,0,0\"''; general = ''\"Inter,10,-1,5,50,0,0,0,0,0\"''; };\n    # Preserve the existing Qt interaction preferences; only appearance changes.\n    Interface = {\n… (truncated)","p":"modules/home-manager/themes/verdigris-ink.nix","r":1066,"sp":[67,85,7,9],"sh":"fb6f2b25ad09754fa072ad104da0daef9e8442469d8bedac80ebd371d4fe0740","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1076,"i":"ca4c2a5d-26ac-48c6-908d-73e92222d5c1","k":"variable","n":"qtColors","d":"qtColors = lib.concatStringsSep \", \" [\n  \"#bcc6cd\" \"#0f1a22\" \"#18242c\" \"#18242c\" \"#070d12\" \"#75838b\"\n  \"#bcc6cd\" \"#ffffff\" \"#bcc6cd\" \"#070d12\" \"#0a1218\" \"#070d12\"\n  \"#4fa396\" \"#04120f\" \"#6dbcb0\" \"#79b0a8\" \"#0f1a22\" \"#000000\"\n  \"#0d1720\" \"#bcc6cd\" \"#75838b\" \"#4fa396\"\n];","p":"modules/home-manager/themes/verdigris-ink.nix","r":1063,"sp":[34,40,1,5],"sh":"092d1d8fcc9c9af20db6378193cd6fe9652ed65854a2c633451bddd24905e015","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1077,"i":"b84081a0-bce3-409e-989c-89dc705bb3c6","k":"variable","n":"xdg.configFile.\"qt5ct/colors/verdigris.conf\".text","d":"xdg.configFile.\"qt5ct/colors/verdigris.conf\".text = ''\n  [ColorScheme]\n  active_colors=${qtColors}\n  inactive_colors=${qtColors}\n  disabled_colors=${qtColors}\n'';","p":"modules/home-manager/themes/verdigris-ink.nix","r":1066,"sp":[86,91,7,10],"sh":"c6f63a85e990c708f4ba2454169a25d1c1ed2ecf6cc871692bb5a07259009b9d","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
