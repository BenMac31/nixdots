{"t":"n","a":1056,"i":"7910e5cd-c8ad-45bc-876b-60b6294d61c1","k":"variable","n":"history","d":"history = {\n  extended = true;\n  ignoreAllDups = true;\n  ignoreSpace = true;\n  path = \"$HOME/.local/share/zsh/history\";\n};","p":"modules/home-manager/term/zsh.nix","r":1060,"sp":[12,17,5,7],"sh":"38ee12574c412058fcd1d24e568f317e4b0dcacbe16ece49bd08999d4fe75112","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1057,"i":"8b51eb01-568a-4692-bdb3-3b5bce0b60b6","k":"variable","n":"home.file.\".zsh_plugins.txt\".text","d":"home.file.\".zsh_plugins.txt\".text = ''\n  jeffreytse/zsh-vi-mode\n  zsh-users/zsh-autosuggestions\n  zdharma-continuum/fast-syntax-highlighting kind:defer\n  romkatv/powerlevel10k\n'';","p":"modules/home-manager/term/zsh.nix","r":1052,"sp":[184,189,3,6],"sh":"bc57eb034e0393e16e4336acb807d8ea6efb35afdbdb44997691eead2cc21d7f","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
