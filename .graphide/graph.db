{"t":"n","a":1066,"i":"a2856139-e1fe-4b30-a995-7315e57e38ab","k":"variable","n":"config","d":"config = lib.mkMerge [\n  { desktop.verdigris.enable = lib.mkDefault config.desktop.enable; }\n  (lib.mkIf cfg.enable {\n    # Canonical neutrals/accent from Graphide's pre_design_system.md;\n    # syntax hues from the bundled Verdigris Ink editor theme.\n    colorScheme = {\n      slug = \"verdigris-ink\";\n      name = \"Verdigris Ink\";\n      author = \"Graphide\";\n      palette = {\n        base00 = \"0a1218\"; base01 = \"0f1a22\"; base02 = \"18242c\"; base03 = \"52616b\";\n        base04 = \"75838b\"; base05 = \"bcc6cd\"; base06 = \"dae1e6\"; base07 = \"ffffff\";\n… (truncated)","p":"modules/home-manager/themes/verdigris-ink.nix","r":1063,"sp":[43,133,3,5],"sh":"e6d23cc1260ed3a80105423fea41873ebc77937c2b2d496f16cb73387a94712e","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
