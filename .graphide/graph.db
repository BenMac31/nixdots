{"t":"n","a":1118,"i":"968be079-6344-44cc-8161-4b0a337c8c76","k":"file","n":"plymouth.nix","d":"Provides the NixOS configuration fragment that activates initrd systemd when the plymouth boot splash is enabled, exposing the 'boot' attribute for inclusion in the system's boot settings.","p":"modules/nixos/head/plymouth.nix","r":1104,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1119,"i":"8791c7a8-32ef-4871-a875-66e7174e045e","k":"variable","n":"boot","d":"boot = lib.mkIf config.boot.plymouth.enable {\n  initrd.systemd.enable = true;\n};","p":"modules/nixos/head/plymouth.nix","r":1118,"sp":[3,5,3,5],"sh":"9479bd744833e734f939442b54b15f6e12e5a18ff310aeed89ab5442d6d8a42f","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
