{"t":"n","a":1036,"i":"068870a6-ddfa-436e-9ba4-bfd823589cd2","k":"variable","n":"tui","d":"tui = {\n  enable = lib.mkEnableOption \"Enable tui apps\";\n};","p":"modules/home-manager/term/tui/default.nix","r":1033,"sp":[8,10,5,7],"sh":"6aaf350289655776504199c949ba0b2898ef337117d12439e944ec1b819ae615","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1037,"i":"6f397e9d-23b8-46da-a31e-7efef09bf7b4","k":"file","n":"newsboat.nix","d":"Home Manager module that configures the Newsboat terminal RSS reader with a default configuration (auto-reload, external URL viewer, key bindings) and enables the rbw password manager integration, exposing the programs.newsboat attribute for further customization.","p":"modules/home-manager/term/tui/newsboat.nix","r":1028,"tg":["lang:nix","source:tree-sitter"]}
{"t":"n","a":1038,"i":"19dcd26f-bceb-41ce-bae1-cf9d44392765","k":"variable","n":"extraConfig","d":"extraConfig = /*conf*/ ''\n  auto-reload yes\n\n  external-url-viewer \"xdg-open\"\n\n  bind-key j down\n  bind-key k up\n  bind-key j next articlelist\n  bind-key k prev articlelist\n  bind-key J next-feed articlelist\n  bind-key K prev-feed articlelist\n  bind-key G end\n  bind-key g home\n  bind-key d pagedown\n  bind-key u pageup\n  bind-key l open\n  bind-key h quit\n  bind-key a toggle-article-read\n  bind-key n next-unread\n  bind-key N prev-unread\n  bind-key D pb-download\n  bind-key U show-urls\n  bind-key x pb-delete\n\n  color listnormal cyan default\n… (truncated)","p":"modules/home-manager/term/tui/newsboat.nix","r":1039,"sp":[5,58,5,8],"sh":"9e7be7a430f8c0c6927aeff2828bd31a7ca29d417f9b8aa1a4d72a609e7eb698","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1039,"i":"cd6b723e-f94c-4e79-aa09-a48bf70553d8","k":"variable","n":"programs.newsboat","d":"programs.newsboat = {\n  extraConfig = /*conf*/ ''\n    auto-reload yes\n\n    external-url-viewer \"xdg-open\"\n\n    bind-key j down\n    bind-key k up\n    bind-key j next articlelist\n    bind-key k prev articlelist\n    bind-key J next-feed articlelist\n    bind-key K prev-feed articlelist\n    bind-key G end\n    bind-key g home\n    bind-key d pagedown\n    bind-key u pageup\n    bind-key l open\n    bind-key h quit\n    bind-key a toggle-article-read\n    bind-key n next-unread\n    bind-key N prev-unread\n    bind-key D pb-download\n    bind-key U show-urls\n    bind-key x pb-delete\n… (truncated)","p":"modules/home-manager/term/tui/newsboat.nix","r":1037,"sp":[4,59,3,5],"sh":"7ce3cce85223a49cdd563e42e29b9a8b1d5e2db365a8be8d49cfe74b29f33c91","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
