{"t":"n","a":1069,"i":"cf31ce23-3603-4429-a793-9a6ba3b0071b","k":"variable","n":"gtk","d":"gtk = {\n  theme = { package = pkgs.adw-gtk3; name = \"adw-gtk3-dark\"; };\n  iconTheme = { package = pkgs.papirus-icon-theme; name = \"Papirus-Dark\"; };\n  font = { name = \"Inter\"; size = 10; package = pkgs.inter; };\n  gtk3.extraCss = gtkCss;\n  gtk4.extraCss = gtkCss;\n  gtk3.extraConfig.gtk-application-prefer-dark-theme = true;\n};","p":"modules/home-manager/themes/verdigris-ink.nix","r":1066,"sp":[59,66,7,9],"sh":"06414b8d71ca854f28f8c6f62e6717c219c0bf0a87c65b3577893529aa505fb3","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1070,"i":"8e1db2a0-d39b-43bb-b317-d1434eb56940","k":"variable","n":"gtkCss","d":"gtkCss = ''\n  @define-color window_bg_color #${p.base00};\n  @define-color window_fg_color #${p.base05};\n  @define-color view_bg_color #070d12;\n  @define-color view_fg_color #${p.base05};\n  @define-color headerbar_bg_color #${p.base01};\n  @define-color headerbar_fg_color #${p.base05};\n  @define-color sidebar_bg_color #${p.base01};\n  @define-color sidebar_fg_color #${p.base05};\n  @define-color card_bg_color #${p.base01};\n  @define-color card_fg_color #${p.base05};\n  @define-color popover_bg_color #0d1720;\n  @define-color popover_fg_color #${p.base05};\n… (truncated)","p":"modules/home-manager/themes/verdigris-ink.nix","r":1063,"sp":[5,33,3,6],"sh":"221319a7a131314a095b5a76cf5d67cd7059e20259b089463ff04bd156c464a4","tg":["arch:auto-attached","description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
{"t":"n","a":1071,"i":"f1600437-7572-4e80-aca2-488cdcf93f5f","k":"variable","n":"i18n.inputMethod.fcitx5","d":"i18n.inputMethod.fcitx5 = lib.mkIf (config.desktop.japanese.enable && config.desktop.japanese.input.enable) {\n  settings.addons.classicui.globalSection.Theme = \"verdigris-ink\";\n  themes.verdigris-ink.theme = {\n    Metadata = { Name = \"Verdigris Ink\"; Author = \"Graphide\"; Version = \"1\"; };\n    InputPanel = {\n      Font = \"Inter 12\"; NormalColor = \"#${p.base05}\";\n      HighlightCandidateColor = \"#04120f\"; HighlightColor = \"#${p.base0C}\";\n      HighlightBackgroundColor = \"#${p.base02}\"; Spacing = 4;\n    };\n… (truncated)","p":"modules/home-manager/themes/verdigris-ink.nix","r":1066,"sp":[98,116,7,9],"sh":"73875b898b592eefba88dba1a88ce32f55c4ab0c1d242193f6f1eac847516b28","tg":["description:declaration","lang:nix","source:tree-sitter","visibility:public"]}
