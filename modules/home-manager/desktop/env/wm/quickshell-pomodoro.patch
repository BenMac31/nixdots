+import QtQuick
+import Quickshell
+import Quickshell.Wayland
+
+PanelWindow {
+    visible: Desktop.pomodoroEnabled
+    anchors { right: true; bottom: true }
+    margins { right: PlateState.layout.gutter; bottom: PlateState.layout.gutter }
+    exclusionMode: ExclusionMode.Ignore
+    WlrLayershell.layer: WlrLayer.Overlay
+    WlrLayershell.namespace: "graphide-pomodoro"
+    WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
+    implicitWidth: Math.max(152, timerButton.implicitWidth)
+    implicitHeight: 34
+    color: Theme.raised
+
+    Action {
+        id: timerButton
+        anchors.fill: parent
+        text: Desktop.pomodoro
+        size: 13
+        active: PomodoroState.state.running
+        tip: "Pomodoro. Click to manage, right-click to start or pause."
+        onClicked: Desktop.toggleLauncher("pomodoro")
+        onRightClicked: PomodoroState.send({action: "toggle"})
+    }
+}
